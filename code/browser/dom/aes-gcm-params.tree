
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find algorithm
  find buffer-source

form aes-gcm-params, name <AesGcmParams>
  base algorithm

  link additional-data, name <additionalData>
    like buffer-source
    flex true
  link iv, name <iv>
    like buffer-source
    flex true
  link tag-length, name <tagLength>
    like native-number
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find rtc-stats

form rtc-rtp-stream-stats, name <RTCRtpStreamStats>
  base rtc-stats

  link codec-id, name <codecId>
    like native-string
    flex true
  link kind, name <kind>
    like native-string
    flex true
  link ssrc, name <ssrc>
    like native-number
    flex true
  link transport-id, name <transportId>
    like native-string
    flex true

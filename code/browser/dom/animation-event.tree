
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find event

form animation-event, name <AnimationEvent>
  base event

  link animation-name, name <animationName>
    like native-string
  link elapsed-time, name <elapsedTime>
    like native-number
  link pseudo-element, name <pseudoElement>
    like native-string


load @cluesurf/bind/code/javascript/native
  find native-void

load @cluesurf/bind/code/browser/dom
  find element
  find resize-observer-options

form resize-observer, name <ResizeObserver>
  task disconnect, name <disconnect>
    like native-void

  task observe, name <observe>
    like native-void

    take target
    take options, like maybe, like resize-observer-options

  task unobserve, name <unobserve>
    like native-void

    take target


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find character-data
  find html-slot-element
  find slottable

form text, name <Text>
  base character-data
  base slottable

  link assigned-slot, name <assignedSlot>
    like or
      like html-slot-element
      like native-null
  link whole-text, name <wholeText>
    like native-string

  task split-text, name <splitText>
    like text

    take offset

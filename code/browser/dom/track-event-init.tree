
load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find event-init
  find text-track

form track-event-init, name <TrackEventInit>
  base event-init

  link track, name <track>
    like or
      like text-track
      like native-null
    flex true

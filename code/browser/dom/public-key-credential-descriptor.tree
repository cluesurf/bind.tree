
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/browser/dom
  find authenticator-transport
  find buffer-source
  find public-key-credential-type

form public-key-credential-descriptor, name <PublicKeyCredentialDescriptor>
  link id, name <id>
    like buffer-source
    flex true
  link transports, name <transports>
    like array
      like authenticator-transport
    flex true
  link type, name <type>
    like public-key-credential-type
    flex true

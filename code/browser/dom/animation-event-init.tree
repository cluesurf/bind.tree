
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find event-init

form animation-event-init, name <AnimationEventInit>
  base event-init

  link animation-name, name <animationName>
    like native-string
    flex true
  link elapsed-time, name <elapsedTime>
    like native-number
    flex true
  link pseudo-element, name <pseudoElement>
    like native-string
    flex true

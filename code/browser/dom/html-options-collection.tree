
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-void

load @cluesurf/bind/code/browser/dom
  find html-collection-of
  find html-element
  find html-opt-group-element
  find html-option-element

form html-options-collection, name <HTMLOptionsCollection>
  base html-collection-of

  link length, name <length>
    like native-number
    flex true
  link selected-index, name <selectedIndex>
    like native-number
    flex true

  task add, name <add>
    like native-void

    take element
    take before
      like maybe
        like or
          like html-element
          like native-number
          like native-null

  task remove, name <remove>
    like native-void

    take index

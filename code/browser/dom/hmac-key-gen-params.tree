
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find algorithm
  find hash-algorithm-identifier

form hmac-key-gen-params, name <HmacKeyGenParams>
  base algorithm

  link hash, name <hash>
    like hash-algorithm-identifier
    flex true
  link length, name <length>
    like native-number
    flex true

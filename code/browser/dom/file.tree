
load @cluesurf/bind/code/browser/dom/blob
  find blob

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form file, name <File>
  base blob

  link last-modified, name <lastModified>
    like native-number
  link name, name <name>
    like native-string
  link webkit-relative-path, name <webkitRelativePath>
    like native-string

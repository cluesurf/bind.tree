
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find dom-time-stamp

load @cluesurf/bind/code/javascript/es5
  find record

form push-subscription-json, name <PushSubscriptionJSON>
  link endpoint, name <endpoint>
    like native-string
    flex true
  link expiration-time, name <expirationTime>
    like or
      like dom-time-stamp
      like native-null
    flex true
  link keys, name <keys>
    like record
      like native-string
      like native-string
    flex true

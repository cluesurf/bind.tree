
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find g-lenum
  find g-lint

form web-gl-active-info, name <WebGLActiveInfo>
  link name, name <name>
    like native-string
  link size, name <size>
    like g-lint
  link type, name <type>
    like g-lenum

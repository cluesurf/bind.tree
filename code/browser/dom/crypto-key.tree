
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom
  find key-algorithm
  find key-type
  find key-usage

form crypto-key, name <CryptoKey>
  link algorithm, name <algorithm>
    like key-algorithm
  link extractable, name <extractable>
    like native-boolean
  link type, name <type>
    like key-type
  link usages, name <usages>
    like array
      like key-usage

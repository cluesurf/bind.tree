
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find dom-high-res-time-stamp

form audio-timestamp, name <AudioTimestamp>
  link context-time, name <contextTime>
    like native-number
    flex true
  link performance-time, name <performanceTime>
    like dom-high-res-time-stamp
    flex true

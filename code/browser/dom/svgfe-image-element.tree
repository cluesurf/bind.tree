
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-animated-preserve-aspect-ratio
  find svg-element
  find svg-element-event-map
  find svg-filter-primitive-standard-attributes
  find svguri-reference

form svgfe-image-element, name <SVGFEImageElement>
  base svg-element
  base svg-filter-primitive-standard-attributes
  base svguri-reference

  link preserve-aspect-ratio, name <preserveAspectRatio>
    like svg-animated-preserve-aspect-ratio

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

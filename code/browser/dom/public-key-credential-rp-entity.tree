
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find public-key-credential-entity

form public-key-credential-rp-entity, name <PublicKeyCredentialRpEntity>
  base public-key-credential-entity

  link id, name <id>
    like native-string
    flex true

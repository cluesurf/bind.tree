
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find event-init

form idb-version-change-event-init, name <IDBVersionChangeEventInit>
  base event-init

  link new-version, name <newVersion>
    like or
      like native-number
      like native-null
    flex true
  link old-version, name <oldVersion>
    like native-number
    flex true


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find dom-high-res-time-stamp
  find dom-rect-init
  find element

form intersection-observer-entry-init, name <IntersectionObserverEntryInit>
  link bounding-client-rect, name <boundingClientRect>
    like dom-rect-init
    flex true
  link intersection-ratio, name <intersectionRatio>
    like native-number
    flex true
  link intersection-rect, name <intersectionRect>
    like dom-rect-init
    flex true
  link is-intersecting, name <isIntersecting>
    like native-boolean
    flex true
  link root-bounds, name <rootBounds>
    like or
      like dom-rect-init
      like native-null
    flex true
  link target, name <target>
    like element
    flex true
  link time, name <time>
    like dom-high-res-time-stamp
    flex true

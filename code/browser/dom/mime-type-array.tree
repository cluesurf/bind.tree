
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

form mime-type-array, name <MimeTypeArray>
  link length, name <length>
    like native-number

  task item, name <item>
    like any

    take index

  task named-item, name <namedItem>
    like any

    take name

  mesh index
    like any


load @cluesurf/bind/code/browser/dom/headers
  find headers

load @cluesurf/bind/code/javascript/es5/record
  find record

load @cluesurf/bind/code/javascript/native
  find native-array

load @cluesurf/bind/code/javascript/native
  find native-string

form headers-init, name <HeadersInit>
  like or
    like native-array
      like native-array
        like native-string
    like record
      like native-string
      like native-string
    like headers
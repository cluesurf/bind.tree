
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find dom-matrix
  find dom-matrix2-d-init
  find dom-point
  find dom-point-read-only
  find dom-rect
  find dom-rect-read-only
  find element
  find event-listener-options
  find event-listener-or-event-listener-object
  find node-list-of
  find svg-angle
  find svg-animated-length
  find svg-circle-element
  find svg-element
  find svg-ellipse-element
  find svg-fit-to-view-box
  find svg-graphics-element
  find svg-image-element
  find svg-length
  find svg-line-element
  find svg-number
  find svg-path-element
  find svg-polygon-element
  find svg-polyline-element
  find svg-rect-element
  find svg-text-element
  find svg-transform
  find svg-use-element
  find svgsvg-element-event-map
  find window-event-handlers

form svgsvg-element, name <SVGSVGElement>
  base svg-graphics-element
  base svg-fit-to-view-box
  base window-event-handlers

  link current-scale, name <currentScale>
    like native-number
    flex true
  link current-translate, name <currentTranslate>
    like dom-point-read-only
  link height, name <height>
    like svg-animated-length
  link width, name <width>
    like svg-animated-length
  link x, name <x>
    like svg-animated-length
  link y, name <y>
    like svg-animated-length

  task animations-paused, name <animationsPaused>
    like native-boolean

  task check-enclosure, name <checkEnclosure>
    like native-boolean

    take element
    take rect

  task check-intersection, name <checkIntersection>
    like native-boolean

    take element
    take rect

  task create-svg-angle, name <createSVGAngle>
    like svg-angle

  task create-svg-length, name <createSVGLength>
    like svg-length

  task create-svg-matrix, name <createSVGMatrix>
    like dom-matrix

  task create-svg-number, name <createSVGNumber>
    like svg-number

  task create-svg-point, name <createSVGPoint>
    like dom-point

  task create-svg-rect, name <createSVGRect>
    like dom-rect

  task create-svg-transform, name <createSVGTransform>
    like svg-transform

  task create-svg-transform-from-matrix, name <createSVGTransformFromMatrix>
    like svg-transform

    take matrix, like maybe, like dom-matrix2-d-init

  task deselect-all, name <deselectAll>
    like native-void

  task force-redraw, name <forceRedraw>
    like native-void

  task get-current-time, name <getCurrentTime>
    like native-number

  task get-element-by-id, name <getElementById>
    like element

    take element-id

  task get-enclosure-list, name <getEnclosureList>
    like node-list-of
      like or
        like svg-circle-element
        like svg-ellipse-element
        like svg-image-element
        like svg-line-element
        like svg-path-element
        like svg-polygon-element
        like svg-polyline-element
        like svg-rect-element
        like svg-text-element
        like svg-use-element

    take rect
    take reference-element

  task get-intersection-list, name <getIntersectionList>
    like node-list-of
      like or
        like svg-circle-element
        like svg-ellipse-element
        like svg-image-element
        like svg-line-element
        like svg-path-element
        like svg-polygon-element
        like svg-polyline-element
        like svg-rect-element
        like svg-text-element
        like svg-use-element

    take rect
    take reference-element

  task pause-animations, name <pauseAnimations>
    like native-void

  task set-current-time, name <setCurrentTime>
    like native-void

    take seconds

  task suspend-redraw, name <suspendRedraw>
    like native-number

    take max-wait-milliseconds

  task unpause-animations, name <unpauseAnimations>
    like native-void

  task unsuspend-redraw, name <unsuspendRedraw>
    like native-void

    take suspend-handle-id

  task unsuspend-redraw-all, name <unsuspendRedrawAll>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svgsvg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svgsvg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

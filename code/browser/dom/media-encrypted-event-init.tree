
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find event-init

load @cluesurf/bind/code/javascript/es5
  find array-buffer

form media-encrypted-event-init, name <MediaEncryptedEventInit>
  base event-init

  link init-data, name <initData>
    like or
      like array-buffer
      like native-null
    flex true
  link init-data-type, name <initDataType>
    like native-string
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find event-init

form transition-event-init, name <TransitionEventInit>
  base event-init

  link elapsed-time, name <elapsedTime>
    like native-number
    flex true
  link property-name, name <propertyName>
    like native-string
    flex true
  link pseudo-element, name <pseudoElement>
    like native-string
    flex true

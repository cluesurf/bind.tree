
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find element
  find html-collection

form html-all-collection, name <HTMLAllCollection>
  link length, name <length>
    like native-number

  task item, name <item>
    like or
      like html-collection
      like element
      like native-null

    take name-or-index, like maybe, like native-string

  task named-item, name <namedItem>
    like or
      like html-collection
      like element
      like native-null

    take name

  mesh index
    like element

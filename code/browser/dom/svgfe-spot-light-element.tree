
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-animated-number
  find svg-element
  find svg-element-event-map

form svgfe-spot-light-element, name <SVGFESpotLightElement>
  base svg-element

  link limiting-cone-angle, name <limitingConeAngle>
    like svg-animated-number
  link points-at-x, name <pointsAtX>
    like svg-animated-number
  link points-at-y, name <pointsAtY>
    like svg-animated-number
  link points-at-z, name <pointsAtZ>
    like svg-animated-number
  link specular-exponent, name <specularExponent>
    like svg-animated-number
  link x, name <x>
    like svg-animated-number
  link y, name <y>
    like svg-animated-number
  link z, name <z>
    like svg-animated-number

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

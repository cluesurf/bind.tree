
load @cluesurf/bind/code/browser/dom/event-target
  find event-target

load @cluesurf/bind/code/browser/dom/ui-event
  find ui-event

load @cluesurf/bind/code/javascript/native
  find native-null

form focus-event, name <FocusEvent>
  base ui-event

  link related-target, name <relatedTarget>
    like or
      like event-target
      like native-null


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find audio-buffer
  find event

form audio-processing-event, name <AudioProcessingEvent>
  base event

  link input-buffer, name <inputBuffer>
    like audio-buffer
  link output-buffer, name <outputBuffer>
    like audio-buffer
  link playback-time, name <playbackTime>
    like native-number

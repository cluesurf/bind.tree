
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null

load @cluesurf/bind/code/browser/dom
  find audio-buffer
  find audio-node-options

form convolver-options, name <ConvolverOptions>
  base audio-node-options

  link buffer, name <buffer>
    like or
      like audio-buffer
      like native-null
    flex true
  link disable-normalization, name <disableNormalization>
    like native-boolean
    flex true


load @cluesurf/bind/code/browser/dom
  find event
  find message-event

form rtc-data-channel-event-map, name <RTCDataChannelEventMap>
  link bufferedamountlow, name <bufferedamountlow>
    like event
    flex true
  link close, name <close>
    like event
    flex true
  link error, name <error>
    like event
    flex true
  link message, name <message>
    like message-event
    flex true
  link open, name <open>
    like event
    flex true

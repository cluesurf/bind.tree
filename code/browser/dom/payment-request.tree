
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find payment-details-update
  find payment-request-event-map
  find payment-response

load @cluesurf/bind/code/javascript/es5
  find promise
  find promise-like

form payment-request, name <PaymentRequest>
  base event-target

  link id, name <id>
    like native-string
  link onpaymentmethodchange, name <onpaymentmethodchange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task abort, name <abort>
    like promise
      like native-void

  task can-make-payment, name <canMakePayment>
    like promise
      like native-boolean

  task show, name <show>
    like promise
      like payment-response

    take details-promise
      like maybe
        like or
          like payment-details-update
          like promise-like
            like payment-details-update

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like payment-request-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like payment-request-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find event-target
  find ui-event-init

form focus-event-init, name <FocusEventInit>
  base ui-event-init

  link related-target, name <relatedTarget>
    like or
      like event-target
      like native-null
    flex true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find animation
  find get-animations-options
  find keyframe
  find keyframe-animation-options
  find property-indexed-keyframes

form animatable, name <Animatable>
  task animate, name <animate>
    like animation

    take keyframes
    take options
      like maybe
        like or
          like native-number
          like keyframe-animation-options

  task get-animations, name <getAnimations>
    like array
      like animation

    take options, like maybe, like get-animations-options

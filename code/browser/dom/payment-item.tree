
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string

load @cluesurf/bind/code/browser/dom
  find payment-currency-amount

form payment-item, name <PaymentItem>
  link amount, name <amount>
    like payment-currency-amount
    flex true
  link label, name <label>
    like native-string
    flex true
  link pending, name <pending>
    like native-boolean
    flex true

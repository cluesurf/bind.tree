
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find audio-buffer

form audio-buffer-source-options, name <AudioBufferSourceOptions>
  link buffer, name <buffer>
    like or
      like audio-buffer
      like native-null
    flex true
  link detune, name <detune>
    like native-number
    flex true
  link loop, name <loop>
    like native-boolean
    flex true
  link loop-end, name <loopEnd>
    like native-number
    flex true
  link loop-start, name <loopStart>
    like native-number
    flex true
  link playback-rate, name <playbackRate>
    like native-number
    flex true

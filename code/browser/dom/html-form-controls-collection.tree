
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find element
  find html-collection-base
  find radio-node-list

form html-form-controls-collection, name <HTMLFormControlsCollection>
  base html-collection-base

  task named-item, name <namedItem>
    like or
      like radio-node-list
      like element
      like native-null

    take name

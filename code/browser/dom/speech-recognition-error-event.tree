
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find event
  find speech-recognition-error-code

form speech-recognition-error-event, name <SpeechRecognitionErrorEvent>
  base event

  link error, name <error>
    like speech-recognition-error-code
  link message, name <message>
    like native-string

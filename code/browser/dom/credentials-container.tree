
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-void

load @cluesurf/bind/code/browser/dom
  find credential
  find credential-creation-options
  find credential-request-options

load @cluesurf/bind/code/javascript/es5
  find promise

form credentials-container, name <CredentialsContainer>
  task create, name <create>
    like promise
      like or
        like credential
        like native-null

    take options, like maybe, like credential-creation-options

  task get, name <get>
    like promise
      like or
        like credential
        like native-null

    take options, like maybe, like credential-request-options

  task prevent-silent-access, name <preventSilentAccess>
    like promise
      like native-void

  task store, name <store>
    like promise
      like credential

    take credential

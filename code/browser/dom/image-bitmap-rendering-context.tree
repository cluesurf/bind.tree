
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-void

load @cluesurf/bind/code/browser/dom
  find html-canvas-element
  find image-bitmap
  find offscreen-canvas

form image-bitmap-rendering-context, name <ImageBitmapRenderingContext>
  link canvas, name <canvas>
    like or
      like html-canvas-element
      like offscreen-canvas

  task transfer-from-image-bitmap, name <transferFromImageBitmap>
    like native-void

    take bitmap

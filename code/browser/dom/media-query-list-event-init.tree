
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string

load @cluesurf/bind/code/browser/dom
  find event-init

form media-query-list-event-init, name <MediaQueryListEventInit>
  base event-init

  link matches, name <matches>
    like native-boolean
    flex true
  link media, name <media>
    like native-string
    flex true

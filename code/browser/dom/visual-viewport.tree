
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find visual-viewport-event-map

form visual-viewport, name <VisualViewport>
  base event-target

  link height, name <height>
    like native-number
  link offset-left, name <offsetLeft>
    like native-number
  link offset-top, name <offsetTop>
    like native-number
  link onresize, name <onresize>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onscroll, name <onscroll>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link page-left, name <pageLeft>
    like native-number
  link page-top, name <pageTop>
    like native-number
  link scale, name <scale>
    like native-number
  link width, name <width>
    like native-number

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like visual-viewport-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like visual-viewport-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

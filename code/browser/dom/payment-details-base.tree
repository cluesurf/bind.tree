
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/browser/dom
  find payment-details-modifier
  find payment-item

form payment-details-base, name <PaymentDetailsBase>
  link display-items, name <displayItems>
    like array
      like payment-item
    flex true
  link modifiers, name <modifiers>
    like array
      like payment-details-modifier
    flex true


load @cluesurf/bind/code/browser/dom/payment-details-modifier
  find payment-details-modifier

load @cluesurf/bind/code/browser/dom/payment-item
  find payment-item

load @cluesurf/bind/code/javascript/native
  find native-array

form payment-details-base, name <PaymentDetailsBase>
  link display-items, name <displayItems>
    like native-array
      like payment-item
    lock false
  link modifiers, name <modifiers>
    like native-array
      like payment-details-modifier
    lock false

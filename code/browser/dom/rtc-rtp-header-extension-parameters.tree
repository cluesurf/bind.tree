
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string

form rtc-rtp-header-extension-parameters, name <RTCRtpHeaderExtensionParameters>
  link encrypted, name <encrypted>
    like native-boolean
    flex true
  link id, name <id>
    like native-number
    flex true
  link uri, name <uri>
    like native-string
    flex true

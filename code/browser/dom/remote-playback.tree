
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find remote-playback-availability-callback
  find remote-playback-event-map
  find remote-playback-state

load @cluesurf/bind/code/javascript/es5
  find promise

form remote-playback, name <RemotePlayback>
  base event-target

  link onconnect, name <onconnect>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onconnecting, name <onconnecting>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link ondisconnect, name <ondisconnect>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link state, name <state>
    like remote-playback-state

  task cancel-watch-availability, name <cancelWatchAvailability>
    like promise
      like native-void

    take id, like maybe, like native-number

  task prompt, name <prompt>
    like promise
      like native-void

  task watch-availability, name <watchAvailability>
    like promise
      like native-number

    take callback

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like remote-playback-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like remote-playback-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

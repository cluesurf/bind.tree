
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find rtc-sdp-type

form rtc-session-description-init, name <RTCSessionDescriptionInit>
  link sdp, name <sdp>
    like native-string
    flex true
  link type, name <type>
    like rtc-sdp-type
    flex true

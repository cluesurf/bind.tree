
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-angle
  find svg-animated-angle
  find svg-animated-enumeration
  find svg-animated-length
  find svg-element
  find svg-element-event-map
  find svg-fit-to-view-box

form svg-marker-element, name <SVGMarkerElement>
  base svg-element
  base svg-fit-to-view-box

  link marker-height, name <markerHeight>
    like svg-animated-length
  link marker-units, name <markerUnits>
    like svg-animated-enumeration
  link marker-width, name <markerWidth>
    like svg-animated-length
  link orient-angle, name <orientAngle>
    like svg-animated-angle
  link orient-type, name <orientType>
    like svg-animated-enumeration
  link ref-x, name <refX>
    like svg-animated-length
  link ref-y, name <refY>
    like svg-animated-length
  link svg-markerunits-strokewidth, name <SVG_MARKERUNITS_STROKEWIDTH>
    like native-number
  link svg-markerunits-unknown, name <SVG_MARKERUNITS_UNKNOWN>
    like native-number
  link svg-markerunits-userspaceonuse, name <SVG_MARKERUNITS_USERSPACEONUSE>
    like native-number
  link svg-marker-orient-angle, name <SVG_MARKER_ORIENT_ANGLE>
    like native-number
  link svg-marker-orient-auto, name <SVG_MARKER_ORIENT_AUTO>
    like native-number
  link svg-marker-orient-unknown, name <SVG_MARKER_ORIENT_UNKNOWN>
    like native-number

  task set-orient-to-angle, name <setOrientToAngle>
    like native-void

    take angle

  task set-orient-to-auto, name <setOrientToAuto>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

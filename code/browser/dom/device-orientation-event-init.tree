
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find event-init

form device-orientation-event-init, name <DeviceOrientationEventInit>
  base event-init

  link absolute, name <absolute>
    like native-boolean
    flex true
  link alpha, name <alpha>
    like or
      like native-number
      like native-null
    flex true
  link beta, name <beta>
    like or
      like native-number
      like native-null
    flex true
  link gamma, name <gamma>
    like or
      like native-number
      like native-null
    flex true


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find permission-state
  find permission-status-event-map

form permission-status, name <PermissionStatus>
  base event-target

  link onchange, name <onchange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link state, name <state>
    like permission-state

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like permission-status-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like permission-status-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

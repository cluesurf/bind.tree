
load @cluesurf/bind/code/javascript/native
  find native-undefined

load @cluesurf/bind/code/browser/dom
  find underlying-sink-abort-callback
  find underlying-sink-close-callback
  find underlying-sink-start-callback
  find underlying-sink-write-callback

form underlying-sink, name <UnderlyingSink>
  head w
    fall any

  link abort, name <abort>
    like underlying-sink-abort-callback
    flex true
  link close, name <close>
    like underlying-sink-close-callback
    flex true
  link start, name <start>
    like underlying-sink-start-callback
    flex true
  link type, name <type>
    like native-undefined
    flex true
  link write, name <write>
    like underlying-sink-write-callback
      like w
    flex true

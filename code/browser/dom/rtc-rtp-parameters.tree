
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/browser/dom
  find rtc-rtcp-parameters
  find rtc-rtp-codec-parameters
  find rtc-rtp-header-extension-parameters

form rtc-rtp-parameters, name <RTCRtpParameters>
  link codecs, name <codecs>
    like array
      like rtc-rtp-codec-parameters
    flex true
  link header-extensions, name <headerExtensions>
    like array
      like rtc-rtp-header-extension-parameters
    flex true
  link rtcp, name <rtcp>
    like rtc-rtcp-parameters
    flex true

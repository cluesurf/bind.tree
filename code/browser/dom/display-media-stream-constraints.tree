
load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom
  find media-track-constraints

form display-media-stream-constraints, name <DisplayMediaStreamConstraints>
  link audio, name <audio>
    like or
      like native-boolean
      like media-track-constraints
    flex true
  link video, name <video>
    like or
      like native-boolean
      like media-track-constraints
    flex true

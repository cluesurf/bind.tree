
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find event-init
  find window

form ui-event-init, name <UIEventInit>
  base event-init

  link detail, name <detail>
    like native-number
    flex true
  link view, name <view>
    like or
      like window
      like native-null
    flex true
  link which, name <which>
    like native-number
    flex true

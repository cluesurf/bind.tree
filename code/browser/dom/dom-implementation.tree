
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find document
  find document-type
  find xml-document

form dom-implementation, name <DOMImplementation>
  task create-document, name <createDocument>
    like xml-document

    take namespace
    take qualified-name
    take doctype
      like maybe
        like or
          like document-type
          like native-null

  task create-document-type, name <createDocumentType>
    like document-type

    take qualified-name
    take public-id
    take system-id

  task create-html-document, name <createHTMLDocument>
    like document

    take title, like maybe, like native-string

  task has-feature, name <hasFeature>
    text <true>

    take args
      like array
        like any
      rest true

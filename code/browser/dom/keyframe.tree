
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string
  find native-undefined

load @cluesurf/bind/code/browser/dom
  find composite-operation-or-auto

form keyframe, name <Keyframe>
  link composite, name <composite>
    like composite-operation-or-auto
    flex true
  link easing, name <easing>
    like native-string
    flex true
  link offset, name <offset>
    like or
      like native-number
      like native-null
    flex true

  mesh property
    like or
      like native-string
      like native-number
      like native-null
      like native-undefined


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find element
  find html-collection-base

form html-collection-of, name <HTMLCollectionOf>
  base html-collection-base

  head t
    base element

  task item, name <item>
    like or
      like t
      like native-null

    take index

  task named-item, name <namedItem>
    like or
      like t
      like native-null

    take name

  mesh index
    like t

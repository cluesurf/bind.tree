
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-element
  find svg-element-event-map
  find svg-tests

form svg-animation-element, name <SVGAnimationElement>
  base svg-element
  base svg-tests

  link target-element, name <targetElement>
    like or
      like svg-element
      like native-null

  task begin-element, name <beginElement>
    like native-void

  task begin-element-at, name <beginElementAt>
    like native-void

    take offset

  task end-element, name <endElement>
    like native-void

  task end-element-at, name <endElementAt>
    like native-void

    take offset

  task get-current-time, name <getCurrentTime>
    like native-number

  task get-simple-duration, name <getSimpleDuration>
    like native-number

  task get-start-time, name <getStartTime>
    like native-number

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

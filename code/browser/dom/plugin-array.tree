
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string
  find native-void

form plugin-array, name <PluginArray>
  link length, name <length>
    like native-number

  task item, name <item>
    like any

    take index

  task named-item, name <namedItem>
    like any

    take name

  task refresh, name <refresh>
    like native-void

  mesh index
    like any


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-animated-enumeration
  find svg-animated-length
  find svg-animated-transform-list
  find svg-element
  find svg-element-event-map
  find svg-fit-to-view-box
  find svguri-reference

form svg-pattern-element, name <SVGPatternElement>
  base svg-element
  base svg-fit-to-view-box
  base svguri-reference

  link height, name <height>
    like svg-animated-length
  link pattern-content-units, name <patternContentUnits>
    like svg-animated-enumeration
  link pattern-transform, name <patternTransform>
    like svg-animated-transform-list
  link pattern-units, name <patternUnits>
    like svg-animated-enumeration
  link width, name <width>
    like svg-animated-length
  link x, name <x>
    like svg-animated-length
  link y, name <y>
    like svg-animated-length

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

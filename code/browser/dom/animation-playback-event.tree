
load @cluesurf/bind/code/browser/dom/event
  find event

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/native
  find native-number

form animation-playback-event, name <AnimationPlaybackEvent>
  base event

  link current-time, name <currentTime>
    like or
      like native-number
      like native-null
  link timeline-time, name <timelineTime>
    like or
      like native-number
      like native-null


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find document
  find element
  find node

form attr, name <Attr>
  base node

  link local-name, name <localName>
    like native-string
  link name, name <name>
    like native-string
  link namespace-uri, name <namespaceURI>
    like or
      like native-string
      like native-null
  link owner-document, name <ownerDocument>
    like document
  link owner-element, name <ownerElement>
    like or
      like element
      like native-null
  link prefix, name <prefix>
    like or
      like native-string
      like native-null
  link specified, name <specified>
    like native-boolean
  link value, name <value>
    like native-string
    flex true


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find scroll-restoration
  find url

form history, name <History>
  link length, name <length>
    like native-number
  link scroll-restoration, name <scrollRestoration>
    like scroll-restoration
    flex true
  link state, name <state>
    like any

  task back, name <back>
    like native-void

  task forward, name <forward>
    like native-void

  task go, name <go>
    like native-void

    take delta, like maybe, like native-number

  task push-state, name <pushState>
    like native-void

    take data
    take unused
    take url
      like maybe
        like or
          like native-string
          like url
          like native-null

  task replace-state, name <replaceState>
    like native-void

    take data
    take unused
    take url
      like maybe
        like or
          like native-string
          like url
          like native-null


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/browser/dom
  find rtc-rtp-codec-capability
  find rtc-rtp-header-extension-capability

form rtc-rtp-capabilities, name <RTCRtpCapabilities>
  link codecs, name <codecs>
    like array
      like rtc-rtp-codec-capability
    flex true
  link header-extensions, name <headerExtensions>
    like array
      like rtc-rtp-header-extension-capability
    flex true

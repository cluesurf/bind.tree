
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find child-node
  find document
  find node
  find non-document-type-child-node

form character-data, name <CharacterData>
  base node
  base child-node
  base non-document-type-child-node

  link data, name <data>
    like native-string
    flex true
  link length, name <length>
    like native-number
  link owner-document, name <ownerDocument>
    like document

  task append-data, name <appendData>
    like native-void

    take data

  task delete-data, name <deleteData>
    like native-void

    take offset
    take count

  task insert-data, name <insertData>
    like native-void

    take offset
    take data

  task replace-data, name <replaceData>
    like native-void

    take offset
    take count
    take data

  task substring-data, name <substringData>
    like native-string

    take offset
    take count

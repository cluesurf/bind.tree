
load @cluesurf/bind/code/browser/dom
  find event-init
  find media-key-message-type

load @cluesurf/bind/code/javascript/es5
  find array-buffer

form media-key-message-event-init, name <MediaKeyMessageEventInit>
  base event-init

  link message, name <message>
    like array-buffer
    flex true
  link message-type, name <messageType>
    like media-key-message-type
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-void

load @cluesurf/bind/code/browser/dom
  find node
  find node-list

form node-list-of, name <NodeListOf>
  base node-list

  head t-node
    base node

  task item, name <item>
    like t-node

    take index

  task for-each, name <forEach>
    like native-void

    take callbackfn
    take this-arg, like maybe, like any

  mesh index
    like t-node

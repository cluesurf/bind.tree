
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find animation-effect
  find composite-operation
  find computed-keyframe
  find element
  find iteration-composite-operation
  find keyframe
  find property-indexed-keyframes

form keyframe-effect, name <KeyframeEffect>
  base animation-effect

  link composite, name <composite>
    like composite-operation
    flex true
  link iteration-composite, name <iterationComposite>
    like iteration-composite-operation
    flex true
  link pseudo-element, name <pseudoElement>
    like or
      like native-string
      like native-null
    flex true
  link target, name <target>
    like or
      like element
      like native-null
    flex true

  task get-keyframes, name <getKeyframes>
    like array
      like computed-keyframe

  task set-keyframes, name <setKeyframes>
    like native-void

    take keyframes


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find orientation-lock-type
  find orientation-type
  find screen-orientation-event-map

load @cluesurf/bind/code/javascript/es5
  find promise

form screen-orientation, name <ScreenOrientation>
  base event-target

  link angle, name <angle>
    like native-number
  link onchange, name <onchange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link type, name <type>
    like orientation-type

  task lock, name <lock>
    like promise
      like native-void

    take orientation

  task unlock, name <unlock>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like screen-orientation-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like screen-orientation-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

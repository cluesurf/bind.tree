
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number

load @cluesurf/bind/code/browser/dom
  find aes-cbc-params
  find aes-ctr-params
  find aes-derived-key-params
  find aes-gcm-params
  find aes-key-algorithm
  find aes-key-gen-params
  find algorithm-identifier
  find buffer-source
  find crypto-key
  find crypto-key-pair
  find ec-key-gen-params
  find ec-key-import-params
  find ecdh-key-derive-params
  find ecdsa-params
  find hkdf-params
  find hmac-import-params
  find hmac-key-gen-params
  find json-web-key
  find key-format
  find key-usage
  find pbkdf2-params
  find rsa-hashed-import-params
  find rsa-hashed-key-gen-params
  find rsa-oaep-params
  find rsa-pss-params

load @cluesurf/bind/code/javascript/es5
  find array-buffer
  find exclude
  find promise

form subtle-crypto, name <SubtleCrypto>
  task decrypt, name <decrypt>
    like promise
      like any

    take algorithm
    take key
    take data

  task derive-bits, name <deriveBits>
    like promise
      like array-buffer

    take algorithm
    take base-key
    take length

  task derive-key, name <deriveKey>
    like promise
      like crypto-key

    take algorithm
    take base-key
    take derived-key-type
    take extractable
    take key-usages

  task digest, name <digest>
    like promise
      like array-buffer

    take algorithm
    take data

  task encrypt, name <encrypt>
    like promise
      like any

    take algorithm
    take key
    take data

  task export-key, name <exportKey>
    like promise
      like json-web-key

    take format
    take key

  task export-key, name <exportKey>
    like promise
      like array-buffer

    take format
    take key

  task generate-key, name <generateKey>
    like promise
      like crypto-key-pair

    take algorithm
    take extractable
    take key-usages

  task generate-key, name <generateKey>
    like promise
      like crypto-key

    take algorithm
    take extractable
    take key-usages

  task generate-key, name <generateKey>
    like promise
      like or
        like crypto-key-pair
        like crypto-key

    take algorithm
    take extractable
    take key-usages

  task import-key, name <importKey>
    like promise
      like crypto-key

    take format
    take key-data
    take algorithm
    take extractable
    take key-usages

  task import-key, name <importKey>
    like promise
      like crypto-key

    take format
    take key-data
    take algorithm
    take extractable
    take key-usages

  task sign, name <sign>
    like promise
      like array-buffer

    take algorithm
    take key
    take data

  task unwrap-key, name <unwrapKey>
    like promise
      like crypto-key

    take format
    take wrapped-key
    take unwrapping-key
    take unwrap-algorithm
    take unwrapped-key-algorithm
    take extractable
    take key-usages

  task verify, name <verify>
    like promise
      like native-boolean

    take algorithm
    take key
    take signature
    take data

  task wrap-key, name <wrapKey>
    like promise
      like array-buffer

    take format
    take key
    take wrapping-key
    take wrap-algorithm

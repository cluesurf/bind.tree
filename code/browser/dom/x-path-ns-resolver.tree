
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

form x-path-ns-resolver, name <XPathNSResolver>
  like or
    like task
      like or
        like native-string
        like native-null

      take prefix
    like form
      task lookup-namespace-uri, name <lookupNamespaceURI>
        like or
          like native-string
          like native-null

        take prefix


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find node

form static-range-init, name <StaticRangeInit>
  link end-container, name <endContainer>
    like node
    flex true
  link end-offset, name <endOffset>
    like native-number
    flex true
  link start-container, name <startContainer>
    like node
    flex true
  link start-offset, name <startOffset>
    like native-number
    flex true

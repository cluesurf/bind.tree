
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find child-node
  find document
  find node

form document-type, name <DocumentType>
  base node
  base child-node

  link name, name <name>
    like native-string
  link owner-document, name <ownerDocument>
    like document
  link public-id, name <publicId>
    like native-string
  link system-id, name <systemId>
    like native-string

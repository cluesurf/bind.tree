
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find audio-buffer
  find base-audio-context
  find event-listener-options
  find event-listener-or-event-listener-object
  find offline-audio-completion-event
  find offline-audio-context-event-map

load @cluesurf/bind/code/javascript/es5
  find promise

form offline-audio-context, name <OfflineAudioContext>
  base base-audio-context

  link length, name <length>
    like native-number
  link oncomplete, name <oncomplete>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task resume, name <resume>
    like promise
      like native-void

  task start-rendering, name <startRendering>
    like promise
      like audio-buffer

  task suspend, name <suspend>
    like promise
      like native-void

    take suspend-time

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like offline-audio-context-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like offline-audio-context-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

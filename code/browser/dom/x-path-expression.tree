
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find node
  find x-path-result

form x-path-expression, name <XPathExpression>
  task evaluate, name <evaluate>
    like x-path-result

    take context-node
    take type, like maybe, like native-number
    take result
      like maybe
        like or
          like x-path-result
          like native-null


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find color-gamut
  find hdr-metadata-type
  find transfer-function

form video-configuration, name <VideoConfiguration>
  link bitrate, name <bitrate>
    like native-number
    flex true
  link color-gamut, name <colorGamut>
    like color-gamut
    flex true
  link content-type, name <contentType>
    like native-string
    flex true
  link framerate, name <framerate>
    like native-number
    flex true
  link hdr-metadata-type, name <hdrMetadataType>
    like hdr-metadata-type
    flex true
  link height, name <height>
    like native-number
    flex true
  link scalability-mode, name <scalabilityMode>
    like native-string
    flex true
  link transfer-function, name <transferFunction>
    like transfer-function
    flex true
  link width, name <width>
    like native-number
    flex true

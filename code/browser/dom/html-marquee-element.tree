
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find html-element
  find html-element-event-map

form html-marquee-element, name <HTMLMarqueeElement>
  base html-element

  link behavior, name <behavior>
    like native-string
    flex true
  link bg-color, name <bgColor>
    like native-string
    flex true
  link direction, name <direction>
    like native-string
    flex true
  link height, name <height>
    like native-string
    flex true
  link hspace, name <hspace>
    like native-number
    flex true
  link loop, name <loop>
    like native-number
    flex true
  link scroll-amount, name <scrollAmount>
    like native-number
    flex true
  link scroll-delay, name <scrollDelay>
    like native-number
    flex true
  link true-speed, name <trueSpeed>
    like native-boolean
    flex true
  link vspace, name <vspace>
    like native-number
    flex true
  link width, name <width>
    like native-string
    flex true

  task start, name <start>
    like native-void

  task stop, name <stop>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like html-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like html-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find data-transfer-item
  find file

form data-transfer-item-list, name <DataTransferItemList>
  link length, name <length>
    like native-number

  task add, name <add>
    like or
      like data-transfer-item
      like native-null

    take data
    take type

  task add, name <add>
    like or
      like data-transfer-item
      like native-null

    take data

  task clear, name <clear>
    like native-void

  task remove, name <remove>
    like native-void

    take index

  mesh index
    like data-transfer-item


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find event

form device-orientation-event, name <DeviceOrientationEvent>
  base event

  link absolute, name <absolute>
    like native-boolean
  link alpha, name <alpha>
    like or
      like native-number
      like native-null
  link beta, name <beta>
    like or
      like native-number
      like native-null
  link gamma, name <gamma>
    like or
      like native-number
      like native-null

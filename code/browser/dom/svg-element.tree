
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find document-and-element-event-handlers
  find element
  find element-css-inline-style
  find event-listener-options
  find event-listener-or-event-listener-object
  find global-event-handlers
  find html-or-svg-element
  find svg-element-event-map
  find svgsvg-element

form svg-element, name <SVGElement>
  base element
  base document-and-element-event-handlers
  base document-and-element-event-handlers
  base element-css-inline-style
  base global-event-handlers
  base global-event-handlers
  base html-or-svg-element

  link class-name, name <className>
    like any
  link owner-svg-element, name <ownerSVGElement>
    like or
      like svgsvg-element
      like native-null
  link viewport-element, name <viewportElement>
    like or
      like svg-element
      like native-null

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find algorithm
  find buffer-source
  find hash-algorithm-identifier

form pbkdf2-params, name <Pbkdf2Params>
  base algorithm

  link hash, name <hash>
    like hash-algorithm-identifier
    flex true
  link iterations, name <iterations>
    like native-number
    flex true
  link salt, name <salt>
    like buffer-source
    flex true

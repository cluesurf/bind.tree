
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find node
  find x-path-expression
  find x-path-ns-resolver
  find x-path-result

form x-path-evaluator-base, name <XPathEvaluatorBase>
  task create-expression, name <createExpression>
    like x-path-expression

    take expression
    take resolver
      like maybe
        like or
          like x-path-ns-resolver
          like native-null

  task create-ns-resolver, name <createNSResolver>
    like x-path-ns-resolver

    take node-resolver

  task evaluate, name <evaluate>
    like x-path-result

    take expression
    take context-node
    take resolver
      like maybe
        like or
          like x-path-ns-resolver
          like native-null
    take type, like maybe, like native-number
    take result
      like maybe
        like or
          like x-path-result
          like native-null

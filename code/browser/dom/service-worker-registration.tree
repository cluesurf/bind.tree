
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find get-notification-options
  find notification
  find notification-options
  find push-manager
  find service-worker
  find service-worker-registration-event-map
  find service-worker-update-via-cache

load @cluesurf/bind/code/javascript/es5
  find promise

form service-worker-registration, name <ServiceWorkerRegistration>
  base event-target

  link active, name <active>
    like or
      like service-worker
      like native-null
  link installing, name <installing>
    like or
      like service-worker
      like native-null
  link onupdatefound, name <onupdatefound>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link push-manager, name <pushManager>
    like push-manager
  link scope, name <scope>
    like native-string
  link update-via-cache, name <updateViaCache>
    like service-worker-update-via-cache
  link waiting, name <waiting>
    like or
      like service-worker
      like native-null

  task get-notifications, name <getNotifications>
    like promise
      like array
        like notification

    take filter, like maybe, like get-notification-options

  task show-notification, name <showNotification>
    like promise
      like native-void

    take title
    take options, like maybe, like notification-options

  task unregister, name <unregister>
    like promise
      like native-boolean

  task update, name <update>
    like promise
      like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like service-worker-registration-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like service-worker-registration-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

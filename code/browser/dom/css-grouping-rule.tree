
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find css-rule
  find css-rule-list

form css-grouping-rule, name <CSSGroupingRule>
  base css-rule

  link css-rules, name <cssRules>
    like css-rule-list

  task delete-rule, name <deleteRule>
    like native-void

    take index

  task insert-rule, name <insertRule>
    like native-number

    take rule
    take index, like maybe, like native-number


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-void

load @cluesurf/bind/code/browser/dom
  find position-callback
  find position-error-callback
  find position-options

form geolocation, name <Geolocation>
  task clear-watch, name <clearWatch>
    like native-void

    take watch-id

  task get-current-position, name <getCurrentPosition>
    like native-void

    take success-callback
    take error-callback
      like maybe
        like or
          like position-error-callback
          like native-null
    take options, like maybe, like position-options

  task watch-position, name <watchPosition>
    like native-number

    take success-callback
    take error-callback
      like maybe
        like or
          like position-error-callback
          like native-null
    take options, like maybe, like position-options

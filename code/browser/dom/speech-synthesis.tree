
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find speech-synthesis-event-map
  find speech-synthesis-utterance
  find speech-synthesis-voice

form speech-synthesis, name <SpeechSynthesis>
  base event-target

  link onvoiceschanged, name <onvoiceschanged>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link paused, name <paused>
    like native-boolean
  link pending, name <pending>
    like native-boolean
  link speaking, name <speaking>
    like native-boolean

  task cancel, name <cancel>
    like native-void

  task get-voices, name <getVoices>
    like array
      like speech-synthesis-voice

  task pause, name <pause>
    like native-void

  task resume, name <resume>
    like native-void

  task speak, name <speak>
    like native-void

    take utterance

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like speech-synthesis-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like speech-synthesis-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find event-init

form animation-playback-event-init, name <AnimationPlaybackEventInit>
  base event-init

  link current-time, name <currentTime>
    like or
      like native-number
      like native-null
    flex true
  link timeline-time, name <timelineTime>
    like or
      like native-number
      like native-null
    flex true

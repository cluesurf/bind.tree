
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find event

form rtc-peer-connection-ice-error-event, name <RTCPeerConnectionIceErrorEvent>
  base event

  link error-code, name <errorCode>
    like native-number
  link error-text, name <errorText>
    like native-string
  link url, name <url>
    like native-string

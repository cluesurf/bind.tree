
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find blob
  find form-data
  find readable-stream

load @cluesurf/bind/code/javascript/es5
  find array-buffer
  find promise
  find uint8-array

form body, name <Body>
  link body, name <body>
    like or
      like readable-stream
        like uint8-array
      like native-null
  link body-used, name <bodyUsed>
    like native-boolean

  task array-buffer, name <arrayBuffer>
    like promise
      like array-buffer

  task blob, name <blob>
    like promise
      like blob

  task form-data, name <formData>
    like promise
      like form-data

  task json, name <json>
    like promise
      like any

  task text, name <text>
    like promise
      like native-string

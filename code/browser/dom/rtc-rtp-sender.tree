
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-void

load @cluesurf/bind/code/browser/dom
  find media-stream
  find media-stream-track
  find rtc-dtls-transport
  find rtc-rtp-send-parameters
  find rtc-stats-report
  find rtcdtmf-sender

load @cluesurf/bind/code/javascript/es5
  find promise

form rtc-rtp-sender, name <RTCRtpSender>
  link dtmf, name <dtmf>
    like or
      like rtcdtmf-sender
      like native-null
  link track, name <track>
    like or
      like media-stream-track
      like native-null
  link transport, name <transport>
    like or
      like rtc-dtls-transport
      like native-null

  task get-parameters, name <getParameters>
    like rtc-rtp-send-parameters

  task get-stats, name <getStats>
    like promise
      like rtc-stats-report

  task replace-track, name <replaceTrack>
    like promise
      like native-void

    take with-track

  task set-parameters, name <setParameters>
    like promise
      like native-void

    take parameters

  task set-streams, name <setStreams>
    like native-void

    take streams
      like array
        like media-stream
      rest true

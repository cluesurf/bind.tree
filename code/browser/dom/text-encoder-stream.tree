
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find generic-transform-stream
  find readable-stream
  find text-encoder-common
  find writable-stream

load @cluesurf/bind/code/javascript/es5
  find uint8-array

form text-encoder-stream, name <TextEncoderStream>
  base generic-transform-stream
  base text-encoder-common

  link readable, name <readable>
    like readable-stream
      like uint8-array
  link writable, name <writable>
    like writable-stream
      like native-string


load @cluesurf/bind/code/javascript/native
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find url
  find worklet-options

load @cluesurf/bind/code/javascript/es5
  find promise

form worklet, name <Worklet>
  task add-module, name <addModule>
    like promise
      like native-void

    take module-url
    take options, like maybe, like worklet-options

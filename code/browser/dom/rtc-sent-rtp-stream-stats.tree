
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find rtc-rtp-stream-stats

form rtc-sent-rtp-stream-stats, name <RTCSentRtpStreamStats>
  base rtc-rtp-stream-stats

  link bytes-sent, name <bytesSent>
    like native-number
    flex true
  link packets-sent, name <packetsSent>
    like native-number
    flex true


load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find event
  find rtc-ice-candidate

form rtc-peer-connection-ice-event, name <RTCPeerConnectionIceEvent>
  base event

  link candidate, name <candidate>
    like or
      like rtc-ice-candidate
      like native-null

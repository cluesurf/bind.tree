
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find import-export-kind

form module-import-descriptor, name <ModuleImportDescriptor>
  link kind, name <kind>
    like import-export-kind
    flex true
  link module, name <module>
    like native-string
    flex true
  link name, name <name>
    like native-string
    flex true

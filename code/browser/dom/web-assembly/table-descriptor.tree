
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find table-kind

form table-descriptor, name <TableDescriptor>
  link element, name <element>
    like table-kind
    flex true
  link initial, name <initial>
    like native-number
    flex true
  link maximum, name <maximum>
    like native-number
    flex true

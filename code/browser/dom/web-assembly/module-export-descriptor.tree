
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find import-export-kind

form module-export-descriptor, name <ModuleExportDescriptor>
  link kind, name <kind>
    like import-export-kind
    flex true
  link name, name <name>
    like native-string
    flex true

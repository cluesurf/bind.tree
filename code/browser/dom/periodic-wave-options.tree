
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find periodic-wave-constraints

load @cluesurf/bind/code/javascript/es5
  find float32-array

form periodic-wave-options, name <PeriodicWaveOptions>
  base periodic-wave-constraints

  link imag, name <imag>
    like or
      like array
        like native-number
      like float32-array
    flex true
  link real, name <real>
    like or
      like array
        like native-number
      like float32-array
    flex true

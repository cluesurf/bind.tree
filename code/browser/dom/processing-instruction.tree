
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find character-data
  find document
  find link-style

form processing-instruction, name <ProcessingInstruction>
  base character-data
  base link-style

  link owner-document, name <ownerDocument>
    like document
  link target, name <target>
    like native-string

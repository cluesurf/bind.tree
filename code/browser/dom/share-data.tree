
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find file

form share-data, name <ShareData>
  link files, name <files>
    like array
      like file
    flex true
  link text, name <text>
    like native-string
    flex true
  link title, name <title>
    like native-string
    flex true
  link url, name <url>
    like native-string
    flex true

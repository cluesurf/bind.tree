
load @cluesurf/bind/code/browser/dom
  find event
  find html-media-element-event-map

form html-video-element-event-map, name <HTMLVideoElementEventMap>
  base html-media-element-event-map

  link enterpictureinpicture, name <enterpictureinpicture>
    like event
    flex true
  link leavepictureinpicture, name <leavepictureinpicture>
    like event
    flex true

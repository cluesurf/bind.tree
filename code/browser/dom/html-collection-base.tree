
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find element

form html-collection-base, name <HTMLCollectionBase>
  link length, name <length>
    like native-number

  task item, name <item>
    like or
      like element
      like native-null

    take index

  mesh index
    like element


load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/native
  find native-string

form text-decoder-common, name <TextDecoderCommon>
  link encoding, name <encoding>
    like native-string
  link fatal, name <fatal>
    like native-boolean
  link ignore-bom, name <ignoreBOM>
    like native-boolean

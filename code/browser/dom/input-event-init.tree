
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find data-transfer
  find static-range
  find ui-event-init

form input-event-init, name <InputEventInit>
  base ui-event-init

  link data, name <data>
    like or
      like native-string
      like native-null
    flex true
  link data-transfer, name <dataTransfer>
    like or
      like data-transfer
      like native-null
    flex true
  link input-type, name <inputType>
    like native-string
    flex true
  link is-composing, name <isComposing>
    like native-boolean
    flex true
  link target-ranges, name <targetRanges>
    like array
      like static-range
    flex true

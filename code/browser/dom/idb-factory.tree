
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find idb-database-info
  find idb-open-db-request

load @cluesurf/bind/code/javascript/es5
  find promise

form idb-factory, name <IDBFactory>
  task cmp, name <cmp>
    like native-number

    take first
    take second

  task databases, name <databases>
    like promise
      like array
        like idb-database-info

  task delete-database, name <deleteDatabase>
    like idb-open-db-request

    take name

  task open, name <open>
    like idb-open-db-request

    take name
    take version, like maybe, like native-number

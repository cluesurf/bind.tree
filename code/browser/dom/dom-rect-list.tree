
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find dom-rect

form dom-rect-list, name <DOMRectList>
  link length, name <length>
    like native-number

  task item, name <item>
    like or
      like dom-rect
      like native-null

    take index

  mesh index
    like dom-rect

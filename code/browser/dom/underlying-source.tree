
load @cluesurf/bind/code/javascript/native
  find native-undefined

load @cluesurf/bind/code/browser/dom
  find underlying-source-cancel-callback
  find underlying-source-pull-callback
  find underlying-source-start-callback

form underlying-source, name <UnderlyingSource>
  head r
    fall any

  link cancel, name <cancel>
    like underlying-source-cancel-callback
    flex true
  link pull, name <pull>
    like underlying-source-pull-callback
      like r
    flex true
  link start, name <start>
    like underlying-source-start-callback
      like r
    flex true
  link type, name <type>
    like native-undefined
    flex true


load @cluesurf/bind/code/browser/dom/data-transfer
  find data-transfer

load @cluesurf/bind/code/browser/dom/mouse-event
  find mouse-event

load @cluesurf/bind/code/javascript/native
  find native-null

form drag-event, name <DragEvent>
  base mouse-event

  link data-transfer, name <dataTransfer>
    like or
      like data-transfer
      like native-null


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find dom-exception
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find idb-cursor
  find idb-index
  find idb-object-store
  find idb-request-event-map
  find idb-request-ready-state
  find idb-transaction

form idb-request, name <IDBRequest>
  base event-target

  head t
    fall any

  link error, name <error>
    like or
      like dom-exception
      like native-null
  link onerror, name <onerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onsuccess, name <onsuccess>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link ready-state, name <readyState>
    like idb-request-ready-state
  link result, name <result>
    like t
  link source, name <source>
    like or
      like idb-object-store
      like idb-index
      like idb-cursor
  link transaction, name <transaction>
    like or
      like idb-transaction
      like native-null

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like idb-request-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like idb-request-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom
  find abort-signal
  find event-listener-options

form add-event-listener-options, name <AddEventListenerOptions>
  base event-listener-options

  link once, name <once>
    like native-boolean
    flex true
  link passive, name <passive>
    like native-boolean
    flex true
  link signal, name <signal>
    like abort-signal
    flex true

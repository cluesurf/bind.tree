
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find event

form close-event, name <CloseEvent>
  base event

  link code, name <code>
    like native-number
  link reason, name <reason>
    like native-string
  link was-clean, name <wasClean>
    like native-boolean


load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find subtle-crypto

load @cluesurf/bind/code/javascript/es5
  find array-buffer-view

form crypto, name <Crypto>
  link subtle, name <subtle>
    like subtle-crypto

  task get-random-values, name <getRandomValues>
    like t

    head t
      base or
        like array-buffer-view
        like native-null

    take array


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find dom-high-res-time-stamp
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find performance-entry-list
  find performance-event-map
  find performance-mark
  find performance-mark-options
  find performance-measure
  find performance-measure-options
  find performance-navigation
  find performance-timing

form performance, name <Performance>
  base event-target

  link navigation, name <navigation>
    like performance-navigation
  link onresourcetimingbufferfull, name <onresourcetimingbufferfull>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link time-origin, name <timeOrigin>
    like dom-high-res-time-stamp
  link timing, name <timing>
    like performance-timing

  task clear-marks, name <clearMarks>
    like native-void

    take mark-name, like maybe, like native-string

  task clear-measures, name <clearMeasures>
    like native-void

    take measure-name, like maybe, like native-string

  task clear-resource-timings, name <clearResourceTimings>
    like native-void

  task get-entries, name <getEntries>
    like performance-entry-list

  task get-entries-by-name, name <getEntriesByName>
    like performance-entry-list

    take name
    take type, like maybe, like native-string

  task get-entries-by-type, name <getEntriesByType>
    like performance-entry-list

    take type

  task mark, name <mark>
    like performance-mark

    take mark-name
    take mark-options, like maybe, like performance-mark-options

  task measure, name <measure>
    like performance-measure

    take measure-name
    take start-or-measure-options
      like maybe
        like or
          like native-string
          like performance-measure-options
    take end-mark, like maybe, like native-string

  task now, name <now>
    like dom-high-res-time-stamp

  task set-resource-timing-buffer-size, name <setResourceTimingBufferSize>
    like native-void

    take max-size

  task to-json, name <toJSON>
    like any

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like performance-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like performance-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

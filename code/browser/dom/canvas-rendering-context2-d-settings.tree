
load @cluesurf/bind/code/browser/dom/predefined-color-space
  find predefined-color-space

load @cluesurf/bind/code/javascript/native
  find native-boolean

form canvas-rendering-context2-d-settings, name <CanvasRenderingContext2DSettings>
  link alpha, name <alpha>
    like native-boolean
    lock false
  link color-space, name <colorSpace>
    like predefined-color-space
    lock false
  link desynchronized, name <desynchronized>
    like native-boolean
    lock false


load @cluesurf/bind/code/browser/dom
  find event

form notification-event-map, name <NotificationEventMap>
  link click, name <click>
    like event
    flex true
  link close, name <close>
    like event
    flex true
  link error, name <error>
    like event
    flex true
  link show, name <show>
    like event
    flex true


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find ui-event
  find window-proxy

form composition-event, name <CompositionEvent>
  base ui-event

  link data, name <data>
    like native-string

  task init-composition-event, name <initCompositionEvent>
    like native-void

    take type-arg
    take bubbles-arg, like maybe, like native-boolean
    take cancelable-arg, like maybe, like native-boolean
    take view-arg
      like maybe
        like or
          like window-proxy
          like native-null
    take data-arg, like maybe, like native-string

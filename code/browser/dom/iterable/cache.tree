
load @cluesurf/bind/code/javascript/native
  find iterable
  find native-void

load @cluesurf/bind/code/browser/dom
  find request-info

load @cluesurf/bind/code/javascript/es5
  find promise

load @cluesurf/bind/code/browser/dom/cache
  find cache

form cache, name <Cache>
  task add-all, name <addAll>
    like promise
      like native-void

    take requests

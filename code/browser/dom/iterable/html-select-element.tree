
load @cluesurf/bind/code/browser/dom/element
  find element

load @cluesurf/bind/code/browser/dom/html-select-element
  find html-select-element

load @cluesurf/bind/code/javascript/iterable-iterator
  find iterable-iterator

form html-select-element, name <HTMLSelectElement>
  task {symbol/iterator}
    like iterable-iterator
      like element

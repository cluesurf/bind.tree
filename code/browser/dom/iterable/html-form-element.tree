
load @cluesurf/bind/code/browser/dom
  find element

load @cluesurf/bind/code/javascript/native
  find iterable-iterator

load @cluesurf/bind/code/browser/dom/html-form-element
  find html-form-element

form html-form-element, name <HTMLFormElement>
  task {symbol/iterator}
    like iterable-iterator
      like element

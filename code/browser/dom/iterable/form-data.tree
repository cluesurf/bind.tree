
load @cluesurf/bind/code/javascript/native
  find iterable-iterator
  find native-string

load @cluesurf/bind/code/browser/dom
  find form-data-entry-value

load @cluesurf/bind/code/browser/dom/form-data
  find form-data

form form-data, name <FormData>
  task {symbol/iterator}
    like iterable-iterator
      like tuple
        like native-string
        like form-data-entry-value

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like native-string
        like form-data-entry-value

  task keys, name <keys>
    like iterable-iterator
      like native-string

  task values, name <values>
    like iterable-iterator
      like form-data-entry-value

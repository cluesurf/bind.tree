
load @cluesurf/bind/code/javascript/native
  find iterable-iterator
  find native-number

load @cluesurf/bind/code/browser/dom/readable-stream
  find readable-stream

form readable-stream, name <ReadableStream>
  head r
    fall any

  task {symbol/iterator}
    like iterable-iterator
      like any

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like native-number
        like any

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like any

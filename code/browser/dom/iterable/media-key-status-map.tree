
load @cluesurf/bind/code/browser/dom
  find buffer-source
  find media-key-status

load @cluesurf/bind/code/javascript/native
  find iterable-iterator

load @cluesurf/bind/code/browser/dom/media-key-status-map
  find media-key-status-map

form media-key-status-map, name <MediaKeyStatusMap>
  task {symbol/iterator}
    like iterable-iterator
      like tuple
        like buffer-source
        like media-key-status

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like buffer-source
        like media-key-status

  task keys, name <keys>
    like iterable-iterator
      like buffer-source

  task values, name <values>
    like iterable-iterator
      like media-key-status

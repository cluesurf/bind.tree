
load @cluesurf/bind/code/browser/dom
  find element

load @cluesurf/bind/code/javascript/native
  find iterable-iterator

load @cluesurf/bind/code/browser/dom/html-collection-of
  find html-collection-of

form html-collection-of, name <HTMLCollectionOf>
  head t
    base element

  task {symbol/iterator}
    like iterable-iterator
      like t

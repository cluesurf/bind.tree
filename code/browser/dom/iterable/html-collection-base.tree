
load @cluesurf/bind/code/browser/dom
  find element

load @cluesurf/bind/code/javascript/native
  find iterable-iterator

load @cluesurf/bind/code/browser/dom/html-collection-base
  find html-collection-base

form html-collection-base, name <HTMLCollectionBase>
  task {symbol/iterator}
    like iterable-iterator
      like element


load @cluesurf/bind/code/browser/dom/idb-index
  find idb-index

load @cluesurf/bind/code/browser/dom/idb-index-parameters
  find idb-index-parameters

load @cluesurf/bind/code/browser/dom/idb-object-store
  find idb-object-store

load @cluesurf/bind/code/javascript/iterable
  find iterable

load @cluesurf/bind/code/javascript/native
  find native-string

form idb-object-store, name <IDBObjectStore>
  task create-index, name <createIndex>
    take name, like native-string
    take key-path
      like or
        like native-string
        like iterable
          like native-string
    take options, like maybe
      like idb-index-parameters
    like idb-index

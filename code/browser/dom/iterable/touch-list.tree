
load @cluesurf/bind/code/browser/dom/touch
  find touch

load @cluesurf/bind/code/browser/dom/touch-list
  find touch-list

load @cluesurf/bind/code/javascript/iterable-iterator
  find iterable-iterator

form touch-list, name <TouchList>
  task {symbol/iterator}
    like iterable-iterator
      like touch

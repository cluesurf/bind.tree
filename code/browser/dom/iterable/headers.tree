
load @cluesurf/bind/code/javascript/native
  find iterable-iterator
  find native-string

load @cluesurf/bind/code/browser/dom/headers
  find headers

form headers, name <Headers>
  task {symbol/iterator}
    like iterable-iterator
      like tuple
        like native-string
        like native-string

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like native-string
        like native-string

  task keys, name <keys>
    like iterable-iterator
      like native-string

  task values, name <values>
    like iterable-iterator
      like native-string

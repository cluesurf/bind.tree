
load @cluesurf/bind/code/javascript/native
  find iterable
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find message-event-source
  find message-port

load @cluesurf/bind/code/browser/dom/message-event
  find message-event

form message-event, name <MessageEvent>
  head t
    fall any

  task init-message-event, name <initMessageEvent>
    like native-void

    take type
    take bubbles, like maybe, like native-boolean
    take cancelable, like maybe, like native-boolean
    take data, like maybe, like any
    take origin, like maybe, like native-string
    take last-event-id, like maybe, like native-string
    take source
      like maybe
        like or
          like message-event-source
          like native-null
    take ports
      like maybe
        like iterable
          like message-port


load @cluesurf/bind/code/javascript/native
  find iterable-iterator
  find native-number

load @cluesurf/bind/code/browser/dom
  find node

load @cluesurf/bind/code/browser/dom/node-list-of
  find node-list-of

form node-list-of, name <NodeListOf>
  head t-node
    base node

  task {symbol/iterator}
    like iterable-iterator
      like t-node

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like native-number
        like t-node

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like t-node

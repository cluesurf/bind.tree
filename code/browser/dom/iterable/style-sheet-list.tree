
load @cluesurf/bind/code/browser/dom
  find css-style-sheet

load @cluesurf/bind/code/javascript/native
  find iterable-iterator

load @cluesurf/bind/code/browser/dom/style-sheet-list
  find style-sheet-list

form style-sheet-list, name <StyleSheetList>
  task {symbol/iterator}
    like iterable-iterator
      like css-style-sheet

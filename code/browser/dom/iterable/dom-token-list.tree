
load @cluesurf/bind/code/browser/dom/dom-token-list
  find dom-token-list

load @cluesurf/bind/code/javascript/iterable-iterator
  find iterable-iterator

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form dom-token-list, name <DOMTokenList>
  task {symbol/iterator}
    like iterable-iterator
      like native-string

  task entries, name <entries>
    like iterable-iterator
      like band
        like native-number
        like native-string

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like native-string

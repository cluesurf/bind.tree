
load @cluesurf/bind/code/browser/dom
  find element

load @cluesurf/bind/code/javascript/native
  find iterable-iterator

load @cluesurf/bind/code/browser/dom/html-all-collection
  find html-all-collection

form html-all-collection, name <HTMLAllCollection>
  task {symbol/iterator}
    like iterable-iterator
      like element

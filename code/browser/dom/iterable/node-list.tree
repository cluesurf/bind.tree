
load @cluesurf/bind/code/javascript/native
  find iterable-iterator
  find native-number

load @cluesurf/bind/code/browser/dom
  find node

load @cluesurf/bind/code/browser/dom/node-list
  find node-list

form node-list, name <NodeList>
  task {symbol/iterator}
    like iterable-iterator
      like node

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like native-number
        like node

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like node

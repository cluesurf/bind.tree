
load @cluesurf/bind/code/browser/dom/event
  find event

load @cluesurf/bind/code/javascript/es5/promise
  find promise

load @cluesurf/bind/code/javascript/native
  find native-any

form promise-rejection-event, name <PromiseRejectionEvent>
  base event

  link promise, name <promise>
    like promise
      like native-any
  link reason, name <reason>
    like native-any

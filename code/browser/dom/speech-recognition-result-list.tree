
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find speech-recognition-result

form speech-recognition-result-list, name <SpeechRecognitionResultList>
  link length, name <length>
    like native-number

  task item, name <item>
    like speech-recognition-result

    take index

  mesh index
    like speech-recognition-result

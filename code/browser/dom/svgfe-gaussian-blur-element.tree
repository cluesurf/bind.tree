
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-animated-number
  find svg-animated-string
  find svg-element
  find svg-element-event-map
  find svg-filter-primitive-standard-attributes

form svgfe-gaussian-blur-element, name <SVGFEGaussianBlurElement>
  base svg-element
  base svg-filter-primitive-standard-attributes

  link in1, name <in1>
    like svg-animated-string
  link std-deviation-x, name <stdDeviationX>
    like svg-animated-number
  link std-deviation-y, name <stdDeviationY>
    like svg-animated-number

  task set-std-deviation, name <setStdDeviation>
    like native-void

    take std-deviation-x
    take std-deviation-y

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

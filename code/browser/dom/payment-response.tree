
load @cluesurf/bind/code/javascript/native
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find event-target
  find payment-complete
  find payment-validation-errors

load @cluesurf/bind/code/javascript/es5
  find promise

form payment-response, name <PaymentResponse>
  base event-target

  link details, name <details>
    like any
  link method-name, name <methodName>
    like native-string
  link request-id, name <requestId>
    like native-string

  task complete, name <complete>
    like promise
      like native-void

    take result, like maybe, like payment-complete

  task retry, name <retry>
    like promise
      like native-void

    take error-fields, like maybe, like payment-validation-errors

  task to-json, name <toJSON>
    like any

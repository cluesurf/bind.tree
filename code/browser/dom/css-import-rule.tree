
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find css-rule
  find css-style-sheet
  find media-list

form css-import-rule, name <CSSImportRule>
  base css-rule

  link href, name <href>
    like native-string
  link media, name <media>
    like media-list
  link style-sheet, name <styleSheet>
    like css-style-sheet

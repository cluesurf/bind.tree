
load @cluesurf/bind/code/browser/dom/dom-high-res-time-stamp
  find dom-high-res-time-stamp

load @cluesurf/bind/code/browser/dom/gamepad-button
  find gamepad-button

load @cluesurf/bind/code/browser/dom/gamepad-haptic-actuator
  find gamepad-haptic-actuator

load @cluesurf/bind/code/browser/dom/gamepad-mapping-type
  find gamepad-mapping-type

load @cluesurf/bind/code/javascript/es5/readonly-array
  find readonly-array

load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form gamepad, name <Gamepad>
  link axes, name <axes>
    like readonly-array
      like native-number
  link buttons, name <buttons>
    like readonly-array
      like gamepad-button
  link connected, name <connected>
    like native-boolean
  link haptic-actuators, name <hapticActuators>
    like readonly-array
      like gamepad-haptic-actuator
  link id, name <id>
    like native-string
  link index, name <index>
    like native-number
  link mapping, name <mapping>
    like gamepad-mapping-type
  link timestamp, name <timestamp>
    like dom-high-res-time-stamp

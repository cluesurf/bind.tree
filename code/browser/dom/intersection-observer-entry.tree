
load @cluesurf/bind/code/browser/dom/dom-high-res-time-stamp
  find dom-high-res-time-stamp

load @cluesurf/bind/code/browser/dom/dom-rect-read-only
  find dom-rect-read-only

load @cluesurf/bind/code/browser/dom/element
  find element

load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/native
  find native-number

form intersection-observer-entry, name <IntersectionObserverEntry>
  link bounding-client-rect, name <boundingClientRect>
    like dom-rect-read-only
  link intersection-ratio, name <intersectionRatio>
    like native-number
  link intersection-rect, name <intersectionRect>
    like dom-rect-read-only
  link is-intersecting, name <isIntersecting>
    like native-boolean
  link root-bounds, name <rootBounds>
    like or
      like dom-rect-read-only
      like native-null
  link target, name <target>
    like element
  link time, name <time>
    like dom-high-res-time-stamp

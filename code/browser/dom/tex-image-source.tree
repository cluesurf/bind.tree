
load @cluesurf/bind/code/browser/dom
  find html-canvas-element
  find html-image-element
  find html-video-element
  find image-bitmap
  find image-data
  find offscreen-canvas

form tex-image-source, name <TexImageSource>
  like or
    like image-bitmap
    like image-data
    like html-image-element
    like html-canvas-element
    like html-video-element
    like offscreen-canvas


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find html-element
  find html-frame-set-element-event-map
  find window-event-handlers

form html-frame-set-element, name <HTMLFrameSetElement>
  base html-element
  base window-event-handlers

  link cols, name <cols>
    like native-string
    flex true
  link rows, name <rows>
    like native-string
    flex true

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like html-frame-set-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like html-frame-set-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find payment-details-base
  find payment-item

form payment-details-init, name <PaymentDetailsInit>
  base payment-details-base

  link id, name <id>
    like native-string
    flex true
  link total, name <total>
    like payment-item
    flex true

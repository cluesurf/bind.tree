
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

form constrain-dom-string-parameters, name <ConstrainDOMStringParameters>
  link exact, name <exact>
    like or
      like native-string
      like array
        like native-string
    flex true
  link ideal, name <ideal>
    like or
      like native-string
      like array
        like native-string
    flex true

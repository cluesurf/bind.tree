
load @cluesurf/bind/code/browser/dom/event
  find event

load @cluesurf/bind/code/browser/dom/speech-synthesis-utterance
  find speech-synthesis-utterance

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form speech-synthesis-event, name <SpeechSynthesisEvent>
  base event

  link char-index, name <charIndex>
    like native-number
  link char-length, name <charLength>
    like native-number
  link elapsed-time, name <elapsedTime>
    like native-number
  link name, name <name>
    like native-string
  link utterance, name <utterance>
    like speech-synthesis-utterance


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string

load @cluesurf/bind/code/browser/dom
  find media-track-constraints

form media-stream-constraints, name <MediaStreamConstraints>
  link audio, name <audio>
    like or
      like native-boolean
      like media-track-constraints
    flex true
  link peer-identity, name <peerIdentity>
    like native-string
    flex true
  link video, name <video>
    like or
      like native-boolean
      like media-track-constraints
    flex true

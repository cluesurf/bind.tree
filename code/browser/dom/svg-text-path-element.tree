
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-animated-enumeration
  find svg-animated-length
  find svg-element-event-map
  find svg-text-content-element
  find svguri-reference

form svg-text-path-element, name <SVGTextPathElement>
  base svg-text-content-element
  base svguri-reference

  link method, name <method>
    like svg-animated-enumeration
  link spacing, name <spacing>
    like svg-animated-enumeration
  link start-offset, name <startOffset>
    like svg-animated-length
  link textpath-methodtype-align, name <TEXTPATH_METHODTYPE_ALIGN>
    like native-number
  link textpath-methodtype-stretch, name <TEXTPATH_METHODTYPE_STRETCH>
    like native-number
  link textpath-methodtype-unknown, name <TEXTPATH_METHODTYPE_UNKNOWN>
    like native-number
  link textpath-spacingtype-auto, name <TEXTPATH_SPACINGTYPE_AUTO>
    like native-number
  link textpath-spacingtype-exact, name <TEXTPATH_SPACINGTYPE_EXACT>
    like native-number
  link textpath-spacingtype-unknown, name <TEXTPATH_SPACINGTYPE_UNKNOWN>
    like native-number

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

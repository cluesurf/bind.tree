
load @cluesurf/bind/code/javascript/native
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find clipboard-items
  find event-target

load @cluesurf/bind/code/javascript/es5
  find promise

form clipboard, name <Clipboard>
  base event-target

  task read, name <read>
    like promise
      like clipboard-items

  task read-text, name <readText>
    like promise
      like native-string

  task write, name <write>
    like promise
      like native-void

    take data

  task write-text, name <writeText>
    like promise
      like native-void

    take data


load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom
  find touch-list
  find ui-event

form touch-event, name <TouchEvent>
  base ui-event

  link alt-key, name <altKey>
    like native-boolean
  link changed-touches, name <changedTouches>
    like touch-list
  link ctrl-key, name <ctrlKey>
    like native-boolean
  link meta-key, name <metaKey>
    like native-boolean
  link shift-key, name <shiftKey>
    like native-boolean
  link target-touches, name <targetTouches>
    like touch-list
  link touches, name <touches>
    like touch-list

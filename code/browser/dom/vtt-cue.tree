
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find align-setting
  find direction-setting
  find document-fragment
  find event-listener-options
  find event-listener-or-event-listener-object
  find line-align-setting
  find line-and-position-setting
  find position-align-setting
  find text-track-cue
  find text-track-cue-event-map
  find vtt-region

form vtt-cue, name <VTTCue>
  base text-track-cue

  link align, name <align>
    like align-setting
    flex true
  link line, name <line>
    like line-and-position-setting
    flex true
  link line-align, name <lineAlign>
    like line-align-setting
    flex true
  link position, name <position>
    like line-and-position-setting
    flex true
  link position-align, name <positionAlign>
    like position-align-setting
    flex true
  link region, name <region>
    like or
      like vtt-region
      like native-null
    flex true
  link size, name <size>
    like native-number
    flex true
  link snap-to-lines, name <snapToLines>
    like native-boolean
    flex true
  link text, name <text>
    like native-string
    flex true
  link vertical, name <vertical>
    like direction-setting
    flex true

  task get-cue-as-html, name <getCueAsHTML>
    like document-fragment

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like text-track-cue-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like text-track-cue-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

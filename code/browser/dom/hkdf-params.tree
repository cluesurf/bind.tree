
load @cluesurf/bind/code/browser/dom
  find algorithm
  find buffer-source
  find hash-algorithm-identifier

form hkdf-params, name <HkdfParams>
  base algorithm

  link hash, name <hash>
    like hash-algorithm-identifier
    flex true
  link info, name <info>
    like buffer-source
    flex true
  link salt, name <salt>
    like buffer-source
    flex true

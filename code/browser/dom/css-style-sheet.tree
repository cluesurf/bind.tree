
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find css-rule
  find css-rule-list
  find style-sheet

form css-style-sheet, name <CSSStyleSheet>
  base style-sheet

  link css-rules, name <cssRules>
    like css-rule-list
  link owner-rule, name <ownerRule>
    like or
      like css-rule
      like native-null
  link rules, name <rules>
    like css-rule-list

  task add-rule, name <addRule>
    like native-number

    take selector, like maybe, like native-string
    take style, like maybe, like native-string
    take index, like maybe, like native-number

  task delete-rule, name <deleteRule>
    like native-void

    take index

  task insert-rule, name <insertRule>
    like native-number

    take rule
    take index, like maybe, like native-number

  task remove-rule, name <removeRule>
    like native-void

    take index, like maybe, like native-number


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-void

load @cluesurf/bind/code/browser/dom
  find buffer-source
  find float32-list
  find g-lboolean
  find g-lenum
  find g-lint
  find g-lintptr
  find g-lsizei
  find g-lsizeiptr
  find int32-list
  find tex-image-source
  find web-gl-uniform-location

load @cluesurf/bind/code/javascript/es5
  find array-buffer-view

form web-gl-rendering-context-overloads, name <WebGLRenderingContextOverloads>
  task buffer-data, name <bufferData>
    like native-void

    take target
    take size
    take usage

  task buffer-data, name <bufferData>
    like native-void

    take target
    take data
    take usage

  task buffer-sub-data, name <bufferSubData>
    like native-void

    take target
    take offset
    take data

  task compressed-tex-image2-d, name <compressedTexImage2D>
    like native-void

    take target
    take level
    take internalformat
    take width
    take height
    take border
    take data

  task compressed-tex-sub-image2-d, name <compressedTexSubImage2D>
    like native-void

    take target
    take level
    take xoffset
    take yoffset
    take width
    take height
    take format
    take data

  task read-pixels, name <readPixels>
    like native-void

    take x
    take y
    take width
    take height
    take format
    take type
    take pixels

  task tex-image2-d, name <texImage2D>
    like native-void

    take target
    take level
    take internalformat
    take width
    take height
    take border
    take format
    take type
    take pixels

  task tex-image2-d, name <texImage2D>
    like native-void

    take target
    take level
    take internalformat
    take format
    take type
    take source

  task tex-sub-image2-d, name <texSubImage2D>
    like native-void

    take target
    take level
    take xoffset
    take yoffset
    take width
    take height
    take format
    take type
    take pixels

  task tex-sub-image2-d, name <texSubImage2D>
    like native-void

    take target
    take level
    take xoffset
    take yoffset
    take format
    take type
    take source

  task uniform1fv, name <uniform1fv>
    like native-void

    take location
    take v

  task uniform1iv, name <uniform1iv>
    like native-void

    take location
    take v

  task uniform2fv, name <uniform2fv>
    like native-void

    take location
    take v

  task uniform2iv, name <uniform2iv>
    like native-void

    take location
    take v

  task uniform3fv, name <uniform3fv>
    like native-void

    take location
    take v

  task uniform3iv, name <uniform3iv>
    like native-void

    take location
    take v

  task uniform4fv, name <uniform4fv>
    like native-void

    take location
    take v

  task uniform4iv, name <uniform4iv>
    like native-void

    take location
    take v

  task uniform-matrix2fv, name <uniformMatrix2fv>
    like native-void

    take location
    take transpose
    take value

  task uniform-matrix3fv, name <uniformMatrix3fv>
    like native-void

    take location
    take transpose
    take value

  task uniform-matrix4fv, name <uniformMatrix4fv>
    like native-void

    take location
    take transpose
    take value


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find text-track
  find text-track-list-event-map
  find track-event

form text-track-list, name <TextTrackList>
  base event-target

  link length, name <length>
    like native-number
  link onaddtrack, name <onaddtrack>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onchange, name <onchange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onremovetrack, name <onremovetrack>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task get-track-by-id, name <getTrackById>
    like or
      like text-track
      like native-null

    take id

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like text-track-list-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like text-track-list-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  mesh index
    like text-track

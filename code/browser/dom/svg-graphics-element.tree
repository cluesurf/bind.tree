
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find dom-matrix
  find dom-rect
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-animated-transform-list
  find svg-bounding-box-options
  find svg-element
  find svg-element-event-map
  find svg-tests

form svg-graphics-element, name <SVGGraphicsElement>
  base svg-element
  base svg-tests

  link transform, name <transform>
    like svg-animated-transform-list

  task get-b-box, name <getBBox>
    like dom-rect

    take options, like maybe, like svg-bounding-box-options

  task get-ctm, name <getCTM>
    like or
      like dom-matrix
      like native-null

  task get-screen-ctm, name <getScreenCTM>
    like or
      like dom-matrix
      like native-null

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

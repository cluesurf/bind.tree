
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find dom-high-res-time-stamp
  find rtc-stats-type

form rtc-stats, name <RTCStats>
  link id, name <id>
    like native-string
    flex true
  link timestamp, name <timestamp>
    like dom-high-res-time-stamp
    flex true
  link type, name <type>
    like rtc-stats-type
    flex true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find document
  find element

form intersection-observer-init, name <IntersectionObserverInit>
  link root, name <root>
    like or
      like element
      like document
      like native-null
    flex true
  link root-margin, name <rootMargin>
    like native-string
    flex true
  link threshold, name <threshold>
    like or
      like native-number
      like array
        like native-number
    flex true

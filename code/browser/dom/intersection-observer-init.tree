
load @cluesurf/bind/code/browser/dom/document
  find document

load @cluesurf/bind/code/browser/dom/element
  find element

load @cluesurf/bind/code/javascript/native
  find native-array

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form intersection-observer-init, name <IntersectionObserverInit>
  link root, name <root>
    like or
      like element
      like document
      like native-null
    lock false
  link root-margin, name <rootMargin>
    like native-string
    lock false
  link threshold, name <threshold>
    like or
      like native-number
      like native-array
        like native-number
    lock false

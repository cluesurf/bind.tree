
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find event

form idb-version-change-event, name <IDBVersionChangeEvent>
  base event

  link new-version, name <newVersion>
    like or
      like native-number
      like native-null
  link old-version, name <oldVersion>
    like native-number

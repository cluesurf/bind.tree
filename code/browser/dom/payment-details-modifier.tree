
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find payment-item

form payment-details-modifier, name <PaymentDetailsModifier>
  link additional-display-items, name <additionalDisplayItems>
    like array
      like payment-item
    flex true
  link data, name <data>
    like any
    flex true
  link supported-methods, name <supportedMethods>
    like native-string
    flex true
  link total, name <total>
    like payment-item
    flex true

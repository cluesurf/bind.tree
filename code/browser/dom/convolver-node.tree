
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null

load @cluesurf/bind/code/browser/dom
  find audio-buffer
  find audio-node

form convolver-node, name <ConvolverNode>
  base audio-node

  link buffer, name <buffer>
    like or
      like audio-buffer
      like native-null
    flex true
  link normalize, name <normalize>
    like native-boolean
    flex true


load @cluesurf/bind/code/browser/dom
  find event
  find html-element-event-map
  find media-encrypted-event

form html-media-element-event-map, name <HTMLMediaElementEventMap>
  base html-element-event-map

  link encrypted, name <encrypted>
    like media-encrypted-event
    flex true
  link waitingforkey, name <waitingforkey>
    like event
    flex true

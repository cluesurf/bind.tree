
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find dom-string-map
  find focus-options

form html-or-svg-element, name <HTMLOrSVGElement>
  link dataset, name <dataset>
    like dom-string-map
  link nonce, name <nonce>
    like native-string
    flex true
  link tab-index, name <tabIndex>
    like native-number
    flex true

  task blur, name <blur>
    like native-void

  task focus, name <focus>
    like native-void

    take options, like maybe, like focus-options


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-void

load @cluesurf/bind/code/browser/dom
  find node

form node-list, name <NodeList>
  link length, name <length>
    like native-number

  task item, name <item>
    like or
      like node
      like native-null

    take index

  task for-each, name <forEach>
    like native-void

    take callbackfn
    take this-arg, like maybe, like any

  mesh index
    like node

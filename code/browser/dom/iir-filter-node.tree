
load @cluesurf/bind/code/javascript/native
  find native-void

load @cluesurf/bind/code/browser/dom
  find audio-node

load @cluesurf/bind/code/javascript/es5
  find float32-array

form iir-filter-node, name <IIRFilterNode>
  base audio-node

  task get-frequency-response, name <getFrequencyResponse>
    like native-void

    take frequency-hz
    take mag-response
    take phase-response

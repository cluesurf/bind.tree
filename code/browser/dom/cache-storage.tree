
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string
  find native-undefined

load @cluesurf/bind/code/browser/dom
  find cache
  find multi-cache-query-options
  find request-info
  find response

load @cluesurf/bind/code/javascript/es5
  find promise

form cache-storage, name <CacheStorage>
  task delete, name <delete>
    like promise
      like native-boolean

    take cache-name

  task has, name <has>
    like promise
      like native-boolean

    take cache-name

  task keys, name <keys>
    like promise
      like array
        like native-string

  task match, name <match>
    like promise
      like or
        like response
        like native-undefined

    take request
    take options, like maybe, like multi-cache-query-options

  task open, name <open>
    like promise
      like cache

    take cache-name


load @cluesurf/bind/code/javascript/native
  find native-string
  find native-undefined
  find native-void

load @cluesurf/bind/code/browser/dom
  find custom-element-constructor
  find element-definition-options
  find node

load @cluesurf/bind/code/javascript/es5
  find promise

form custom-element-registry, name <CustomElementRegistry>
  task define, name <define>
    like native-void

    take name
    take constructor
    take options, like maybe, like element-definition-options

  task get, name <get>
    like or
      like custom-element-constructor
      like native-undefined

    take name

  task upgrade, name <upgrade>
    like native-void

    take root

  task when-defined, name <whenDefined>
    like promise
      like custom-element-constructor

    take name

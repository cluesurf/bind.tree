
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find double-range

form constrain-double-range, name <ConstrainDoubleRange>
  base double-range

  link exact, name <exact>
    like native-number
    flex true
  link ideal, name <ideal>
    like native-number
    flex true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find audio-node-options

form iir-filter-options, name <IIRFilterOptions>
  base audio-node-options

  link feedback, name <feedback>
    like array
      like native-number
    flex true
  link feedforward, name <feedforward>
    like array
      like native-number
    flex true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find body-init
  find clipboard
  find credentials-container
  find gamepad
  find geolocation
  find media-capabilities
  find media-devices
  find media-key-system-access
  find media-key-system-configuration
  find media-session
  find navigator-automation-information
  find navigator-concurrent-hardware
  find navigator-content-utils
  find navigator-cookies
  find navigator-id
  find navigator-language
  find navigator-network-information
  find navigator-on-line
  find navigator-plugins
  find navigator-storage
  find permissions
  find service-worker-container
  find share-data
  find url
  find vibrate-pattern

load @cluesurf/bind/code/javascript/es5
  find promise

form navigator, name <Navigator>
  base navigator-automation-information
  base navigator-concurrent-hardware
  base navigator-content-utils
  base navigator-cookies
  base navigator-id
  base navigator-language
  base navigator-network-information
  base navigator-on-line
  base navigator-plugins
  base navigator-storage

  link clipboard, name <clipboard>
    like clipboard
  link credentials, name <credentials>
    like credentials-container
  link do-not-track, name <doNotTrack>
    like or
      like native-string
      like native-null
  link geolocation, name <geolocation>
    like geolocation
  link max-touch-points, name <maxTouchPoints>
    like native-number
  link media-capabilities, name <mediaCapabilities>
    like media-capabilities
  link media-devices, name <mediaDevices>
    like media-devices
  link media-session, name <mediaSession>
    like media-session
  link permissions, name <permissions>
    like permissions
  link pointer-enabled, name <pointerEnabled>
    like native-boolean
  link service-worker, name <serviceWorker>
    like service-worker-container

  task get-gamepads, name <getGamepads>
    like array
      like or
        like gamepad
        like native-null

  task request-media-key-system-access, name <requestMediaKeySystemAccess>
    like promise
      like media-key-system-access

    take key-system
    take supported-configurations

  task send-beacon, name <sendBeacon>
    like native-boolean

    take url
    take data
      like maybe
        like or
          like body-init
          like native-null

  task share, name <share>
    like promise
      like native-void

    take data, like maybe, like share-data

  task vibrate, name <vibrate>
    like native-boolean

    take pattern

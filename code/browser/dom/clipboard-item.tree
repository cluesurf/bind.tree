
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find blob

load @cluesurf/bind/code/javascript/es5
  find promise
  find readonly-array

form clipboard-item, name <ClipboardItem>
  link types, name <types>
    like readonly-array
      like native-string

  task get-type, name <getType>
    like promise
      like blob

    take type

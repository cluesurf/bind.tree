
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-undefined
  find native-void

load @cluesurf/bind/code/browser/dom
  find idb-cursor-direction
  find idb-index
  find idb-object-store
  find idb-request
  find idb-valid-key

form idb-cursor, name <IDBCursor>
  link direction, name <direction>
    like idb-cursor-direction
  link key, name <key>
    like idb-valid-key
  link primary-key, name <primaryKey>
    like idb-valid-key
  link request, name <request>
    like idb-request
  link source, name <source>
    like or
      like idb-object-store
      like idb-index

  task advance, name <advance>
    like native-void

    take count

  task continue, name <continue>
    like native-void

    take key, like maybe, like idb-valid-key

  task continue-primary-key, name <continuePrimaryKey>
    like native-void

    take key
    take primary-key

  task delete, name <delete>
    like idb-request
      like native-undefined

  task update, name <update>
    like idb-request
      like idb-valid-key

    take value

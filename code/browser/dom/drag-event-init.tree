
load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find data-transfer
  find mouse-event-init

form drag-event-init, name <DragEventInit>
  base mouse-event-init

  link data-transfer, name <dataTransfer>
    like or
      like data-transfer
      like native-null
    flex true

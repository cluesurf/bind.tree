
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find media-stream
  find media-stream-track
  find rtc-answer-options
  find rtc-configuration
  find rtc-data-channel
  find rtc-data-channel-event
  find rtc-data-channel-init
  find rtc-ice-candidate-init
  find rtc-ice-connection-state
  find rtc-ice-gathering-state
  find rtc-local-session-description-init
  find rtc-offer-options
  find rtc-peer-connection-error-callback
  find rtc-peer-connection-event-map
  find rtc-peer-connection-ice-event
  find rtc-peer-connection-state
  find rtc-rtp-receiver
  find rtc-rtp-sender
  find rtc-rtp-transceiver
  find rtc-rtp-transceiver-init
  find rtc-session-description
  find rtc-session-description-callback
  find rtc-session-description-init
  find rtc-signaling-state
  find rtc-stats-report
  find rtc-track-event
  find void-function

load @cluesurf/bind/code/javascript/es5
  find promise

form rtc-peer-connection, name <RTCPeerConnection>
  base event-target

  link can-trickle-ice-candidates, name <canTrickleIceCandidates>
    like or
      like native-boolean
      like native-null
  link connection-state, name <connectionState>
    like rtc-peer-connection-state
  link current-local-description, name <currentLocalDescription>
    like or
      like rtc-session-description
      like native-null
  link current-remote-description, name <currentRemoteDescription>
    like or
      like rtc-session-description
      like native-null
  link ice-connection-state, name <iceConnectionState>
    like rtc-ice-connection-state
  link ice-gathering-state, name <iceGatheringState>
    like rtc-ice-gathering-state
  link local-description, name <localDescription>
    like or
      like rtc-session-description
      like native-null
  link onconnectionstatechange, name <onconnectionstatechange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link ondatachannel, name <ondatachannel>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onicecandidate, name <onicecandidate>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link oniceconnectionstatechange, name <oniceconnectionstatechange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onicegatheringstatechange, name <onicegatheringstatechange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onnegotiationneeded, name <onnegotiationneeded>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onsignalingstatechange, name <onsignalingstatechange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link ontrack, name <ontrack>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link pending-local-description, name <pendingLocalDescription>
    like or
      like rtc-session-description
      like native-null
  link pending-remote-description, name <pendingRemoteDescription>
    like or
      like rtc-session-description
      like native-null
  link remote-description, name <remoteDescription>
    like or
      like rtc-session-description
      like native-null
  link signaling-state, name <signalingState>
    like rtc-signaling-state

  task add-ice-candidate, name <addIceCandidate>
    like promise
      like native-void

    take candidate, like maybe, like rtc-ice-candidate-init

  task add-ice-candidate, name <addIceCandidate>
    like promise
      like native-void

    take candidate
    take success-callback
    take failure-callback

  task add-track, name <addTrack>
    like rtc-rtp-sender

    take track
    take streams
      like array
        like media-stream
      rest true

  task add-transceiver, name <addTransceiver>
    like rtc-rtp-transceiver

    take track-or-kind
    take init, like maybe, like rtc-rtp-transceiver-init

  task close, name <close>
    like native-void

  task create-answer, name <createAnswer>
    like promise
      like rtc-session-description-init

    take options, like maybe, like rtc-answer-options

  task create-answer, name <createAnswer>
    like promise
      like native-void

    take success-callback
    take failure-callback

  task create-data-channel, name <createDataChannel>
    like rtc-data-channel

    take label
    take data-channel-dict, like maybe, like rtc-data-channel-init

  task create-offer, name <createOffer>
    like promise
      like rtc-session-description-init

    take options, like maybe, like rtc-offer-options

  task create-offer, name <createOffer>
    like promise
      like native-void

    take success-callback
    take failure-callback
    take options, like maybe, like rtc-offer-options

  task get-configuration, name <getConfiguration>
    like rtc-configuration

  task get-receivers, name <getReceivers>
    like array
      like rtc-rtp-receiver

  task get-senders, name <getSenders>
    like array
      like rtc-rtp-sender

  task get-stats, name <getStats>
    like promise
      like rtc-stats-report

    take selector
      like maybe
        like or
          like media-stream-track
          like native-null

  task get-transceivers, name <getTransceivers>
    like array
      like rtc-rtp-transceiver

  task remove-track, name <removeTrack>
    like native-void

    take sender

  task restart-ice, name <restartIce>
    like native-void

  task set-configuration, name <setConfiguration>
    like native-void

    take configuration, like maybe, like rtc-configuration

  task set-local-description, name <setLocalDescription>
    like promise
      like native-void

    take description, like maybe, like rtc-local-session-description-init

  task set-local-description, name <setLocalDescription>
    like promise
      like native-void

    take description
    take success-callback
    take failure-callback

  task set-remote-description, name <setRemoteDescription>
    like promise
      like native-void

    take description

  task set-remote-description, name <setRemoteDescription>
    like promise
      like native-void

    take description
    take success-callback
    take failure-callback

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like rtc-peer-connection-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like rtc-peer-connection-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

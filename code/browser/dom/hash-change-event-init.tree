
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find event-init

form hash-change-event-init, name <HashChangeEventInit>
  base event-init

  link new-url, name <newURL>
    like native-string
    flex true
  link old-url, name <oldURL>
    like native-string
    flex true

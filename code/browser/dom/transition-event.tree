
load @cluesurf/bind/code/browser/dom/event
  find event

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form transition-event, name <TransitionEvent>
  base event

  link elapsed-time, name <elapsedTime>
    like native-number
  link property-name, name <propertyName>
    like native-string
  link pseudo-element, name <pseudoElement>
    like native-string

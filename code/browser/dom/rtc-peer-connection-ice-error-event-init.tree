
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find event-init

form rtc-peer-connection-ice-error-event-init, name <RTCPeerConnectionIceErrorEventInit>
  base event-init

  link address, name <address>
    like or
      like native-string
      like native-null
    flex true
  link error-code, name <errorCode>
    like native-number
    flex true
  link error-text, name <errorText>
    like native-string
    flex true
  link port, name <port>
    like or
      like native-number
      like native-null
    flex true
  link url, name <url>
    like native-string
    flex true

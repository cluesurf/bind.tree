
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-void

load @cluesurf/bind/code/browser/dom
  find mutation-observer-init
  find mutation-record
  find node

form mutation-observer, name <MutationObserver>
  task disconnect, name <disconnect>
    like native-void

  task observe, name <observe>
    like native-void

    take target
    take options, like maybe, like mutation-observer-init

  task take-records, name <takeRecords>
    like array
      like mutation-record

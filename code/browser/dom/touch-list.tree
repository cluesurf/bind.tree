
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find touch

form touch-list, name <TouchList>
  link length, name <length>
    like native-number

  task item, name <item>
    like or
      like touch
      like native-null

    take index

  mesh index
    like touch

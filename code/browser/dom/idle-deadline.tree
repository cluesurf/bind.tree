
load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom
  find dom-high-res-time-stamp

form idle-deadline, name <IdleDeadline>
  link did-timeout, name <didTimeout>
    like native-boolean

  task time-remaining, name <timeRemaining>
    like dom-high-res-time-stamp


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find svg-animated-enumeration
  find svg-animated-number
  find svg-animated-string
  find svg-element
  find svg-element-event-map
  find svg-filter-primitive-standard-attributes

form svgfe-displacement-map-element, name <SVGFEDisplacementMapElement>
  base svg-element
  base svg-filter-primitive-standard-attributes

  link in1, name <in1>
    like svg-animated-string
  link in2, name <in2>
    like svg-animated-string
  link scale, name <scale>
    like svg-animated-number
  link x-channel-selector, name <xChannelSelector>
    like svg-animated-enumeration
  link y-channel-selector, name <yChannelSelector>
    like svg-animated-enumeration
  link svg-channel-a, name <SVG_CHANNEL_A>
    like native-number
  link svg-channel-b, name <SVG_CHANNEL_B>
    like native-number
  link svg-channel-g, name <SVG_CHANNEL_G>
    like native-number
  link svg-channel-r, name <SVG_CHANNEL_R>
    like native-number
  link svg-channel-unknown, name <SVG_CHANNEL_UNKNOWN>
    like native-number

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like svg-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find key-algorithm

form hmac-key-algorithm, name <HmacKeyAlgorithm>
  base key-algorithm

  link hash, name <hash>
    like key-algorithm
    flex true
  link length, name <length>
    like native-number
    flex true

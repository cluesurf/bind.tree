
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find document
  find element
  find intersection-observer-entry

load @cluesurf/bind/code/javascript/es5
  find readonly-array

form intersection-observer, name <IntersectionObserver>
  link root, name <root>
    like or
      like element
      like document
      like native-null
  link root-margin, name <rootMargin>
    like native-string
  link thresholds, name <thresholds>
    like readonly-array
      like native-number

  task disconnect, name <disconnect>
    like native-void

  task observe, name <observe>
    like native-void

    take target

  task take-records, name <takeRecords>
    like array
      like intersection-observer-entry

  task unobserve, name <unobserve>
    like native-void

    take target

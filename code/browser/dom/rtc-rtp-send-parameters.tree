
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find rtc-degradation-preference
  find rtc-rtp-encoding-parameters
  find rtc-rtp-parameters

form rtc-rtp-send-parameters, name <RTCRtpSendParameters>
  base rtc-rtp-parameters

  link degradation-preference, name <degradationPreference>
    like rtc-degradation-preference
    flex true
  link encodings, name <encodings>
    like array
      like rtc-rtp-encoding-parameters
    flex true
  link transaction-id, name <transactionId>
    like native-string
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

form rtc-rtp-codec-capability, name <RTCRtpCodecCapability>
  link channels, name <channels>
    like native-number
    flex true
  link clock-rate, name <clockRate>
    like native-number
    flex true
  link mime-type, name <mimeType>
    like native-string
    flex true
  link sdp-fmtp-line, name <sdpFmtpLine>
    like native-string
    flex true

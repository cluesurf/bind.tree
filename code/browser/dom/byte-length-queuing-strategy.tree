
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find queuing-strategy
  find queuing-strategy-size

load @cluesurf/bind/code/javascript/es5
  find array-buffer-view

form byte-length-queuing-strategy, name <ByteLengthQueuingStrategy>
  base queuing-strategy

  link high-water-mark, name <highWaterMark>
    like native-number
  link size, name <size>
    like queuing-strategy-size
      like array-buffer-view


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find algorithm
  find buffer-source

form aes-ctr-params, name <AesCtrParams>
  base algorithm

  link counter, name <counter>
    like buffer-source
    flex true
  link length, name <length>
    like native-number
    flex true

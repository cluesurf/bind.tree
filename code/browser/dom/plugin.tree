
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string
  find native-undefined
  find native-void

form plugin, name <Plugin>
  link description, name <description>
    like native-undefined
  link filename, name <filename>
    like native-undefined
  link length, name <length>
    like native-undefined
  link name, name <name>
    like native-undefined

  task item, name <item>
    like native-void

    take index

  task named-item, name <namedItem>
    like native-void

    take name

  mesh index
    like native-undefined


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find audio-node-options

load @cluesurf/bind/code/javascript/es5
  find record

form audio-worklet-node-options, name <AudioWorkletNodeOptions>
  base audio-node-options

  link number-of-inputs, name <numberOfInputs>
    like native-number
    flex true
  link number-of-outputs, name <numberOfOutputs>
    like native-number
    flex true
  link output-channel-count, name <outputChannelCount>
    like array
      like native-number
    flex true
  link parameter-data, name <parameterData>
    like record
      like native-string
      like native-number
    flex true
  link processor-options, name <processorOptions>
    like any
    flex true

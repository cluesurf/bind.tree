
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find css-rule
  find css-style-declaration

form css-keyframe-rule, name <CSSKeyframeRule>
  base css-rule

  link key-text, name <keyText>
    like native-string
    flex true
  link style, name <style>
    like css-style-declaration


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find media-image

form media-metadata-init, name <MediaMetadataInit>
  link album, name <album>
    like native-string
    flex true
  link artist, name <artist>
    like native-string
    flex true
  link artwork, name <artwork>
    like array
      like media-image
    flex true
  link title, name <title>
    like native-string
    flex true

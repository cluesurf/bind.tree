
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find blob
  find buffer-source
  find form-data
  find url-search-params

form xml-http-request-body-init, name <XMLHttpRequestBodyInit>
  like or
    like blob
    like buffer-source
    like form-data
    like url-search-params
    like native-string

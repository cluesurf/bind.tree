
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find display-media-stream-constraints
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find media-device-info
  find media-devices-event-map
  find media-stream
  find media-stream-constraints
  find media-track-supported-constraints

load @cluesurf/bind/code/javascript/es5
  find promise

form media-devices, name <MediaDevices>
  base event-target

  link ondevicechange, name <ondevicechange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task enumerate-devices, name <enumerateDevices>
    like promise
      like array
        like media-device-info

  task get-display-media, name <getDisplayMedia>
    like promise
      like media-stream

    take constraints, like maybe, like display-media-stream-constraints

  task get-supported-constraints, name <getSupportedConstraints>
    like media-track-supported-constraints

  task get-user-media, name <getUserMedia>
    like promise
      like media-stream

    take constraints, like maybe, like media-stream-constraints

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like media-devices-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like media-devices-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find buffer-source
  find public-key-credential-entity

form public-key-credential-user-entity, name <PublicKeyCredentialUserEntity>
  base public-key-credential-entity

  link display-name, name <displayName>
    like native-string
    flex true
  link id, name <id>
    like buffer-source
    flex true

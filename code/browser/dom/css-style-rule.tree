
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find css-rule
  find css-style-declaration

form css-style-rule, name <CSSStyleRule>
  base css-rule

  link selector-text, name <selectorText>
    like native-string
    flex true
  link style, name <style>
    like css-style-declaration


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find css-rule

form css-namespace-rule, name <CSSNamespaceRule>
  base css-rule

  link namespace-uri, name <namespaceURI>
    like native-string
  link prefix, name <prefix>
    like native-string

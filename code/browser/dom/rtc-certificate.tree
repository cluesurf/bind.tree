
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/browser/dom
  find dom-time-stamp
  find rtc-dtls-fingerprint

form rtc-certificate, name <RTCCertificate>
  link expires, name <expires>
    like dom-time-stamp

  task get-fingerprints, name <getFingerprints>
    like array
      like rtc-dtls-fingerprint

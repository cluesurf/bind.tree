
load @cluesurf/bind/code/browser/dom/dom-time-stamp
  find dom-time-stamp

load @cluesurf/bind/code/browser/dom/rtc-dtls-fingerprint
  find rtc-dtls-fingerprint

load @cluesurf/bind/code/javascript/native
  find native-array

form rtc-certificate, name <RTCCertificate>
  link expires, name <expires>
    like dom-time-stamp

  task get-fingerprints, name <getFingerprints>
    like native-array
      like rtc-dtls-fingerprint


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find text-track-cue

form text-track-cue-list, name <TextTrackCueList>
  link length, name <length>
    like native-number

  task get-cue-by-id, name <getCueById>
    like or
      like text-track-cue
      like native-null

    take id

  mesh index
    like text-track-cue

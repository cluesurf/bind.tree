
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number

load @cluesurf/bind/code/browser/dom
  find speech-recognition-alternative

form speech-recognition-result, name <SpeechRecognitionResult>
  link is-final, name <isFinal>
    like native-boolean
  link length, name <length>
    like native-number

  task item, name <item>
    like speech-recognition-alternative

    take index

  mesh index
    like speech-recognition-alternative

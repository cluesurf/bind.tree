
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find constrain-dom-string-parameters

form constrain-dom-string, name <ConstrainDOMString>
  like or
    like native-string
    like array
      like native-string
    like constrain-dom-string-parameters


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find buffer-source

load @cluesurf/bind/code/javascript/es5
  find date

form idb-valid-key, name <IDBValidKey>
  like or
    like native-number
    like native-string
    like date
    like buffer-source
    like array
      like idb-valid-key

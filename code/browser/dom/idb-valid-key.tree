
load @cluesurf/bind/code/browser/dom/buffer-source
  find buffer-source

load @cluesurf/bind/code/javascript/es5/date
  find date

load @cluesurf/bind/code/javascript/native
  find native-array

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form idb-valid-key, name <IDBValidKey>
  like or
    like native-number
    like native-string
    like date
    like buffer-source
    like native-array
      like idb-valid-key

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find element

form non-element-parent-node, name <NonElementParentNode>
  task get-element-by-id, name <getElementById>
    like or
      like element
      like native-null

    take element-id

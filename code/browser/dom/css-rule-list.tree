
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find css-rule

form css-rule-list, name <CSSRuleList>
  link length, name <length>
    like native-number

  task item, name <item>
    like or
      like css-rule
      like native-null

    take index

  mesh index
    like css-rule


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find media-image

load @cluesurf/bind/code/javascript/es5
  find readonly-array

form media-metadata, name <MediaMetadata>
  link album, name <album>
    like native-string
    flex true
  link artist, name <artist>
    like native-string
    flex true
  link artwork, name <artwork>
    like readonly-array
      like media-image
    flex true
  link title, name <title>
    like native-string
    flex true

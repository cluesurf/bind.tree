
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find audio-node-options
  find over-sample-type

load @cluesurf/bind/code/javascript/es5
  find float32-array

form wave-shaper-options, name <WaveShaperOptions>
  base audio-node-options

  link curve, name <curve>
    like or
      like array
        like native-number
      like float32-array
    flex true
  link oversample, name <oversample>
    like over-sample-type
    flex true


load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find event-init
  find html-element

form submit-event-init, name <SubmitEventInit>
  base event-init

  link submitter, name <submitter>
    like or
      like html-element
      like native-null
    flex true

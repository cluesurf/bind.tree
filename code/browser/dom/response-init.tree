
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find headers-init

form response-init, name <ResponseInit>
  link headers, name <headers>
    like headers-init
    flex true
  link status, name <status>
    like native-number
    flex true
  link status-text, name <statusText>
    like native-string
    flex true

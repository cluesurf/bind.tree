
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find big-integer
  find key-algorithm

form rsa-key-algorithm, name <RsaKeyAlgorithm>
  base key-algorithm

  link modulus-length, name <modulusLength>
    like native-number
    flex true
  link public-exponent, name <publicExponent>
    like big-integer
    flex true

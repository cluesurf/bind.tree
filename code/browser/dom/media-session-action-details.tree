
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find media-session-action

form media-session-action-details, name <MediaSessionActionDetails>
  link action, name <action>
    like media-session-action
    flex true
  link fast-seek, name <fastSeek>
    like or
      like native-boolean
      like native-null
    flex true
  link seek-offset, name <seekOffset>
    like or
      like native-number
      like native-null
    flex true
  link seek-time, name <seekTime>
    like or
      like native-number
      like native-null
    flex true

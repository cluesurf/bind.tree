
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/dom
  find device-motion-event-acceleration
  find device-motion-event-rotation-rate
  find event

form device-motion-event, name <DeviceMotionEvent>
  base event

  link acceleration, name <acceleration>
    like or
      like device-motion-event-acceleration
      like native-null
  link acceleration-including-gravity, name <accelerationIncludingGravity>
    like or
      like device-motion-event-acceleration
      like native-null
  link interval, name <interval>
    like native-number
  link rotation-rate, name <rotationRate>
    like or
      like device-motion-event-rotation-rate
      like native-null


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string
  find native-undefined

load @cluesurf/bind/code/browser/dom
  find composite-operation-or-auto

form property-indexed-keyframes, name <PropertyIndexedKeyframes>
  link composite, name <composite>
    like or
      like composite-operation-or-auto
      like array
        like composite-operation-or-auto
    flex true
  link easing, name <easing>
    like or
      like native-string
      like array
        like native-string
    flex true
  link offset, name <offset>
    like or
      like native-number
      like array
        like or
          like native-number
          like native-null
    flex true

  mesh property
    like or
      like native-string
      like array
        like native-string
      like native-number
      like native-null
      like array
        like or
          like native-number
          like native-null
      like native-undefined

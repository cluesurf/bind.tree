
load @cluesurf/bind/code/browser/dom/data-transfer
  find data-transfer

load @cluesurf/bind/code/browser/dom/event-init
  find event-init

load @cluesurf/bind/code/javascript/native
  find native-null

form clipboard-event-init, name <ClipboardEventInit>
  base event-init

  link clipboard-data, name <clipboardData>
    like or
      like data-transfer
      like native-null
    lock false

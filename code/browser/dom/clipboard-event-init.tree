
load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find data-transfer
  find event-init

form clipboard-event-init, name <ClipboardEventInit>
  base event-init

  link clipboard-data, name <clipboardData>
    like or
      like data-transfer
      like native-null
    flex true

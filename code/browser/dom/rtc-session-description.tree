
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom
  find rtc-sdp-type

form rtc-session-description, name <RTCSessionDescription>
  link sdp, name <sdp>
    like native-string
  link type, name <type>
    like rtc-sdp-type

  task to-json, name <toJSON>
    like any

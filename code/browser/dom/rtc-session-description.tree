
load @cluesurf/bind/code/browser/dom/rtc-sdp-type
  find rtc-sdp-type

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-string

form rtc-session-description, name <RTCSessionDescription>
  link sdp, name <sdp>
    like native-string
  link type, name <type>
    like rtc-sdp-type

  task to-json, name <toJSON>
    like native-any

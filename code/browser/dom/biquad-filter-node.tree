
load @cluesurf/bind/code/javascript/native
  find native-void

load @cluesurf/bind/code/browser/dom
  find audio-node
  find audio-param
  find biquad-filter-type

load @cluesurf/bind/code/javascript/es5
  find float32-array

form biquad-filter-node, name <BiquadFilterNode>
  base audio-node

  link q, name <Q>
    like audio-param
  link detune, name <detune>
    like audio-param
  link frequency, name <frequency>
    like audio-param
  link gain, name <gain>
    like audio-param
  link type, name <type>
    like biquad-filter-type
    flex true

  task get-frequency-response, name <getFrequencyResponse>
    like native-void

    take frequency-hz
    take mag-response
    take phase-response


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find audio-node
  find audio-param-map
  find audio-worklet-node-event-map
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find message-port

form audio-worklet-node, name <AudioWorkletNode>
  base audio-node

  link onprocessorerror, name <onprocessorerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link parameters, name <parameters>
    like audio-param-map
  link port, name <port>
    like message-port

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like audio-worklet-node-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like audio-worklet-node-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/browser/dom/dom-high-res-time-stamp
  find dom-high-res-time-stamp

load @cluesurf/bind/code/javascript/native
  find native-any

form performance-mark-options, name <PerformanceMarkOptions>
  link detail, name <detail>
    like native-any
    lock false
  link start-time, name <startTime>
    like dom-high-res-time-stamp
    lock false


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find css-keyframe-rule
  find css-rule
  find css-rule-list

form css-keyframes-rule, name <CSSKeyframesRule>
  base css-rule

  link css-rules, name <cssRules>
    like css-rule-list
  link name, name <name>
    like native-string
    flex true

  task append-rule, name <appendRule>
    like native-void

    take rule

  task delete-rule, name <deleteRule>
    like native-void

    take select

  task find-rule, name <findRule>
    like or
      like css-keyframe-rule
      like native-null

    take select


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find audio-node-options

form dynamics-compressor-options, name <DynamicsCompressorOptions>
  base audio-node-options

  link attack, name <attack>
    like native-number
    flex true
  link knee, name <knee>
    like native-number
    flex true
  link ratio, name <ratio>
    like native-number
    flex true
  link release, name <release>
    like native-number
    flex true
  link threshold, name <threshold>
    like native-number
    flex true

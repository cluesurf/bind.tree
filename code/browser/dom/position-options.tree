
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number

form position-options, name <PositionOptions>
  link enable-high-accuracy, name <enableHighAccuracy>
    like native-boolean
    flex true
  link maximum-age, name <maximumAge>
    like native-number
    flex true
  link timeout, name <timeout>
    like native-number
    flex true


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find html-element
  find html-element-event-map

form htmlo-list-element, name <HTMLOListElement>
  base html-element

  link compact, name <compact>
    like native-boolean
    flex true
  link reversed, name <reversed>
    like native-boolean
    flex true
  link start, name <start>
    like native-number
    flex true
  link type, name <type>
    like native-string
    flex true

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like html-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like html-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

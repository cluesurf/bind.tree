
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find event
  find window

form ui-event, name <UIEvent>
  base event

  link detail, name <detail>
    like native-number
  link view, name <view>
    like or
      like window
      like native-null
  link which, name <which>
    like native-number

  task init-ui-event, name <initUIEvent>
    like native-void

    take type-arg
    take bubbles-arg, like maybe, like native-boolean
    take cancelable-arg, like maybe, like native-boolean
    take view-arg
      like maybe
        like or
          like window
          like native-null
    take detail-arg, like maybe, like native-number

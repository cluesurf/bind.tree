
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find html-element
  find html-element-event-map
  find html-label-element
  find node-list-of

form html-meter-element, name <HTMLMeterElement>
  base html-element

  link high, name <high>
    like native-number
    flex true
  link labels, name <labels>
    like node-list-of
      like html-label-element
  link low, name <low>
    like native-number
    flex true
  link max, name <max>
    like native-number
    flex true
  link min, name <min>
    like native-number
    flex true
  link optimum, name <optimum>
    like native-number
    flex true
  link value, name <value>
    like native-number
    flex true

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like html-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like html-element-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

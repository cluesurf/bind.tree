
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find css-style-sheet
  find element
  find media-list
  find processing-instruction

form style-sheet, name <StyleSheet>
  link disabled, name <disabled>
    like native-boolean
    flex true
  link href, name <href>
    like or
      like native-string
      like native-null
  link media, name <media>
    like media-list
  link owner-node, name <ownerNode>
    like or
      like element
      like processing-instruction
      like native-null
  link parent-style-sheet, name <parentStyleSheet>
    like or
      like css-style-sheet
      like native-null
  link title, name <title>
    like or
      like native-string
      like native-null
  link type, name <type>
    like native-string


load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find audio-node
  find over-sample-type

load @cluesurf/bind/code/javascript/es5
  find float32-array

form wave-shaper-node, name <WaveShaperNode>
  base audio-node

  link curve, name <curve>
    like or
      like float32-array
      like native-null
    flex true
  link oversample, name <oversample>
    like over-sample-type
    flex true

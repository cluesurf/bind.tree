
load @cluesurf/bind/code/browser/dom/event
  find event

load @cluesurf/bind/code/browser/dom/media-key-message-type
  find media-key-message-type

load @cluesurf/bind/code/javascript/es5/array-buffer
  find array-buffer

form media-key-message-event, name <MediaKeyMessageEvent>
  base event

  link message, name <message>
    like array-buffer
  link message-type, name <messageType>
    like media-key-message-type

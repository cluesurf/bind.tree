
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find event-init
  find rtc-ice-candidate

form rtc-peer-connection-ice-event-init, name <RTCPeerConnectionIceEventInit>
  base event-init

  link candidate, name <candidate>
    like or
      like rtc-ice-candidate
      like native-null
    flex true
  link url, name <url>
    like or
      like native-string
      like native-null
    flex true

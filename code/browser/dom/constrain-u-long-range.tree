
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find u-long-range

form constrain-u-long-range, name <ConstrainULongRange>
  base u-long-range

  link exact, name <exact>
    like native-number
    flex true
  link ideal, name <ideal>
    like native-number
    flex true

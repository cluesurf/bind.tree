
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find audio-node
  find audio-param

form dynamics-compressor-node, name <DynamicsCompressorNode>
  base audio-node

  link attack, name <attack>
    like audio-param
  link knee, name <knee>
    like audio-param
  link ratio, name <ratio>
    like audio-param
  link reduction, name <reduction>
    like native-number
  link release, name <release>
    like audio-param
  link threshold, name <threshold>
    like audio-param


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom
  find rtc-sent-rtp-stream-stats

form rtc-outbound-rtp-stream-stats, name <RTCOutboundRtpStreamStats>
  base rtc-sent-rtp-stream-stats

  link fir-count, name <firCount>
    like native-number
    flex true
  link frames-encoded, name <framesEncoded>
    like native-number
    flex true
  link nack-count, name <nackCount>
    like native-number
    flex true
  link pli-count, name <pliCount>
    like native-number
    flex true
  link qp-sum, name <qpSum>
    like native-number
    flex true
  link remote-id, name <remoteId>
    like native-string
    flex true

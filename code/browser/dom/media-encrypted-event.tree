
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find event

load @cluesurf/bind/code/javascript/es5
  find array-buffer

form media-encrypted-event, name <MediaEncryptedEvent>
  base event

  link init-data, name <initData>
    like or
      like array-buffer
      like native-null
  link init-data-type, name <initDataType>
    like native-string

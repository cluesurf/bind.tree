
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find add-event-listener-options
  find audio-node
  find audio-scheduled-source-node-event-map
  find event
  find event-listener-options
  find event-listener-or-event-listener-object

form audio-scheduled-source-node, name <AudioScheduledSourceNode>
  base audio-node

  link onended, name <onended>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task start, name <start>
    like native-void

    take when, like maybe, like native-number

  task stop, name <stop>
    like native-void

    take when, like maybe, like native-number

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like audio-scheduled-source-node-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like audio-scheduled-source-node-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/dom
  find element

form non-document-type-child-node, name <NonDocumentTypeChildNode>
  link next-element-sibling, name <nextElementSibling>
    like or
      like element
      like native-null
  link previous-element-sibling, name <previousElementSibling>
    like or
      like element
      like native-null

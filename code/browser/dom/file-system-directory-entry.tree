
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/dom
  find error-callback
  find file-system-directory-reader
  find file-system-entry
  find file-system-entry-callback
  find file-system-flags

form file-system-directory-entry, name <FileSystemDirectoryEntry>
  base file-system-entry

  task create-reader, name <createReader>
    like file-system-directory-reader

  task get-directory, name <getDirectory>
    like native-void

    take path
      like maybe
        like or
          like native-string
          like native-null
    take options, like maybe, like file-system-flags
    take success-callback, like maybe, like file-system-entry-callback
    take error-callback, like maybe, like error-callback

  task get-file, name <getFile>
    like native-void

    take path
      like maybe
        like or
          like native-string
          like native-null
    take options, like maybe, like file-system-flags
    take success-callback, like maybe, like file-system-entry-callback
    take error-callback, like maybe, like error-callback

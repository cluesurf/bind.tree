
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom
  find data-transfer
  find static-range
  find ui-event

form input-event, name <InputEvent>
  base ui-event

  link data, name <data>
    like or
      like native-string
      like native-null
  link data-transfer, name <dataTransfer>
    like or
      like data-transfer
      like native-null
  link input-type, name <inputType>
    like native-string
  link is-composing, name <isComposing>
    like native-boolean

  task get-target-ranges, name <getTargetRanges>
    like array
      like static-range

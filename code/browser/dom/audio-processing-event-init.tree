
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom
  find audio-buffer
  find event-init

form audio-processing-event-init, name <AudioProcessingEventInit>
  base event-init

  link input-buffer, name <inputBuffer>
    like audio-buffer
    flex true
  link output-buffer, name <outputBuffer>
    like audio-buffer
    flex true
  link playback-time, name <playbackTime>
    like native-number
    flex true

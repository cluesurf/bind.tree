
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/webworker
  find dom-rect-read-only

load @cluesurf/bind/code/browser/dom/dom-rect
  find dom-rect

form dom-rect, name <DOMRect>
  base dom-rect-read-only

  link height, name <height>
    like native-number
    flex true
  link width, name <width>
    like native-number
    flex true
  link x, name <x>
    like native-number
    flex true
  link y, name <y>
    like native-number
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-void

load @cluesurf/bind/code/browser/dom/image-bitmap
  find image-bitmap

form image-bitmap, name <ImageBitmap>
  link height, name <height>
    like native-number
  link width, name <width>
    like native-number

  task close, name <close>
    like native-void


load @cluesurf/bind/code/browser/webworker
  find event

load @cluesurf/bind/code/browser/dom/idb-request-event-map
  find idb-request-event-map

form idb-request-event-map, name <IDBRequestEventMap>
  link error, name <error>
    like event
    flex true
  link success, name <success>
    like event
    flex true

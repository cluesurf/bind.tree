
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find canvas-gradient
  find canvas-image-source
  find canvas-pattern

load @cluesurf/bind/code/browser/dom/canvas-fill-stroke-styles
  find canvas-fill-stroke-styles

form canvas-fill-stroke-styles, name <CanvasFillStrokeStyles>
  link fill-style, name <fillStyle>
    like or
      like native-string
      like canvas-gradient
      like canvas-pattern
    flex true
  link stroke-style, name <strokeStyle>
    like or
      like native-string
      like canvas-gradient
      like canvas-pattern
    flex true

  task create-linear-gradient, name <createLinearGradient>
    like canvas-gradient

    take x0
    take y0
    take x1
    take y1

  task create-pattern, name <createPattern>
    like or
      like canvas-pattern
      like native-null

    take image
    take repetition

  task create-radial-gradient, name <createRadialGradient>
    like canvas-gradient

    take x0
    take y0
    take r0
    take x1
    take y1
    take r1

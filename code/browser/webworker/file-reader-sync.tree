
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find blob

load @cluesurf/bind/code/javascript/es5
  find array-buffer

form file-reader-sync, name <FileReaderSync>
  task read-as-array-buffer, name <readAsArrayBuffer>
    like array-buffer

    take blob

  task read-as-binary-string, name <readAsBinaryString>
    like native-string

    take blob

  task read-as-data-url, name <readAsDataURL>
    like native-string

    take blob

  task read-as-text, name <readAsText>
    like native-string

    take blob
    take encoding, like maybe, like native-string

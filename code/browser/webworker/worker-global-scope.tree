
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find error-event
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find promise-rejection-event
  find window-or-worker-global-scope
  find worker-global-scope-event-map
  find worker-location
  find worker-navigator

form worker-global-scope, name <WorkerGlobalScope>
  base event-target
  base window-or-worker-global-scope

  link location, name <location>
    like worker-location
  link navigator, name <navigator>
    like worker-navigator
  link onerror, name <onerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onlanguagechange, name <onlanguagechange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onoffline, name <onoffline>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link ononline, name <ononline>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onrejectionhandled, name <onrejectionhandled>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onunhandledrejection, name <onunhandledrejection>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link self, name <self>
    like and
      like worker-global-scope
      like global-this

  task import-scripts, name <importScripts>
    like native-void

    take urls
      like array
        like native-string
      rest true

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like worker-global-scope-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like worker-global-scope-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

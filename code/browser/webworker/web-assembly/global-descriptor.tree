
load @cluesurf/bind/code/browser/dom/global-descriptor
  find global-descriptor

load @cluesurf/bind/code/browser/webworker/value-type
  find value-type

load @cluesurf/bind/code/javascript/native
  find native-boolean

form global-descriptor, name <GlobalDescriptor>
  link mutable, name <mutable>
    like native-boolean
    lock false
  link value, name <value>
    like value-type
    lock false


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-void

load @cluesurf/bind/code/javascript/es5
  find function

load @cluesurf/bind/code/browser/dom/table
  find table

form table, name <Table>
  link length, name <length>
    like native-number

  task get, name <get>
    like or
      like function
      like native-null

    take index

  task grow, name <grow>
    like native-number

    take delta

  task set, name <set>
    like native-void

    take index
    take value


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number

load @cluesurf/bind/code/browser/dom/memory-descriptor
  find memory-descriptor

form memory-descriptor, name <MemoryDescriptor>
  link initial, name <initial>
    like native-number
    flex true
  link maximum, name <maximum>
    like native-number
    flex true
  link shared, name <shared>
    like native-boolean
    flex true


load @cluesurf/bind/code/browser/webworker
  find instance
  find module

load @cluesurf/bind/code/browser/dom/web-assembly-instantiated-source
  find web-assembly-instantiated-source

form web-assembly-instantiated-source, name <WebAssemblyInstantiatedSource>
  link instance, name <instance>
    like instance
    flex true
  link module, name <module>
    like module
    flex true


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find import-export-kind

load @cluesurf/bind/code/browser/dom/module-export-descriptor
  find module-export-descriptor

form module-export-descriptor, name <ModuleExportDescriptor>
  link kind, name <kind>
    like import-export-kind
    flex true
  link name, name <name>
    like native-string
    flex true

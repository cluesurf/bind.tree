
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find message-event
  find shared-worker-global-scope-event-map
  find worker-global-scope

form shared-worker-global-scope, name <SharedWorkerGlobalScope>
  base worker-global-scope

  link name, name <name>
    like native-string
  link onconnect, name <onconnect>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task close, name <close>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like shared-worker-global-scope-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like shared-worker-global-scope-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

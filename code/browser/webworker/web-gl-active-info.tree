
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find g-lenum
  find g-lint

load @cluesurf/bind/code/browser/dom/web-gl-active-info
  find web-gl-active-info

form web-gl-active-info, name <WebGLActiveInfo>
  link name, name <name>
    like native-string
  link size, name <size>
    like g-lint
  link type, name <type>
    like g-lenum

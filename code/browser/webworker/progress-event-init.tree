
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number

load @cluesurf/bind/code/browser/webworker
  find event-init

load @cluesurf/bind/code/browser/dom/progress-event-init
  find progress-event-init

form progress-event-init, name <ProgressEventInit>
  base event-init

  link length-computable, name <lengthComputable>
    like native-boolean
    flex true
  link loaded, name <loaded>
    like native-number
    flex true
  link total, name <total>
    like native-number
    flex true

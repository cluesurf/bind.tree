
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find extendable-event-init
  find notification

form notification-event-init, name <NotificationEventInit>
  base extendable-event-init

  link action, name <action>
    like native-string
    flex true
  link notification, name <notification>
    like notification
    flex true

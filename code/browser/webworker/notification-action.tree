
load @cluesurf/bind/code/browser/dom/notification-action
  find notification-action

load @cluesurf/bind/code/javascript/native
  find native-string

form notification-action, name <NotificationAction>
  link action, name <action>
    like native-string
    lock false
  link icon, name <icon>
    like native-string
    lock false
  link title, name <title>
    like native-string
    lock false

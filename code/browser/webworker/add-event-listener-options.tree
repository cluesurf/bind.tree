
load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/webworker
  find event-listener-options

load @cluesurf/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

form add-event-listener-options, name <AddEventListenerOptions>
  base event-listener-options

  link once, name <once>
    like native-boolean
    flex true
  link passive, name <passive>
    like native-boolean
    flex true

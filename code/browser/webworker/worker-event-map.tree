
load @cluesurf/bind/code/browser/webworker
  find abstract-worker-event-map
  find message-event

load @cluesurf/bind/code/browser/dom/worker-event-map
  find worker-event-map

form worker-event-map, name <WorkerEventMap>
  base abstract-worker-event-map

  link message, name <message>
    like message-event
    flex true
  link messageerror, name <messageerror>
    like message-event
    flex true

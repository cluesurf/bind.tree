
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/webworker
  find file

load @cluesurf/bind/code/browser/dom/iterable/file-list
  find file-list

form file-list, name <FileList>
  link length, name <length>
    like native-number

  task item, name <item>
    like or
      like file
      like native-null

    take index

  mesh index
    like file

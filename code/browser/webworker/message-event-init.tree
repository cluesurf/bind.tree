
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/webworker
  find event-init
  find message-event-source
  find message-port

load @cluesurf/bind/code/browser/dom/message-event-init
  find message-event-init

form message-event-init, name <MessageEventInit>
  base event-init

  head t
    fall any

  link data, name <data>
    like t
    flex true
  link last-event-id, name <lastEventId>
    like native-string
    flex true
  link origin, name <origin>
    like native-string
    flex true
  link ports, name <ports>
    like array
      like message-port
    flex true
  link source, name <source>
    like or
      like message-event-source
      like native-null
    flex true

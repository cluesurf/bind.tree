
load @cluesurf/bind/code/browser/webworker/blob
  find blob

load @cluesurf/bind/code/browser/webworker/buffer-source
  find buffer-source

load @cluesurf/bind/code/javascript/native
  find native-string

form blob-part, name <BlobPart>
  like or
    like buffer-source
    like blob
    like native-string
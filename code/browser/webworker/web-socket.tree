
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find binary-type
  find blob
  find close-event
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find message-event
  find web-socket-event-map

load @cluesurf/bind/code/javascript/es5
  find array-buffer-like
  find array-buffer-view

load @cluesurf/bind/code/browser/dom/web-socket
  find web-socket

form web-socket, name <WebSocket>
  base event-target

  link binary-type, name <binaryType>
    like binary-type
    flex true
  link buffered-amount, name <bufferedAmount>
    like native-number
  link extensions, name <extensions>
    like native-string
  link onclose, name <onclose>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onerror, name <onerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onmessage, name <onmessage>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onopen, name <onopen>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link protocol, name <protocol>
    like native-string
  link ready-state, name <readyState>
    like native-number
  link url, name <url>
    like native-string
  link closed, name <CLOSED>
    like native-number
  link closing, name <CLOSING>
    like native-number
  link connecting, name <CONNECTING>
    like native-number
  link open, name <OPEN>
    like native-number

  task close, name <close>
    like native-void

    take code, like maybe, like native-number
    take reason, like maybe, like native-string

  task send, name <send>
    like native-void

    take data

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like web-socket-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like web-socket-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

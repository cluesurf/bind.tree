
load @cluesurf/bind/code/browser/dom/canvas-shadow-styles
  find canvas-shadow-styles

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form canvas-shadow-styles, name <CanvasShadowStyles>
  link shadow-blur, name <shadowBlur>
    like native-number
    lock false
  link shadow-color, name <shadowColor>
    like native-string
    lock false
  link shadow-offset-x, name <shadowOffsetX>
    like native-number
    lock false
  link shadow-offset-y, name <shadowOffsetY>
    like native-number
    lock false

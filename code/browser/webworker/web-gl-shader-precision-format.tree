
load @cluesurf/bind/code/browser/webworker
  find g-lint

load @cluesurf/bind/code/browser/dom/web-gl-shader-precision-format
  find web-gl-shader-precision-format

form web-gl-shader-precision-format, name <WebGLShaderPrecisionFormat>
  link precision, name <precision>
    like g-lint
  link range-max, name <rangeMax>
    like g-lint
  link range-min, name <rangeMin>
    like g-lint

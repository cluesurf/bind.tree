
load @cluesurf/bind/code/browser/webworker
  find algorithm

load @cluesurf/bind/code/javascript/es5
  find uint8-array

form dh-import-key-params, name <DhImportKeyParams>
  base algorithm

  link generator, name <generator>
    like uint8-array
    flex true
  link prime, name <prime>
    like uint8-array
    flex true

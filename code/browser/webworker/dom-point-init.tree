
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom/dom-point-init
  find dom-point-init

form dom-point-init, name <DOMPointInit>
  link w, name <w>
    like native-number
    flex true
  link x, name <x>
    like native-number
    flex true
  link y, name <y>
    like native-number
    flex true
  link z, name <z>
    like native-number
    flex true

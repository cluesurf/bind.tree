
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find idb-open-db-request

load @cluesurf/bind/code/browser/dom/idb-factory
  find idb-factory

form idb-factory, name <IDBFactory>
  task cmp, name <cmp>
    like native-number

    take first
    take second

  task delete-database, name <deleteDatabase>
    like idb-open-db-request

    take name

  task open, name <open>
    like idb-open-db-request

    take name
    take version, like maybe, like native-number

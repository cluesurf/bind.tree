
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find event

load @cluesurf/bind/code/browser/dom/web-gl-context-event
  find web-gl-context-event

form web-gl-context-event, name <WebGLContextEvent>
  base event

  link status-message, name <statusMessage>
    like native-string

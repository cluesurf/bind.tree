
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/webworker
  find buffer-source

load @cluesurf/bind/code/browser/dom/push-subscription-options-init
  find push-subscription-options-init

form push-subscription-options-init, name <PushSubscriptionOptionsInit>
  link application-server-key, name <applicationServerKey>
    like or
      like buffer-source
      like native-string
      like native-null
    flex true
  link user-visible-only, name <userVisibleOnly>
    like native-boolean
    flex true

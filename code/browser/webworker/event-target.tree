
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object

load @cluesurf/bind/code/browser/dom/event-target
  find event-target

form event-target, name <EventTarget>
  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task dispatch-event, name <dispatchEvent>
    like native-boolean

    take event

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take callback
    take options
      like maybe
        like or
          like event-listener-options
          like native-boolean

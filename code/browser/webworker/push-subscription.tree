
load @cluesurf/bind/code/browser/dom/push-subscription
  find push-subscription

load @cluesurf/bind/code/browser/webworker/push-encryption-key-name
  find push-encryption-key-name

load @cluesurf/bind/code/browser/webworker/push-subscription-json
  find push-subscription-json

load @cluesurf/bind/code/browser/webworker/push-subscription-options
  find push-subscription-options

load @cluesurf/bind/code/javascript/es5/array-buffer
  find array-buffer

load @cluesurf/bind/code/javascript/es5/promise
  find promise

load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form push-subscription, name <PushSubscription>
  link endpoint, name <endpoint>
    like native-string
  link expiration-time, name <expirationTime>
    like or
      like native-number
      like native-null
  link options, name <options>
    like push-subscription-options

  task get-key, name <getKey>
    take name, like push-encryption-key-name
    like or
      like array-buffer
      like native-null

  task to-json, name <toJSON>
    like push-subscription-json

  task unsubscribe, name <unsubscribe>
    like promise
      like native-boolean


load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom/idb-index-parameters
  find idb-index-parameters

form idb-index-parameters, name <IDBIndexParameters>
  link multi-entry, name <multiEntry>
    like native-boolean
    flex true
  link unique, name <unique>
    like native-boolean
    flex true

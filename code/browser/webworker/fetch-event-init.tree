
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find extendable-event-init
  find request

load @cluesurf/bind/code/javascript/es5
  find promise

form fetch-event-init, name <FetchEventInit>
  base extendable-event-init

  link client-id, name <clientId>
    like native-string
    flex true
  link preload-response, name <preloadResponse>
    like promise
      like any
    flex true
  link replaces-client-id, name <replacesClientId>
    like native-string
    flex true
  link request, name <request>
    like request
    flex true
  link resulting-client-id, name <resultingClientId>
    like native-string
    flex true

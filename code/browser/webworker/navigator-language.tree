
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es5
  find readonly-array

load @cluesurf/bind/code/browser/dom/navigator-language
  find navigator-language

form navigator-language, name <NavigatorLanguage>
  link language, name <language>
    like native-string
  link languages, name <languages>
    like readonly-array
      like native-string

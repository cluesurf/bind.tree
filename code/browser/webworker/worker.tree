
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find abstract-worker
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find message-event
  find post-message-options
  find transferable
  find worker-event-map

load @cluesurf/bind/code/browser/dom/worker
  find worker

form worker, name <Worker>
  base event-target
  base abstract-worker

  link onmessage, name <onmessage>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onmessageerror, name <onmessageerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task post-message, name <postMessage>
    like native-void

    take message
    take transfer

  task post-message, name <postMessage>
    like native-void

    take message
    take options, like maybe, like post-message-options

  task terminate, name <terminate>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like worker-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like worker-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-undefined
  find native-void

load @cluesurf/bind/code/javascript/es5
  find promise

load @cluesurf/bind/code/browser/dom/writable-stream-default-writer
  find writable-stream-default-writer

form writable-stream-default-writer, name <WritableStreamDefaultWriter>
  head w
    fall any

  link closed, name <closed>
    like promise
      like native-undefined
  link desired-size, name <desiredSize>
    like or
      like native-number
      like native-null
  link ready, name <ready>
    like promise
      like native-undefined

  task abort, name <abort>
    like promise
      like native-void

    take reason, like maybe, like any

  task close, name <close>
    like promise
      like native-void

  task release-lock, name <releaseLock>
    like native-void

  task write, name <write>
    like promise
      like native-void

    take chunk

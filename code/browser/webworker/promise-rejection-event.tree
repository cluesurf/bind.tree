
load @cluesurf/bind/code/browser/webworker
  find event

load @cluesurf/bind/code/javascript/es5
  find promise

load @cluesurf/bind/code/browser/dom/promise-rejection-event
  find promise-rejection-event

form promise-rejection-event, name <PromiseRejectionEvent>
  base event

  link promise, name <promise>
    like promise
      like any
  link reason, name <reason>
    like any

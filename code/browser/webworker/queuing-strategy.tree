
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/webworker
  find queuing-strategy-size

load @cluesurf/bind/code/browser/dom/queuing-strategy
  find queuing-strategy

form queuing-strategy, name <QueuingStrategy>
  head t
    fall any

  link high-water-mark, name <highWaterMark>
    like native-number
    flex true
  link size, name <size>
    like queuing-strategy-size
      like t
    flex true

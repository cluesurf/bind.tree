
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-void

load @cluesurf/bind/code/browser/dom/readable-stream-default-controller
  find readable-stream-default-controller

form readable-stream-default-controller, name <ReadableStreamDefaultController>
  head r
    fall any

  link desired-size, name <desiredSize>
    like or
      like native-number
      like native-null

  task close, name <close>
    like native-void

  task enqueue, name <enqueue>
    like native-void

    take chunk

  task error, name <error>
    like native-void

    take e, like maybe, like any

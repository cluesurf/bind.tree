
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string

load @cluesurf/bind/code/browser/dom/performance-observer-init
  find performance-observer-init

form performance-observer-init, name <PerformanceObserverInit>
  link buffered, name <buffered>
    like native-boolean
    flex true
  link entry-types, name <entryTypes>
    like array
      like native-string
    flex true
  link type, name <type>
    like native-string
    flex true

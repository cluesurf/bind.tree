
load @cluesurf/bind/code/javascript/native
  find native-undefined

load @cluesurf/bind/code/browser/webworker
  find transformer-flush-callback
  find transformer-start-callback
  find transformer-transform-callback

load @cluesurf/bind/code/browser/dom/transformer
  find transformer

form transformer, name <Transformer>
  head i
    fall any
  head o
    fall any

  link flush, name <flush>
    like transformer-flush-callback
      like o
    flex true
  link readable-type, name <readableType>
    like native-undefined
    flex true
  link start, name <start>
    like transformer-start-callback
      like o
    flex true
  link transform, name <transform>
    like transformer-transform-callback
      like i
      like o
    flex true
  link writable-type, name <writableType>
    like native-undefined
    flex true

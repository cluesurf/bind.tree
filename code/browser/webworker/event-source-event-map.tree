
load @cluesurf/bind/code/browser/webworker
  find event
  find message-event

load @cluesurf/bind/code/browser/dom/event-source-event-map
  find event-source-event-map

form event-source-event-map, name <EventSourceEventMap>
  link error, name <error>
    like event
    flex true
  link message, name <message>
    like message-event
    flex true
  link open, name <open>
    like event
    flex true

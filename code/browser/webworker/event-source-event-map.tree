
load @cluesurf/bind/code/browser/dom/event-source-event-map
  find event-source-event-map

load @cluesurf/bind/code/browser/webworker/event
  find event

load @cluesurf/bind/code/browser/webworker/message-event
  find message-event

form event-source-event-map, name <EventSourceEventMap>
  link error, name <error>
    like event
    lock false
  link message, name <message>
    like message-event
    lock false
  link open, name <open>
    like event
    lock false


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find abstract-worker
  find abstract-worker-event-map
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find message-port

load @cluesurf/bind/code/browser/dom/shared-worker
  find shared-worker

form shared-worker, name <SharedWorker>
  base event-target
  base abstract-worker

  link port, name <port>
    like message-port

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like abstract-worker-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like abstract-worker-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string
  find native-undefined
  find native-void

load @cluesurf/bind/code/browser/webworker
  find client
  find client-query-options
  find window-client

load @cluesurf/bind/code/javascript/es5
  find promise
  find readonly-array

form clients, name <Clients>
  task claim, name <claim>
    like promise
      like native-void

  task get, name <get>
    like promise
      like or
        like client
        like native-undefined

    take id

  task match-all, name <matchAll>
    like promise
      like readonly-array
        like test
          fork roll
            like index
              like t
              text <type>
            text <window>
            hook true
              like window-client
            hook false
              like client

    head t
      base client-query-options

    take options, like maybe, like t

  task open-window, name <openWindow>
    like promise
      like or
        like window-client
        like native-null

    take url

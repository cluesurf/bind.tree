
load @cluesurf/bind/code/browser/dom/message-port
  find message-port

load @cluesurf/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @cluesurf/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @cluesurf/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @cluesurf/bind/code/browser/webworker/event-target
  find event-target

load @cluesurf/bind/code/browser/webworker/message-event
  find message-event

load @cluesurf/bind/code/browser/webworker/message-port-event-map
  find message-port-event-map

load @cluesurf/bind/code/browser/webworker/post-message-options
  find post-message-options

load @cluesurf/bind/code/browser/webworker/transferable
  find transferable

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-array

load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/native
  find native-void

form message-port, name <MessagePort>
  base event-target

  link onmessage, name <onmessage>
    like or
      like task
        take this, like message-port
        take ev, like message-event
        like native-any
      like native-null
    lock false
  link onmessageerror, name <onmessageerror>
    like or
      like task
        take this, like message-port
        take ev, like message-event
        like native-any
      like native-null
    lock false

  task close, name <close>
    like native-void

  task post-message, name <postMessage>
    take message, like native-any
    take transfer
      like native-array
        like transferable
    like native-void

  task post-message, name <postMessage>
    take message, like native-any
    take options, like maybe
      like post-message-options
    like native-void

  task start, name <start>
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like message-port-event-map
    take type, like k
    take listener
      like task
        take this, like message-port
        take ev
          like index
            like message-port-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like message-port-event-map
    take type, like k
    take listener
      like task
        take this, like message-port
        take ev
          like index
            like message-port-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

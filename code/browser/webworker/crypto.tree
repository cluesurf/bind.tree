
load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/webworker
  find subtle-crypto

load @cluesurf/bind/code/javascript/es5
  find data-view
  find float32-array
  find float64-array
  find int16-array
  find int32-array
  find int8-array
  find uint16-array
  find uint32-array
  find uint8-array
  find uint8-clamped-array

load @cluesurf/bind/code/browser/dom/crypto
  find crypto

form crypto, name <Crypto>
  link subtle, name <subtle>
    like subtle-crypto

  task get-random-values, name <getRandomValues>
    like t

    head t
      base or
        like int8-array
        like int16-array
        like int32-array
        like uint8-array
        like uint16-array
        like uint32-array
        like uint8-clamped-array
        like float32-array
        like float64-array
        like data-view
        like native-null

    take array

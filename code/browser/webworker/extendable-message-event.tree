
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/webworker
  find client
  find extendable-event
  find message-port
  find service-worker

load @cluesurf/bind/code/javascript/es5
  find readonly-array

form extendable-message-event, name <ExtendableMessageEvent>
  base extendable-event

  link data, name <data>
    like any
  link last-event-id, name <lastEventId>
    like native-string
  link origin, name <origin>
    like native-string
  link ports, name <ports>
    like readonly-array
      like message-port
  link source, name <source>
    like or
      like client
      like service-worker
      like message-port
      like native-null


load @cluesurf/bind/code/browser/webworker/client
  find client

load @cluesurf/bind/code/browser/webworker/extendable-event
  find extendable-event

load @cluesurf/bind/code/browser/webworker/message-port
  find message-port

load @cluesurf/bind/code/browser/webworker/service-worker
  find service-worker

load @cluesurf/bind/code/javascript/es5/readonly-array
  find readonly-array

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/native
  find native-string

form extendable-message-event, name <ExtendableMessageEvent>
  base extendable-event

  link data, name <data>
    like native-any
  link last-event-id, name <lastEventId>
    like native-string
  link origin, name <origin>
    like native-string
  link ports, name <ports>
    like readonly-array
      like message-port
  link source, name <source>
    like or
      like client
      like service-worker
      like message-port
      like native-null

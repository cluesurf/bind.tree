
load @cluesurf/bind/code/browser/webworker
  find readable-stream
  find writable-stream

load @cluesurf/bind/code/browser/dom/readable-writable-pair
  find readable-writable-pair

form readable-writable-pair, name <ReadableWritablePair>
  head r
    fall any
  head w
    fall any

  link readable, name <readable>
    like readable-stream
      like r
    flex true
  link writable, name <writable>
    like writable-stream
      like w
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-void

load @cluesurf/bind/code/browser/webworker
  find canvas-image-source

load @cluesurf/bind/code/browser/dom/canvas-draw-image
  find canvas-draw-image

form canvas-draw-image, name <CanvasDrawImage>
  task draw-image, name <drawImage>
    like native-void

    take image
    take dx
    take dy

  task draw-image, name <drawImage>
    like native-void

    take image
    take dx
    take dy
    take dw
    take dh

  task draw-image, name <drawImage>
    like native-void

    take image
    take sx
    take sy
    take sw
    take sh
    take dx
    take dy
    take dw
    take dh

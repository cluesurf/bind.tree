
load @cluesurf/bind/code/browser/dom/pbkdf2-params
  find pbkdf2-params

load @cluesurf/bind/code/browser/webworker/algorithm
  find algorithm

load @cluesurf/bind/code/browser/webworker/hash-algorithm-identifier
  find hash-algorithm-identifier

load @cluesurf/bind/code/javascript/es5/array-buffer
  find array-buffer

load @cluesurf/bind/code/javascript/es5/data-view
  find data-view

load @cluesurf/bind/code/javascript/es5/float32-array
  find float32-array

load @cluesurf/bind/code/javascript/es5/float64-array
  find float64-array

load @cluesurf/bind/code/javascript/es5/int16-array
  find int16-array

load @cluesurf/bind/code/javascript/es5/int32-array
  find int32-array

load @cluesurf/bind/code/javascript/es5/int8-array
  find int8-array

load @cluesurf/bind/code/javascript/es5/uint16-array
  find uint16-array

load @cluesurf/bind/code/javascript/es5/uint32-array
  find uint32-array

load @cluesurf/bind/code/javascript/es5/uint8-array
  find uint8-array

load @cluesurf/bind/code/javascript/es5/uint8-clamped-array
  find uint8-clamped-array

load @cluesurf/bind/code/javascript/native
  find native-number

form pbkdf2-params, name <Pbkdf2Params>
  base algorithm

  link hash, name <hash>
    like hash-algorithm-identifier
    lock false
  link iterations, name <iterations>
    like native-number
    lock false
  link salt, name <salt>
    like or
      like int8-array
      like int16-array
      like int32-array
      like uint8-array
      like uint16-array
      like uint32-array
      like uint8-clamped-array
      like float32-array
      like float64-array
      like data-view
      like array-buffer
    lock false

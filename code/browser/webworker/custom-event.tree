
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find event

load @cluesurf/bind/code/browser/dom/custom-event
  find custom-event

form custom-event, name <CustomEvent>
  base event

  head t
    fall any

  link detail, name <detail>
    like t

  task init-custom-event, name <initCustomEvent>
    like native-void

    take type-arg
    take can-bubble-arg
    take cancelable-arg
    take detail-arg

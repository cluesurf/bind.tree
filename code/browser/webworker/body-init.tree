
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find blob
  find buffer-source
  find form-data
  find readable-stream
  find url-search-params

load @cluesurf/bind/code/javascript/es5
  find uint8-array

form body-init, name <BodyInit>
  like or
    like blob
    like buffer-source
    like form-data
    like url-search-params
    like readable-stream
      like uint8-array
    like native-string

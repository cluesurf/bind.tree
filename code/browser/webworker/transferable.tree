
load @cluesurf/bind/code/browser/webworker/image-bitmap
  find image-bitmap

load @cluesurf/bind/code/browser/webworker/message-port
  find message-port

load @cluesurf/bind/code/browser/webworker/offscreen-canvas
  find offscreen-canvas

load @cluesurf/bind/code/javascript/es5/array-buffer
  find array-buffer

form transferable, name <Transferable>
  like or
    like array-buffer
    like message-port
    like image-bitmap
    like offscreen-canvas
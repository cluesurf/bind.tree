
load @cluesurf/bind/code/browser/webworker
  find image-bitmap
  find message-port
  find offscreen-canvas

load @cluesurf/bind/code/javascript/es5
  find array-buffer

form transferable, name <Transferable>
  like or
    like array-buffer
    like message-port
    like image-bitmap
    like offscreen-canvas

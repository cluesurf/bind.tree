
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find dom-exception
  find dom-string-list
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find idb-database
  find idb-object-store
  find idb-transaction-event-map
  find idb-transaction-mode

load @cluesurf/bind/code/browser/dom/idb-transaction
  find idb-transaction

form idb-transaction, name <IDBTransaction>
  base event-target

  link db, name <db>
    like idb-database
  link error, name <error>
    like dom-exception
  link mode, name <mode>
    like idb-transaction-mode
  link object-store-names, name <objectStoreNames>
    like dom-string-list
  link onabort, name <onabort>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link oncomplete, name <oncomplete>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onerror, name <onerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task abort, name <abort>
    like native-void

  task object-store, name <objectStore>
    like idb-object-store

    take name

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like idb-transaction-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like idb-transaction-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

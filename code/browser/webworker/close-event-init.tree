
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find event-init

load @cluesurf/bind/code/browser/dom/close-event-init
  find close-event-init

form close-event-init, name <CloseEventInit>
  base event-init

  link code, name <code>
    like native-number
    flex true
  link reason, name <reason>
    like native-string
    flex true
  link was-clean, name <wasClean>
    like native-boolean
    flex true

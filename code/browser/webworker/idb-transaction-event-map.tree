
load @cluesurf/bind/code/browser/webworker
  find event

load @cluesurf/bind/code/browser/dom/idb-transaction-event-map
  find idb-transaction-event-map

form idb-transaction-event-map, name <IDBTransactionEventMap>
  link abort, name <abort>
    like event
    flex true
  link complete, name <complete>
    like event
    flex true
  link error, name <error>
    like event
    flex true

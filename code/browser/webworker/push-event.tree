
load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/browser/webworker
  find extendable-event
  find push-message-data

form push-event, name <PushEvent>
  base extendable-event

  link data, name <data>
    like or
      like push-message-data
      like native-null

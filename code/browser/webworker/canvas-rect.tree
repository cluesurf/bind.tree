
load @cluesurf/bind/code/browser/dom/canvas-rect
  find canvas-rect

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-void

form canvas-rect, name <CanvasRect>
  task clear-rect, name <clearRect>
    take x, like native-number
    take y, like native-number
    take w, like native-number
    take h, like native-number
    like native-void

  task fill-rect, name <fillRect>
    take x, like native-number
    take y, like native-number
    take w, like native-number
    take h, like native-number
    like native-void

  task stroke-rect, name <strokeRect>
    take x, like native-number
    take y, like native-number
    take w, like native-number
    take h, like native-number
    like native-void

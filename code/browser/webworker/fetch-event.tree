
load @cluesurf/bind/code/javascript/native
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find extendable-event
  find request
  find response

load @cluesurf/bind/code/javascript/es5
  find promise

form fetch-event, name <FetchEvent>
  base extendable-event

  link client-id, name <clientId>
    like native-string
  link preload-response, name <preloadResponse>
    like promise
      like any
  link request, name <request>
    like request
  link resulting-client-id, name <resultingClientId>
    like native-string

  task respond-with, name <respondWith>
    like native-void

    take r

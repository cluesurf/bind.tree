
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string

load @cluesurf/bind/code/browser/webworker
  find extendable-event

form sync-event, name <SyncEvent>
  base extendable-event

  link last-chance, name <lastChance>
    like native-boolean
  link tag, name <tag>
    like native-string

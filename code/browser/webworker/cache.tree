
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-undefined
  find native-void

load @cluesurf/bind/code/browser/webworker
  find cache-query-options
  find request
  find request-info
  find response

load @cluesurf/bind/code/javascript/es5
  find promise
  find readonly-array

load @cluesurf/bind/code/browser/dom/iterable/cache
  find cache

form cache, name <Cache>
  task add, name <add>
    like promise
      like native-void

    take request

  task add-all, name <addAll>
    like promise
      like native-void

    take requests

  task delete, name <delete>
    like promise
      like native-boolean

    take request
    take options, like maybe, like cache-query-options

  task keys, name <keys>
    like promise
      like readonly-array
        like request

    take request, like maybe, like request-info
    take options, like maybe, like cache-query-options

  task match, name <match>
    like promise
      like or
        like response
        like native-undefined

    take request
    take options, like maybe, like cache-query-options

  task match-all, name <matchAll>
    like promise
      like readonly-array
        like response

    take request, like maybe, like request-info
    take options, like maybe, like cache-query-options

  task put, name <put>
    like promise
      like native-void

    take request
    take response

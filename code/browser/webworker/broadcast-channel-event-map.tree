
load @cluesurf/bind/code/browser/webworker
  find message-event

load @cluesurf/bind/code/browser/dom/broadcast-channel-event-map
  find broadcast-channel-event-map

form broadcast-channel-event-map, name <BroadcastChannelEventMap>
  link message, name <message>
    like message-event
    flex true
  link messageerror, name <messageerror>
    like message-event
    flex true

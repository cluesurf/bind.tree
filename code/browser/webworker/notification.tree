
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find notification-action
  find notification-direction
  find notification-event-map

load @cluesurf/bind/code/javascript/es5
  find readonly-array

load @cluesurf/bind/code/browser/dom/notification
  find notification

form notification, name <Notification>
  base event-target

  link actions, name <actions>
    like readonly-array
      like notification-action
  link badge, name <badge>
    like native-string
  link body, name <body>
    like native-string
  link data, name <data>
    like any
  link dir, name <dir>
    like notification-direction
  link icon, name <icon>
    like native-string
  link image, name <image>
    like native-string
  link lang, name <lang>
    like native-string
  link onclick, name <onclick>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onclose, name <onclose>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onerror, name <onerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onshow, name <onshow>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link renotify, name <renotify>
    like native-boolean
  link require-interaction, name <requireInteraction>
    like native-boolean
  link silent, name <silent>
    like native-boolean
  link tag, name <tag>
    like native-string
  link timestamp, name <timestamp>
    like native-number
  link title, name <title>
    like native-string
  link vibrate, name <vibrate>
    like readonly-array
      like native-number

  task close, name <close>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like notification-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like notification-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

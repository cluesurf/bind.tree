
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string
  find native-void

load @cluesurf/bind/code/javascript/es5
  find promise

form sync-manager, name <SyncManager>
  task get-tags, name <getTags>
    like promise
      like array
        like native-string

  task register, name <register>
    like promise
      like native-void

    take tag

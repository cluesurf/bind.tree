
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-undefined
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find message-event
  find registration-options
  find service-worker
  find service-worker-container-event-map
  find service-worker-registration
  find url

load @cluesurf/bind/code/javascript/es5
  find promise
  find readonly-array

load @cluesurf/bind/code/browser/dom/service-worker-container
  find service-worker-container

form service-worker-container, name <ServiceWorkerContainer>
  base event-target

  link controller, name <controller>
    like or
      like service-worker
      like native-null
  link oncontrollerchange, name <oncontrollerchange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onmessage, name <onmessage>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onmessageerror, name <onmessageerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link ready, name <ready>
    like promise
      like service-worker-registration

  task get-registration, name <getRegistration>
    like promise
      like or
        like service-worker-registration
        like native-undefined

    take client-url, like maybe, like native-string

  task get-registrations, name <getRegistrations>
    like promise
      like readonly-array
        like service-worker-registration

  task register, name <register>
    like promise
      like service-worker-registration

    take script-url
    take options, like maybe, like registration-options

  task start-messages, name <startMessages>
    like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like service-worker-container-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like service-worker-container-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

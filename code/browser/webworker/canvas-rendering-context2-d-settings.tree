
load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom/canvas-rendering-context2-d-settings
  find canvas-rendering-context2-d-settings

form canvas-rendering-context2-d-settings, name <CanvasRenderingContext2DSettings>
  link alpha, name <alpha>
    like native-boolean
    flex true
  link desynchronized, name <desynchronized>
    like native-boolean
    flex true

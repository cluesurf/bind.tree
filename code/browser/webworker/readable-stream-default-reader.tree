
load @cluesurf/bind/code/browser/dom/readable-stream-default-reader
  find readable-stream-default-reader

load @cluesurf/bind/code/browser/webworker/readable-stream-default-read-result
  find readable-stream-default-read-result

load @cluesurf/bind/code/browser/webworker/readable-stream-generic-reader
  find readable-stream-generic-reader

load @cluesurf/bind/code/javascript/es5/promise
  find promise

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-void

form readable-stream-default-reader, name <ReadableStreamDefaultReader>
  base readable-stream-generic-reader

  head r
    back native-any

  task read, name <read>
    like promise
      like readable-stream-default-read-result
        like r

  task release-lock, name <releaseLock>
    like native-void

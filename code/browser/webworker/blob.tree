
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find readable-stream

load @cluesurf/bind/code/javascript/es5
  find array-buffer
  find promise

load @cluesurf/bind/code/browser/dom/blob
  find blob

form blob, name <Blob>
  link size, name <size>
    like native-number
  link type, name <type>
    like native-string

  task array-buffer, name <arrayBuffer>
    like promise
      like array-buffer

  task slice, name <slice>
    like blob

    take start, like maybe, like native-number
    take end, like maybe, like native-number
    take content-type, like maybe, like native-string

  task stream, name <stream>
    like readable-stream

  task text, name <text>
    like promise
      like native-string

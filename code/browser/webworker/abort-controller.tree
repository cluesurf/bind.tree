
load @cluesurf/bind/code/javascript/native
  find native-void

load @cluesurf/bind/code/browser/webworker
  find abort-signal

load @cluesurf/bind/code/browser/dom/abort-controller
  find abort-controller

form abort-controller, name <AbortController>
  link signal, name <signal>
    like abort-signal

  task abort, name <abort>
    like native-void

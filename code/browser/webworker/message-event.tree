
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/webworker
  find event
  find message-event-source
  find message-port

load @cluesurf/bind/code/javascript/es5
  find readonly-array

load @cluesurf/bind/code/browser/dom/iterable/message-event
  find message-event

form message-event, name <MessageEvent>
  base event

  head t
    fall any

  link data, name <data>
    like t
  link last-event-id, name <lastEventId>
    like native-string
  link origin, name <origin>
    like native-string
  link ports, name <ports>
    like readonly-array
      like message-port
  link source, name <source>
    like or
      like message-event-source
      like native-null

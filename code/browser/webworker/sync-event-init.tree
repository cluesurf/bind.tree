
load @cluesurf/bind/code/browser/webworker/extendable-event-init
  find extendable-event-init

load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/native
  find native-string

form sync-event-init, name <SyncEventInit>
  base extendable-event-init

  link last-chance, name <lastChance>
    like native-boolean
    lock false
  link tag, name <tag>
    like native-string
    lock false


load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/webworker
  find storage-estimate

load @cluesurf/bind/code/javascript/es5
  find promise

load @cluesurf/bind/code/browser/dom/storage-manager
  find storage-manager

form storage-manager, name <StorageManager>
  task estimate, name <estimate>
    like promise
      like storage-estimate

  task persisted, name <persisted>
    like promise
      like native-boolean

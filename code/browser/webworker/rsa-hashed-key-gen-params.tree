
load @cluesurf/bind/code/browser/webworker
  find hash-algorithm-identifier
  find rsa-key-gen-params

load @cluesurf/bind/code/browser/dom/rsa-hashed-key-gen-params
  find rsa-hashed-key-gen-params

form rsa-hashed-key-gen-params, name <RsaHashedKeyGenParams>
  base rsa-key-gen-params

  link hash, name <hash>
    like hash-algorithm-identifier
    flex true

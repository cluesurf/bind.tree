
bear @cluesurf/bind/code/javascript/webworker/web-assembly/global
bear @cluesurf/bind/code/javascript/webworker/web-assembly/instance
bear @cluesurf/bind/code/javascript/webworker/web-assembly/memory
bear @cluesurf/bind/code/javascript/webworker/web-assembly/module
bear @cluesurf/bind/code/javascript/webworker/web-assembly/table
bear @cluesurf/bind/code/javascript/webworker/web-assembly/global-descriptor
bear @cluesurf/bind/code/javascript/webworker/web-assembly/memory-descriptor
bear @cluesurf/bind/code/javascript/webworker/web-assembly/module-export-descriptor
bear @cluesurf/bind/code/javascript/webworker/web-assembly/module-import-descriptor
bear @cluesurf/bind/code/javascript/webworker/web-assembly/table-descriptor
bear @cluesurf/bind/code/javascript/webworker/web-assembly/web-assembly-instantiated-source
bear @cluesurf/bind/code/javascript/webworker/web-assembly/import-export-kind
bear @cluesurf/bind/code/javascript/webworker/web-assembly/table-kind
bear @cluesurf/bind/code/javascript/webworker/web-assembly/value-type
bear @cluesurf/bind/code/javascript/webworker/web-assembly/export-value
bear @cluesurf/bind/code/javascript/webworker/web-assembly/exports
bear @cluesurf/bind/code/javascript/webworker/web-assembly/import-value
bear @cluesurf/bind/code/javascript/webworker/web-assembly/module-imports
bear @cluesurf/bind/code/javascript/webworker/web-assembly/imports

load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-string

load @cluesurf/bind/code/browser/webworker
  find buffer-source
  find global
  find global-descriptor
  find imports
  find instance
  find memory
  find memory-descriptor
  find module
  find module-export-descriptor
  find module-import-descriptor
  find response
  find table
  find table-descriptor
  find web-assembly-instantiated-source

load @cluesurf/bind/code/javascript/es5
  find array-buffer
  find promise
  find promise-like

host global, name <Global>
  like form
    link prototype, name <prototype>
      like global
      flex true
    hook make
      like global

      take descriptor
      take v, like maybe, like any

host instance, name <Instance>
  like form
    link prototype, name <prototype>
      like instance
      flex true
    hook make
      like instance

      take module
      take import-object, like maybe, like imports

host memory, name <Memory>
  like form
    link prototype, name <prototype>
      like memory
      flex true
    hook make
      like memory

      take descriptor

host module, name <Module>
  like form
    link prototype, name <prototype>
      like module
      flex true
    hook make
      like module

      take bytes

    task custom-sections, name <customSections>
      like array
        like array-buffer

      take module-object
      take section-name

    task exports, name <exports>
      like array
        like module-export-descriptor

      take module-object

    task imports, name <imports>
      like array
        like module-import-descriptor

      take module-object

host table, name <Table>
  like form
    link prototype, name <prototype>
      like table
      flex true
    hook make
      like table

      take descriptor

task compile, name <compile>
  like promise
    like module

  take bytes

task compile-streaming, name <compileStreaming>
  like promise
    like module

  take source

task instantiate, name <instantiate>
  like promise
    like web-assembly-instantiated-source

  take bytes
  take import-object, like maybe, like imports

task instantiate, name <instantiate>
  like promise
    like instance

  take module-object
  take import-object, like maybe, like imports

task instantiate-streaming, name <instantiateStreaming>
  like promise
    like web-assembly-instantiated-source

  take response
  take import-object, like maybe, like imports

task validate, name <validate>
  like native-boolean

  take bytes

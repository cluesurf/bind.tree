
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find blob

load @cluesurf/bind/code/javascript/es5
  find array-buffer

form push-message-data, name <PushMessageData>
  task array-buffer, name <arrayBuffer>
    like array-buffer

  task blob, name <blob>
    like blob

  task json, name <json>
    like any

  task text, name <text>
    like native-string


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/webworker
  find algorithm
  find hash-algorithm-identifier

load @cluesurf/bind/code/browser/dom/hmac-import-params
  find hmac-import-params

form hmac-import-params, name <HmacImportParams>
  base algorithm

  link hash, name <hash>
    like hash-algorithm-identifier
    flex true
  link length, name <length>
    like native-number
    flex true

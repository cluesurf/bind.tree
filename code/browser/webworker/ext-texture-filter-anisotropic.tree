
load @cluesurf/bind/code/browser/webworker
  find g-lenum

load @cluesurf/bind/code/browser/dom/ext-texture-filter-anisotropic
  find ext-texture-filter-anisotropic

form ext-texture-filter-anisotropic, name <EXT_texture_filter_anisotropic>
  link max-texture-max-anisotropy-ext, name <MAX_TEXTURE_MAX_ANISOTROPY_EXT>
    like g-lenum
  link texture-max-anisotropy-ext, name <TEXTURE_MAX_ANISOTROPY_EXT>
    like g-lenum

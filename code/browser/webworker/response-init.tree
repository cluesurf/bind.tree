
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find headers-init

load @cluesurf/bind/code/browser/dom/response-init
  find response-init

form response-init, name <ResponseInit>
  link headers, name <headers>
    like headers-init
    flex true
  link status, name <status>
    like native-number
    flex true
  link status-text, name <statusText>
    like native-string
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/dom/text-encoder-encode-into-result
  find text-encoder-encode-into-result

form text-encoder-encode-into-result, name <TextEncoderEncodeIntoResult>
  link read, name <read>
    like native-number
    flex true
  link written, name <written>
    like native-number
    flex true

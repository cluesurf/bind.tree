
load @cluesurf/bind/code/browser/webworker
  find web-gl-rendering-context-base
  find web-gl-rendering-context-overloads

load @cluesurf/bind/code/browser/dom/web-gl-rendering-context
  find web-gl-rendering-context

form web-gl-rendering-context, name <WebGLRenderingContext>
  base web-gl-rendering-context-base
  base web-gl-rendering-context-overloads

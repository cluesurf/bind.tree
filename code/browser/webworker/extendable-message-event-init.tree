
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-string

load @cluesurf/bind/code/browser/webworker
  find client
  find extendable-event-init
  find message-port
  find service-worker

form extendable-message-event-init, name <ExtendableMessageEventInit>
  base extendable-event-init

  link data, name <data>
    like any
    flex true
  link last-event-id, name <lastEventId>
    like native-string
    flex true
  link origin, name <origin>
    like native-string
    flex true
  link ports, name <ports>
    like array
      like message-port
    flex true
  link source, name <source>
    like or
      like client
      like service-worker
      like message-port
      like native-null
    flex true

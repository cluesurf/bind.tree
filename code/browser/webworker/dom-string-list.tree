
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom/iterable/dom-string-list
  find dom-string-list

form dom-string-list, name <DOMStringList>
  link length, name <length>
    like native-number

  task contains, name <contains>
    like native-boolean

    take string

  task item, name <item>
    like or
      like native-string
      like native-null

    take index

  mesh index
    like native-string


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number

load @cluesurf/bind/code/browser/webworker
  find blob
  find canvas-rendering-context2-d-settings
  find event-target
  find image-bitmap
  find image-bitmap-rendering-context
  find image-bitmap-rendering-context-settings
  find image-encode-options
  find offscreen-canvas-rendering-context2-d
  find offscreen-rendering-context
  find offscreen-rendering-context-id
  find web-gl-context-attributes
  find web-gl-rendering-context
  find web-gl2-rendering-context

load @cluesurf/bind/code/javascript/es5
  find promise

load @cluesurf/bind/code/browser/dom/offscreen-canvas
  find offscreen-canvas

form offscreen-canvas, name <OffscreenCanvas>
  base event-target

  link height, name <height>
    like native-number
    flex true
  link width, name <width>
    like native-number
    flex true

  task convert-to-blob, name <convertToBlob>
    like promise
      like blob

    take options, like maybe, like image-encode-options

  task get-context, name <getContext>
    like or
      like offscreen-canvas-rendering-context2-d
      like native-null

    take context-id
    take options, like maybe, like canvas-rendering-context2-d-settings

  task get-context, name <getContext>
    like or
      like image-bitmap-rendering-context
      like native-null

    take context-id
    take options, like maybe, like image-bitmap-rendering-context-settings

  task get-context, name <getContext>
    like or
      like web-gl-rendering-context
      like native-null

    take context-id
    take options, like maybe, like web-gl-context-attributes

  task get-context, name <getContext>
    like or
      like web-gl2-rendering-context
      like native-null

    take context-id
    take options, like maybe, like web-gl-context-attributes

  task get-context, name <getContext>
    like or
      like offscreen-rendering-context
      like native-null

    take context-id
    take options, like maybe, like any

  task transfer-to-image-bitmap, name <transferToImageBitmap>
    like image-bitmap


load @cluesurf/bind/code/browser/webworker
  find image-bitmap-rendering-context
  find offscreen-canvas-rendering-context2-d
  find web-gl-rendering-context
  find web-gl2-rendering-context

form offscreen-rendering-context, name <OffscreenRenderingContext>
  like or
    like offscreen-canvas-rendering-context2-d
    like image-bitmap-rendering-context
    like web-gl-rendering-context
    like web-gl2-rendering-context

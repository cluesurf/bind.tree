
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find client-types
  find frame-type
  find transferable

form client, name <Client>
  link frame-type, name <frameType>
    like frame-type
  link id, name <id>
    like native-string
  link type, name <type>
    like client-types
  link url, name <url>
    like native-string

  task post-message, name <postMessage>
    like native-void

    take message
    take transfer
      like maybe
        like array
          like transferable

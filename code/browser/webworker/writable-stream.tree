
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-void

load @cluesurf/bind/code/browser/webworker
  find writable-stream-default-writer

load @cluesurf/bind/code/javascript/es5
  find promise

load @cluesurf/bind/code/browser/dom/writable-stream
  find writable-stream

form writable-stream, name <WritableStream>
  head w
    fall any

  link locked, name <locked>
    like native-boolean

  task abort, name <abort>
    like promise
      like native-void

    take reason, like maybe, like any

  task get-writer, name <getWriter>
    like writable-stream-default-writer
      like w


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es5
  find record

load @cluesurf/bind/code/browser/dom/push-subscription-json
  find push-subscription-json

form push-subscription-json, name <PushSubscriptionJSON>
  link endpoint, name <endpoint>
    like native-string
    flex true
  link expiration-time, name <expirationTime>
    like or
      like native-number
      like native-null
    flex true
  link keys, name <keys>
    like record
      like native-string
      like native-string
    flex true

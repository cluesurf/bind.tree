
load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/webworker
  find permission-descriptor

form midi-permission-descriptor, name <MidiPermissionDescriptor>
  base permission-descriptor

  link name, name <name>
    text <midi>
    flex true
  link sysex, name <sysex>
    like native-boolean
    flex true

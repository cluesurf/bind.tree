
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/dom/canvas-compositing
  find canvas-compositing

form canvas-compositing, name <CanvasCompositing>
  link global-alpha, name <globalAlpha>
    like native-number
    flex true
  link global-composite-operation, name <globalCompositeOperation>
    like native-string
    flex true


load @cluesurf/bind/code/browser/webworker
  find key-algorithm

load @cluesurf/bind/code/javascript/es5
  find uint8-array

form dh-key-algorithm, name <DhKeyAlgorithm>
  base key-algorithm

  link generator, name <generator>
    like uint8-array
    flex true
  link prime, name <prime>
    like uint8-array
    flex true

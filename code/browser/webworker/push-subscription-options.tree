
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null

load @cluesurf/bind/code/javascript/es5
  find array-buffer

load @cluesurf/bind/code/browser/dom/push-subscription-options
  find push-subscription-options

form push-subscription-options, name <PushSubscriptionOptions>
  link application-server-key, name <applicationServerKey>
    like or
      like array-buffer
      like native-null
  link user-visible-only, name <userVisibleOnly>
    like native-boolean


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/webworker
  find algorithm

load @cluesurf/bind/code/javascript/es5
  find array-buffer
  find data-view
  find float32-array
  find float64-array
  find int16-array
  find int32-array
  find int8-array
  find uint16-array
  find uint32-array
  find uint8-array
  find uint8-clamped-array

load @cluesurf/bind/code/browser/dom/aes-gcm-params
  find aes-gcm-params

form aes-gcm-params, name <AesGcmParams>
  base algorithm

  link additional-data, name <additionalData>
    like or
      like int8-array
      like int16-array
      like int32-array
      like uint8-array
      like uint16-array
      like uint32-array
      like uint8-clamped-array
      like float32-array
      like float64-array
      like data-view
      like array-buffer
    flex true
  link iv, name <iv>
    like or
      like int8-array
      like int16-array
      like int32-array
      like uint8-array
      like uint16-array
      like uint32-array
      like uint8-clamped-array
      like float32-array
      like float64-array
      like data-view
      like array-buffer
    flex true
  link tag-length, name <tagLength>
    like native-number
    flex true

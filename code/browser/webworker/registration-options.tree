
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find service-worker-update-via-cache
  find worker-type

load @cluesurf/bind/code/browser/dom/registration-options
  find registration-options

form registration-options, name <RegistrationOptions>
  link scope, name <scope>
    like native-string
    flex true
  link type, name <type>
    like worker-type
    flex true
  link update-via-cache, name <updateViaCache>
    like service-worker-update-via-cache
    flex true

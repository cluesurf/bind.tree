
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find dom-string-list
  find event
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find idb-database-event-map
  find idb-object-store
  find idb-object-store-parameters
  find idb-transaction
  find idb-transaction-mode
  find idb-version-change-event

load @cluesurf/bind/code/browser/dom/iterable/idb-database
  find idb-database

form idb-database, name <IDBDatabase>
  base event-target

  link name, name <name>
    like native-string
  link object-store-names, name <objectStoreNames>
    like dom-string-list
  link onabort, name <onabort>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onclose, name <onclose>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onerror, name <onerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onversionchange, name <onversionchange>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link version, name <version>
    like native-number

  task close, name <close>
    like native-void

  task create-object-store, name <createObjectStore>
    like idb-object-store

    take name
    take options, like maybe, like idb-object-store-parameters

  task delete-object-store, name <deleteObjectStore>
    like native-void

    take name

  task transaction, name <transaction>
    like idb-transaction

    take store-names
    take mode, like maybe, like idb-transaction-mode

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like idb-database-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like idb-database-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

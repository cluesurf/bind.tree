
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find extendable-event
  find notification

form notification-event, name <NotificationEvent>
  base extendable-event

  link action, name <action>
    like native-string
  link notification, name <notification>
    like notification

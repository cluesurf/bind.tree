
load @cluesurf/bind/code/browser/webworker
  find crypto-key

load @cluesurf/bind/code/browser/dom/crypto-key-pair
  find crypto-key-pair

form crypto-key-pair, name <CryptoKeyPair>
  link private-key, name <privateKey>
    like crypto-key
    flex true
  link public-key, name <publicKey>
    like crypto-key
    flex true


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find clients
  find event-listener-options
  find event-listener-or-event-listener-object
  find extendable-event
  find extendable-message-event
  find fetch-event
  find message-event
  find notification-event
  find push-event
  find service-worker
  find service-worker-global-scope-event-map
  find service-worker-registration
  find sync-event
  find worker-global-scope

load @cluesurf/bind/code/javascript/es5
  find promise

form service-worker-global-scope, name <ServiceWorkerGlobalScope>
  base worker-global-scope

  link clients, name <clients>
    like clients
  link onactivate, name <onactivate>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onfetch, name <onfetch>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link oninstall, name <oninstall>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onmessage, name <onmessage>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onmessageerror, name <onmessageerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onnotificationclick, name <onnotificationclick>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onnotificationclose, name <onnotificationclose>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onpush, name <onpush>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onsync, name <onsync>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link registration, name <registration>
    like service-worker-registration
  link service-worker, name <serviceWorker>
    like service-worker

  task skip-waiting, name <skipWaiting>
    like promise
      like native-void

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like service-worker-global-scope-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like service-worker-global-scope-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find add-event-listener-options
  find event-listener-options
  find event-listener-or-event-listener-object
  find event-target
  find progress-event
  find xml-http-request
  find xml-http-request-event-target-event-map

load @cluesurf/bind/code/browser/dom/xml-http-request-event-target
  find xml-http-request-event-target

form xml-http-request-event-target, name <XMLHttpRequestEventTarget>
  base event-target

  link onabort, name <onabort>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onerror, name <onerror>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onload, name <onload>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onloadend, name <onloadend>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onloadstart, name <onloadstart>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link onprogress, name <onprogress>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true
  link ontimeout, name <ontimeout>
    like or
      like task
        like any

        take this
        take ev
      like native-null
    flex true

  task add-event-listener, name <addEventListener>
    like native-void

    head k
      base key-list
        like xml-http-request-event-target-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task add-event-listener, name <addEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    head k
      base key-list
        like xml-http-request-event-target-event-map

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

  task remove-event-listener, name <removeEventListener>
    like native-void

    take type
    take listener
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options

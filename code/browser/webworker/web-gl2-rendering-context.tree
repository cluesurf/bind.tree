
load @cluesurf/bind/code/browser/webworker
  find web-gl-rendering-context-base
  find web-gl2-rendering-context-base
  find web-gl2-rendering-context-overloads

load @cluesurf/bind/code/browser/dom/web-gl2-rendering-context
  find web-gl2-rendering-context

form web-gl2-rendering-context, name <WebGL2RenderingContext>
  base web-gl2-rendering-context-base
  base web-gl2-rendering-context-overloads
  base web-gl-rendering-context-base


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find text-encoder-common
  find text-encoder-encode-into-result

load @cluesurf/bind/code/javascript/es5
  find uint8-array

load @cluesurf/bind/code/browser/dom/text-encoder
  find text-encoder

form text-encoder, name <TextEncoder>
  base text-encoder-common

  task encode, name <encode>
    like uint8-array

    take input, like maybe, like native-string

  task encode-into, name <encodeInto>
    like text-encoder-encode-into-result

    take source
    take destination

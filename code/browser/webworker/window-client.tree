
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/webworker
  find client
  find visibility-state

load @cluesurf/bind/code/javascript/es5
  find promise

form window-client, name <WindowClient>
  base client

  link focused, name <focused>
    like native-boolean
  link visibility-state, name <visibilityState>
    like visibility-state

  task focus, name <focus>
    like promise
      like window-client

  task navigate, name <navigate>
    like promise
      like or
        like window-client
        like native-null

    take url

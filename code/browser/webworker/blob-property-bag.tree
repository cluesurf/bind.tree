
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find ending-type

load @cluesurf/bind/code/browser/dom/blob-property-bag
  find blob-property-bag

form blob-property-bag, name <BlobPropertyBag>
  link endings, name <endings>
    like ending-type
    flex true
  link type, name <type>
    like native-string
    flex true

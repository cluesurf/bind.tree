
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find headers

load @cluesurf/bind/code/javascript/es5
  find record

form headers-init, name <HeadersInit>
  like or
    like headers
    like array
      like array
        like native-string
    like record
      like native-string
      like native-string

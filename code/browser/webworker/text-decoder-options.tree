
load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/dom/text-decoder-options
  find text-decoder-options

form text-decoder-options, name <TextDecoderOptions>
  link fatal, name <fatal>
    like native-boolean
    flex true
  link ignore-bom, name <ignoreBOM>
    like native-boolean
    flex true

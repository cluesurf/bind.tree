
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find request-credentials
  find worker-type

load @cluesurf/bind/code/browser/dom/worker-options
  find worker-options

form worker-options, name <WorkerOptions>
  link credentials, name <credentials>
    like request-credentials
    flex true
  link name, name <name>
    like native-string
    flex true
  link type, name <type>
    like worker-type
    flex true

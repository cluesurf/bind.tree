
load @cluesurf/bind/code/browser/webworker
  find algorithm
  find named-curve

load @cluesurf/bind/code/browser/dom/ec-key-import-params
  find ec-key-import-params

form ec-key-import-params, name <EcKeyImportParams>
  base algorithm

  link named-curve, name <namedCurve>
    like named-curve
    flex true


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find blob

load @cluesurf/bind/code/browser/dom/file
  find file

form file, name <File>
  base blob

  link last-modified, name <lastModified>
    like native-number
  link name, name <name>
    like native-string

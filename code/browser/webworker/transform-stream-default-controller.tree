
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-void

load @cluesurf/bind/code/browser/dom/transform-stream-default-controller
  find transform-stream-default-controller

form transform-stream-default-controller, name <TransformStreamDefaultController>
  head o
    fall any

  link desired-size, name <desiredSize>
    like or
      like native-number
      like native-null

  task enqueue, name <enqueue>
    like native-void

    take chunk

  task error, name <error>
    like native-void

    take reason, like maybe, like any

  task terminate, name <terminate>
    like native-void


load @cluesurf/bind/code/javascript/native
  find native-null
  find native-void

load @cluesurf/bind/code/browser/webworker
  find buffer-source
  find float32-list
  find g-lboolean
  find g-lenum
  find g-lint
  find g-lintptr
  find g-lsizei
  find g-lsizeiptr
  find g-luint
  find int32-list
  find tex-image-source
  find web-gl-uniform-location

load @cluesurf/bind/code/javascript/es5
  find array-buffer-view

load @cluesurf/bind/code/browser/dom/iterable/web-gl2-rendering-context-overloads
  find web-gl2-rendering-context-overloads

form web-gl2-rendering-context-overloads, name <WebGL2RenderingContextOverloads>
  task buffer-data, name <bufferData>
    like native-void

    take target
    take size
    take usage

  task buffer-data, name <bufferData>
    like native-void

    take target
    take src-data
    take usage

  task buffer-data, name <bufferData>
    like native-void

    take target
    take src-data
    take usage
    take src-offset
    take length, like maybe, like g-luint

  task buffer-sub-data, name <bufferSubData>
    like native-void

    take target
    take dst-byte-offset
    take src-data

  task buffer-sub-data, name <bufferSubData>
    like native-void

    take target
    take dst-byte-offset
    take src-data
    take src-offset
    take length, like maybe, like g-luint

  task compressed-tex-image2-d, name <compressedTexImage2D>
    like native-void

    take target
    take level
    take internalformat
    take width
    take height
    take border
    take image-size
    take offset

  task compressed-tex-image2-d, name <compressedTexImage2D>
    like native-void

    take target
    take level
    take internalformat
    take width
    take height
    take border
    take src-data
    take src-offset, like maybe, like g-luint
    take src-length-override, like maybe, like g-luint

  task compressed-tex-sub-image2-d, name <compressedTexSubImage2D>
    like native-void

    take target
    take level
    take xoffset
    take yoffset
    take width
    take height
    take format
    take image-size
    take offset

  task compressed-tex-sub-image2-d, name <compressedTexSubImage2D>
    like native-void

    take target
    take level
    take xoffset
    take yoffset
    take width
    take height
    take format
    take src-data
    take src-offset, like maybe, like g-luint
    take src-length-override, like maybe, like g-luint

  task read-pixels, name <readPixels>
    like native-void

    take x
    take y
    take width
    take height
    take format
    take type
    take dst-data

  task read-pixels, name <readPixels>
    like native-void

    take x
    take y
    take width
    take height
    take format
    take type
    take offset

  task read-pixels, name <readPixels>


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-void

load @cluesurf/bind/code/browser/webworker
  find canvas-line-cap
  find canvas-line-join

load @cluesurf/bind/code/browser/dom/iterable/canvas-path-drawing-styles
  find canvas-path-drawing-styles

form canvas-path-drawing-styles, name <CanvasPathDrawingStyles>
  link line-cap, name <lineCap>
    like canvas-line-cap
    flex true
  link line-dash-offset, name <lineDashOffset>
    like native-number
    flex true
  link line-join, name <lineJoin>
    like canvas-line-join
    flex true
  link line-width, name <lineWidth>
    like native-number
    flex true
  link miter-limit, name <miterLimit>
    like native-number
    flex true

  task get-line-dash, name <getLineDash>
    like array
      like native-number

  task set-line-dash, name <setLineDash>
    like native-void

    take segments

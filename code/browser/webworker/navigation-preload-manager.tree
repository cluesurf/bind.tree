
load @cluesurf/bind/code/javascript/native
  find native-string
  find native-void

load @cluesurf/bind/code/browser/webworker
  find navigation-preload-state

load @cluesurf/bind/code/javascript/es5
  find promise

form navigation-preload-manager, name <NavigationPreloadManager>
  task disable, name <disable>
    like promise
      like native-void

  task enable, name <enable>
    like promise
      like native-void

  task get-state, name <getState>
    like promise
      like navigation-preload-state

  task set-header-value, name <setHeaderValue>
    like promise
      like native-void

    take value


load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find body
  find headers
  find response-type

load @cluesurf/bind/code/javascript/es5
  find promise

load @cluesurf/bind/code/browser/dom/response
  find response

form response, name <Response>
  base body

  link headers, name <headers>
    like headers
  link ok, name <ok>
    like native-boolean
  link redirected, name <redirected>
    like native-boolean
  link status, name <status>
    like native-number
  link status-text, name <statusText>
    like native-string
  link trailer, name <trailer>
    like promise
      like headers
  link type, name <type>
    like response-type
  link url, name <url>
    like native-string

  task clone, name <clone>
    like response


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-void

load @cluesurf/bind/code/browser/webworker
  find frame-request-callback

load @cluesurf/bind/code/browser/dom/animation-frame-provider
  find animation-frame-provider

form animation-frame-provider, name <AnimationFrameProvider>
  task cancel-animation-frame, name <cancelAnimationFrame>
    like native-void

    take handle

  task request-animation-frame, name <requestAnimationFrame>
    like native-number

    take callback

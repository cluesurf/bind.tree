
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/dom/rsa-other-primes-info
  find rsa-other-primes-info

form rsa-other-primes-info, name <RsaOtherPrimesInfo>
  link d, name <d>
    like native-string
    flex true
  link r, name <r>
    like native-string
    flex true
  link t, name <t>
    like native-string
    flex true


load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/browser/webworker
  find abort-signal

load @cluesurf/bind/code/browser/dom/stream-pipe-options
  find stream-pipe-options

form stream-pipe-options, name <StreamPipeOptions>
  link prevent-abort, name <preventAbort>
    like native-boolean
    flex true
  link prevent-cancel, name <preventCancel>
    like native-boolean
    flex true
  link prevent-close, name <preventClose>
    like native-boolean
    flex true
  link signal, name <signal>
    like abort-signal
    flex true


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/browser/webworker
  find web-gl-shader

load @cluesurf/bind/code/browser/dom/webgl-debug-shaders
  find webgl-debug-shaders

form webgl-debug-shaders, name <WEBGL_debug_shaders>
  task get-translated-shader-source, name <getTranslatedShaderSource>
    like native-string

    take shader

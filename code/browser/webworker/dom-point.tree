
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/browser/webworker
  find dom-point-read-only

load @cluesurf/bind/code/browser/dom/dom-point
  find dom-point

form dom-point, name <DOMPoint>
  base dom-point-read-only

  link w, name <w>
    like native-number
    flex true
  link x, name <x>
    like native-number
    flex true
  link y, name <y>
    like native-number
    flex true
  link z, name <z>
    like native-number
    flex true

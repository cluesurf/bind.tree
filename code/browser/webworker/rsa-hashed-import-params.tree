
load @cluesurf/bind/code/browser/webworker
  find algorithm
  find hash-algorithm-identifier

load @cluesurf/bind/code/browser/dom/rsa-hashed-import-params
  find rsa-hashed-import-params

form rsa-hashed-import-params, name <RsaHashedImportParams>
  base algorithm

  link hash, name <hash>
    like hash-algorithm-identifier
    flex true

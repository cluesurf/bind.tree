
load @cluesurf/bind/code/browser/webworker
  find close-event
  find event
  find message-event

load @cluesurf/bind/code/browser/dom/web-socket-event-map
  find web-socket-event-map

form web-socket-event-map, name <WebSocketEventMap>
  link close, name <close>
    like close-event
    flex true
  link error, name <error>
    like event
    flex true
  link message, name <message>
    like message-event
    flex true
  link open, name <open>
    like event
    flex true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-null
  find native-string

load @cluesurf/bind/code/browser/dom/idb-object-store-parameters
  find idb-object-store-parameters

form idb-object-store-parameters, name <IDBObjectStoreParameters>
  link auto-increment, name <autoIncrement>
    like native-boolean
    flex true
  link key-path, name <keyPath>
    like or
      like native-string
      like array
        like native-string
      like native-null
    flex true

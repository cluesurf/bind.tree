
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-string

load @cluesurf/bind/code/browser/webworker
  find notification-action
  find notification-direction
  find vibrate-pattern

load @cluesurf/bind/code/browser/dom/notification-options
  find notification-options

form notification-options, name <NotificationOptions>
  link actions, name <actions>
    like array
      like notification-action
    flex true
  link badge, name <badge>
    like native-string
    flex true
  link body, name <body>
    like native-string
    flex true
  link data, name <data>
    like any
    flex true
  link dir, name <dir>
    like notification-direction
    flex true
  link icon, name <icon>
    like native-string
    flex true
  link image, name <image>
    like native-string
    flex true
  link lang, name <lang>
    like native-string
    flex true
  link renotify, name <renotify>
    like native-boolean
    flex true
  link require-interaction, name <requireInteraction>
    like native-boolean
    flex true
  link silent, name <silent>
    like native-boolean
    flex true
  link tag, name <tag>
    like native-string
    flex true
  link timestamp, name <timestamp>
    like native-number
    flex true
  link vibrate, name <vibrate>
    like vibrate-pattern
    flex true

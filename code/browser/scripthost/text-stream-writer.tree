
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string
  find native-void

load @cluesurf/bind/code/browser/scripthost
  find text-stream-base

form text-stream-writer, name <TextStreamWriter>
  base text-stream-base

  task write, name <Write>
    like native-void

    take s

  task write-blank-lines, name <WriteBlankLines>
    like native-void

    take int-lines

  task write-line, name <WriteLine>
    like native-void

    take s

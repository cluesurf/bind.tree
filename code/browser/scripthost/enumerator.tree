
load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-void
  find safe-array

load @cluesurf/bind/code/browser/scripthost/enumerator
  find enumerator

form enumerator, name <Enumerator>
  head t
    fall any

  task at-end, name <atEnd>
    like native-boolean

  task item, name <item>
    like t

  task move-first, name <moveFirst>
    like native-void

  task move-next, name <moveNext>
    like native-void

form enumerator
  hook self
  hook make
    like enumerator
      like t

    head t
      fall any

    take safearray

  hook make
    like enumerator
      like t

    head t
      fall any

    take collection

  hook make
    like enumerator
      like t

    head t
      fall any

    take collection

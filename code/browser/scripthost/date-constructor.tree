
load @cluesurf/bind/code/browser/scripthost/date
  find date

load @cluesurf/bind/code/javascript/es5/date-constructor
  find date-constructor

load @cluesurf/bind/code/javascript/var-date
  find var-date

form date-constructor, name <DateConstructor>
  hook make
    take vd, like var-date
    like date


load @cluesurf/bind/code/javascript/native
  find var-date

load @cluesurf/bind/code/javascript/es5/date
  find date

load @cluesurf/bind/code/browser/scripthost/date
  find date

form date
  hook self
  hook make
    like date

    take vd

form date, name <Date>
  link get-var-date, name <getVarDate>
    like task
      like var-date

    flex true

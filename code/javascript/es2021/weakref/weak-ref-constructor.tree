
load @cluesurf/bind/code/javascript/es2021/weakref/weak-ref
  find weak-ref

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-object

form weak-ref-constructor, name <WeakRefConstructor>
  link prototype, name <prototype>
    like weak-ref
      like native-any

  hook make
    head t
      base native-object
    take target, like t
    like weak-ref
      like t

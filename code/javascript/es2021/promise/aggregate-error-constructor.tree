
load @cluesurf/bind/code/javascript/es2015/iterable/iterable
  find iterable

load @cluesurf/bind/code/javascript/es2021/promise/aggregate-error
  find aggregate-error

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-string

form aggregate-error-constructor, name <AggregateErrorConstructor>
  link prototype, name <prototype>
    like aggregate-error

  hook make
    take errors
      like iterable
        like native-any
    take message, like maybe
      like native-string
    like aggregate-error

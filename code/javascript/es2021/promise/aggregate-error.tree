
load @cluesurf/bind/code/javascript/es5/error
  find error

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-array

form aggregate-error, name <AggregateError>
  base error

  link errors, name <errors>
    like native-array
      like native-any
    lock false


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es2017/intl
  find date-time-format-part-types

form date-time-format-part, name <DateTimeFormatPart>
  link type, name <type>
    like date-time-format-part-types
    flex true
  link value, name <value>
    like native-string
    flex true

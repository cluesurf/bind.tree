
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown
  find date

load @cluesurf/bind/code/javascript/es2017/intl
  find date-time-format-part

load @cluesurf/bind/code/javascript/es5/date-time-format
  find date-time-format

form date-time-format, name <DateTimeFormat>
  task format-to-parts, name <formatToParts>
    like array
      like date-time-format-part

    take date
      like maybe
        like or
          like date
          like native-number


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown/string
  find string

form string, name <String>
  task pad-start, name <padStart>
    like native-string

    take max-length
    take fill-string, like maybe, like native-string

  task pad-end, name <padEnd>
    like native-string

    take max-length
    take fill-string, like maybe, like native-string

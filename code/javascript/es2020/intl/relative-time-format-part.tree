
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es2020/intl
  find relative-time-format-unit

form relative-time-format-part, name <RelativeTimeFormatPart>
  link type, name <type>
    like native-string
    flex true
  link value, name <value>
    like native-string
    flex true
  link unit, name <unit>
    like relative-time-format-unit
    flex true

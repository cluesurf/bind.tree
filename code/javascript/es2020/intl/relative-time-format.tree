
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es2020/intl
  find relative-time-format-part
  find relative-time-format-unit
  find resolved-relative-time-format-options

form relative-time-format, name <RelativeTimeFormat>
  task format, name <format>
    like native-string

    take value
    take unit

  task format-to-parts, name <formatToParts>
    like array
      like relative-time-format-part

    take value
    take unit

  task resolved-options, name <resolvedOptions>
    like resolved-relative-time-format-options


load @cluesurf/bind/code/javascript/es2015/iterable
  find iterable-iterator

load @cluesurf/bind/code/javascript/es2018/regexp
  find reg-exp
  find reg-exp-match-array

load @cluesurf/bind/code/javascript/es2019/string/string
  find string

form string, name <String>
  task match-all, name <matchAll>
    like iterable-iterator
      like reg-exp-match-array

    take regexp


bear @cluesurf/bind/code/javascript/es2020/intl/unicode-bcp47-locale-identifier
bear @cluesurf/bind/code/javascript/es2020/intl/relative-time-format-unit
bear @cluesurf/bind/code/javascript/es2020/intl/relative-time-format-locale-matcher
bear @cluesurf/bind/code/javascript/es2020/intl/relative-time-format-numeric
bear @cluesurf/bind/code/javascript/es2020/intl/relative-time-format-style
bear @cluesurf/bind/code/javascript/es2020/intl/relative-time-format-options
bear @cluesurf/bind/code/javascript/es2020/intl/resolved-relative-time-format-options
bear @cluesurf/bind/code/javascript/es2020/intl/relative-time-format-part
bear @cluesurf/bind/code/javascript/es2020/intl/relative-time-format
bear @cluesurf/bind/code/javascript/es2020/intl/number-format-options
bear @cluesurf/bind/code/javascript/es2020/intl/resolved-number-format-options
bear @cluesurf/bind/code/javascript/es2020/intl/date-time-format-options

load @cluesurf/bind/code/javascript/es2020/intl/relative-time-format
  find relative-time-format

load @cluesurf/bind/code/javascript/es2020/intl/relative-time-format-options
  find relative-time-format-options

load @cluesurf/bind/code/javascript/es2020/intl/unicode-bcp47-locale-identifier
  find unicode-bcp47-locale-identifier

load @cluesurf/bind/code/javascript/native
  find native-array

host relative-time-format, name <RelativeTimeFormat>
  like form
    hook make
      take locales, like maybe
        like or
          like unicode-bcp47-locale-identifier
          like native-array
            like unicode-bcp47-locale-identifier
      take options, like maybe
        like relative-time-format-options
      like relative-time-format

    task supported-locales-of, name <supportedLocalesOf>
      take locales, like maybe
        like or
          like unicode-bcp47-locale-identifier
          like native-array
            like unicode-bcp47-locale-identifier
      take options, like maybe
        like relative-time-format-options
      like native-array
        like unicode-bcp47-locale-identifier

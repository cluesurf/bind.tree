
load @cluesurf/bind/code/javascript/native
  find native-bigint
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es5
  find resolved-number-format-options

load @cluesurf/bind/code/javascript/es5/number-format
  find number-format

form number-format, name <NumberFormat>
  task format, name <format>
    like native-string

    take value

  task resolved-options, name <resolvedOptions>
    like resolved-number-format-options


load @cluesurf/bind/code/javascript/es2015/iterable/iterable-iterator
  find iterable-iterator

load @cluesurf/bind/code/javascript/es5/float32-array
  find float32-array

load @cluesurf/bind/code/javascript/native
  find native-number

form float32-array, name <Float32Array>
  task {symbol/iterator}
    like iterable-iterator
      like native-number

  task entries, name <entries>
    like iterable-iterator
      like band
        like native-number
        like native-number

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like native-number

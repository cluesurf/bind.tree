
load @cluesurf/bind/code/javascript/es5/promise
  find promise

load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/es2015/iterable
  find iterable

load @cluesurf/bind/code/javascript/es5
  find promise-like

load @cluesurf/bind/code/javascript/native
  find u

load @cluesurf/bind/code/javascript/es2015/iterable/promise
  find promise

form promise, name <Promise>
  head t

form promise
  hook self
    task all, name <all>
      like promise
        like array
          like t

      head t

      take values

    task race, name <race>
      like promise
        like test
          fork roll
            like t
            like promise-like
              name u
            hook true
              like u
            hook false
              like t

      head t

      take values

    task race, name <race>
      like promise
        like t

      head t

      take values


load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/es2015/iterable
  find iterable-iterator

load @cluesurf/bind/code/javascript/es2015/core/readonly-array
  find readonly-array

form readonly-array, name <ReadonlyArray>
  head t

  task {symbol/iterator}
    like iterable-iterator
      like t

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like native-number
        like t

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like t

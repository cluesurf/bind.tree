
load @cluesurf/bind/code/javascript/es2015/iterable/iterable
  find iterable

load @cluesurf/bind/code/javascript/es2015/iterable/uint8-clamped-array
  find uint8-clamped-array

load @cluesurf/bind/code/javascript/es5/uint8-clamped-array-constructor
  find uint8-clamped-array-constructor

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-number

form uint8-clamped-array-constructor, name <Uint8ClampedArrayConstructor>
  task from, name <from>
    take array-like
      like iterable
        like native-number
    take mapfn, like maybe
      like task
        take v, like native-number
        take k, like native-number
        like native-number
    take this-arg, like maybe
      like native-any
    like uint8-clamped-array

  hook make
    take elements
      like iterable
        like native-number
    like uint8-clamped-array


load @cluesurf/bind/code/javascript/native
  find native-object

load @cluesurf/bind/code/javascript/es2015/collection/weak-map
  find weak-map

load @cluesurf/bind/code/javascript/es2015/iterable
  find iterable

load @cluesurf/bind/code/javascript/es2015/iterable/weak-map
  find weak-map

form weak-map, name <WeakMap>
  head k
    base native-object
  head v

form weak-map
  hook self
  hook make
    like weak-map
      like k
      like v

    head k
      base native-object
    head v

    take iterable

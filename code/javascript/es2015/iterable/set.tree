
load @cluesurf/bind/code/javascript/es2015/iterable
  find iterable
  find iterable-iterator

load @cluesurf/bind/code/javascript/es2015/collection/set
  find set

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/es2015/iterable/set
  find set

form set, name <Set>
  head t

  task {symbol/iterator}
    like iterable-iterator
      like t

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like t
        like t

  task keys, name <keys>
    like iterable-iterator
      like t

  task values, name <values>
    like iterable-iterator
      like t

form set
  hook self
  hook make
    like set
      like t

    head t

    take iterable
      like maybe
        like or
          like iterable
            like t
          like native-null

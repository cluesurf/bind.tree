
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/es2015/iterable
  find iterable
  find iterable-iterator

load @cluesurf/bind/code/javascript/es2015/core/array
  find array

load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/es5
  find array-like

form array, name <Array>
  head t

  task {symbol/iterator}
    like iterable-iterator
      like t

  task entries, name <entries>
    like iterable-iterator
      like tuple
        like native-number
        like t

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like t

form array
  hook self
    task from, name <from>
      like array
        like t

      head t

      take iterable

    task from, name <from>
      like array
        like u

      head t
      head u

      take iterable
      take mapfn
      take this-arg, like maybe, like any

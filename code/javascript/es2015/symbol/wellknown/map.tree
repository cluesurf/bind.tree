
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es2015/iterable/map
  find map

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown
  find map-constructor

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown/map
  find map

form map, name <Map>
  head k
  head v

  link {symbol/to-string-tag}
    like native-string
    work true

form map
  hook self
    link {symbol/species}
      like map-constructor
      work true

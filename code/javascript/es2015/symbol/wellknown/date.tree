
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

form date, name <Date>
  task {symbol/to-primitive}
    like native-string

    take hint

  task {symbol/to-primitive}
    like native-string

    take hint

  task {symbol/to-primitive}
    like native-number

    take hint

  task {symbol/to-primitive}
    like or
      like native-string
      like native-number

    take hint

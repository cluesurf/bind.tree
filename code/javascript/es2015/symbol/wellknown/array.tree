
load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/es2015/iterable/array
  find array

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown
  find array-constructor

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown/array
  find array

form array, name <Array>
  head t

  task {symbol/unscopables}
    like form
      link copy-within, name <copyWithin>
        like native-boolean
        flex true
      link entries, name <entries>
        like native-boolean
        flex true
      link fill, name <fill>
        like native-boolean
        flex true
      link find, name <find>
        like native-boolean
        flex true
      link find-index, name <findIndex>
        like native-boolean
        flex true
      link keys, name <keys>
        like native-boolean
        flex true
      link values, name <values>
        like native-boolean
        flex true

form array
  hook self
    link {symbol/species}
      like array-constructor
      work true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es5
  find reg-exp-match-array

load @cluesurf/bind/code/javascript/es2015/iterable/string
  find string

form string, name <String>
  task match, name <match>
    like or
      like reg-exp-match-array
      like native-null

    take matcher

  task replace, name <replace>
    like native-string

    take search-value
    take replace-value

  task replace, name <replace>
    like native-string

    take search-value
    take replacer

  task search, name <search>
    like native-number

    take searcher

  task split, name <split>
    like array
      like native-string

    take splitter
    take limit, like maybe, like native-number

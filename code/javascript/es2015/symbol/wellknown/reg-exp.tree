
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-null
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es5
  find reg-exp-match-array

load @cluesurf/bind/code/javascript/es2015/core/reg-exp
  find reg-exp

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown
  find reg-exp-constructor

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown/reg-exp
  find reg-exp

form reg-exp, name <RegExp>
  task {symbol/match}
    like or
      like reg-exp-match-array
      like native-null

    take string

  task {symbol/replace}
    like native-string

    take string
    take replace-value

  task {symbol/replace}
    like native-string

    take string
    take replacer

  task {symbol/search}
    like native-number

    take string

  task {symbol/split}
    like array
      like native-string

    take string
    take limit, like maybe, like native-number

form reg-exp
  hook self
    link {symbol/species}
      like reg-exp-constructor
      work true


load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es2015/iterable/set
  find set

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown
  find set-constructor

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown/set
  find set

form set, name <Set>
  head t

  link {symbol/to-string-tag}
    like native-string
    work true

form set
  hook self
    link {symbol/species}
      like set-constructor
      work true

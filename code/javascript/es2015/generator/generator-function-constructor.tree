
load @cluesurf/bind/code/javascript/es2015/generator/generator-function
  find generator-function

load @cluesurf/bind/code/javascript/native
  find native-array

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form generator-function-constructor, name <GeneratorFunctionConstructor>
  link length, name <length>
    like native-number
  link name, name <name>
    like native-string
  link prototype, name <prototype>
    like generator-function

  hook make
    take args
      like native-array
        like native-string
      rest true
    like generator-function

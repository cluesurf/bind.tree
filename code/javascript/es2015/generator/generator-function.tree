
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es2015/generator
  find generator

load @cluesurf/bind/code/javascript/es2015/generator/generator-function
  find generator-function

form generator-function, name <GeneratorFunction>
  link length, name <length>
    like native-number
  link name, name <name>
    like native-string
  link prototype, name <prototype>
    like generator

  hook make
    like generator

    take args
      like array
        like any
      rest true

form generator-function
  hook self
    link length, name <length>
      like native-number
    link name, name <name>
      like native-string
    link prototype, name <prototype>
      like generator-function

  hook make
    like generator-function

    take args
      like array
        like native-string
      rest true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-boolean
  find native-number
  find native-undefined
  find native-void

load @cluesurf/bind/code/javascript/es5/readonly-array
  find readonly-array

form readonly-array, name <ReadonlyArray>
  head t

  task find, name <find>
    like or
      like s
      like native-undefined

    head s
      base t

    take predicate
    take this-arg, like maybe, like any

  task find, name <find>
    like or
      like t
      like native-undefined

    take predicate
    take this-arg, like maybe, like any

  task find-index, name <findIndex>
    like native-number

    take predicate
    take this-arg, like maybe, like any

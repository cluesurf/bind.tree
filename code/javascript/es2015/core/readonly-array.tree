
load @cluesurf/bind/code/javascript/es5/readonly-array
  find readonly-array

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-array

load @cluesurf/bind/code/javascript/native
  find native-boolean

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-undefined

load @cluesurf/bind/code/javascript/native
  find native-unknown

load @cluesurf/bind/code/javascript/native
  find native-void

form readonly-array, name <ReadonlyArray>
  head t

  task find, name <find>
    head s
      base t
    take predicate
      like task
        take this, like native-void
        take value, like t
        take index, like native-number
        take obj
          like native-array
            like t
        like native-boolean
        rank value, like s
    take this-arg, like maybe
      like native-any
    like or
      like s
      like native-undefined

  task find, name <find>
    take predicate
      like task
        take value, like t
        take index, like native-number
        take obj
          like native-array
            like t
        like native-unknown
    take this-arg, like maybe
      like native-any
    like or
      like t
      like native-undefined

  task find-index, name <findIndex>
    take predicate
      like task
        take value, like t
        take index, like native-number
        take obj
          like native-array
            like t
        like native-unknown
    take this-arg, like maybe
      like native-any
    like native-number

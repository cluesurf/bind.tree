
load @cluesurf/bind/code/browser/scripthost/date
  find date

load @cluesurf/bind/code/browser/scripthost/date-constructor
  find date-constructor

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form date-constructor, name <DateConstructor>
  hook make
    take value
      like or
        like native-number
        like native-string
        like date
    like date

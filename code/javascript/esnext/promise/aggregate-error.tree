
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/es5
  find error

load @cluesurf/bind/code/javascript/es2021/promise/aggregate-error
  find aggregate-error

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es2015/iterable
  find iterable

load @cluesurf/bind/code/javascript/esnext/promise/aggregate-error
  find aggregate-error

form aggregate-error, name <AggregateError>
  base error

  link errors, name <errors>
    like array
      like any
    flex true

form aggregate-error
  hook self
    link prototype, name <prototype>
      like aggregate-error

  hook make
    like aggregate-error

    take errors
    take message, like maybe, like native-string

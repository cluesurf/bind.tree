
load @cluesurf/bind/code/javascript/es2015/iterable/iterable
  find iterable

load @cluesurf/bind/code/javascript/es2018/promise/promise
  find promise

load @cluesurf/bind/code/javascript/es2021/promise/promise-constructor
  find promise-constructor

load @cluesurf/bind/code/javascript/es5/promise-like
  find promise-like

load @cluesurf/bind/code/javascript/native
  find native-array

form promise-constructor, name <PromiseConstructor>
  task any, name <any>
    head t
    take values
      like or
        like native-array
          like or
            like t
            like promise-like
              like t
        like iterable
          like or
            like t
            like promise-like
              like t
    like promise
      like t

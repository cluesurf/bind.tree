
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es2020/symbol/wellknown
  find reg-exp

load @cluesurf/bind/code/javascript/es2021/string/string
  find string

form string, name <String>
  task replace-all, name <replaceAll>
    like native-string

    take search-value
    take replace-value

  task replace-all, name <replaceAll>
    like native-string

    take search-value
    take replacer

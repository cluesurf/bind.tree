
load @cluesurf/bind/code/javascript/es2020/bigint/number-format
  find number-format

load @cluesurf/bind/code/javascript/esnext/intl/number-format-part
  find number-format-part

load @cluesurf/bind/code/javascript/native
  find native-array

load @cluesurf/bind/code/javascript/native
  find native-bigint

load @cluesurf/bind/code/javascript/native
  find native-number

form number-format, name <NumberFormat>
  task format-to-parts, name <formatToParts>
    take number, like maybe
      like or
        like native-number
        like native-bigint
    like native-array
      like number-format-part

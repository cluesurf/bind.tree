
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/esnext/intl
  find number-format-part-types

form number-format-part, name <NumberFormatPart>
  link type, name <type>
    like number-format-part-types
    flex true
  link value, name <value>
    like native-string
    flex true


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es2018/asyncgenerator
  find async-generator

load @cluesurf/bind/code/javascript/es2018/asyncgenerator/async-generator-function
  find async-generator-function

form async-generator-function, name <AsyncGeneratorFunction>
  link length, name <length>
    like native-number
  link name, name <name>
    like native-string
  link prototype, name <prototype>
    like async-generator

  hook make
    like async-generator

    take args
      like array
        like any
      rest true

form async-generator-function
  hook self
    link length, name <length>
      like native-number
    link name, name <name>
      like native-string
    link prototype, name <prototype>
      like async-generator-function

  hook make
    like async-generator-function

    take args
      like array
        like native-string
      rest true

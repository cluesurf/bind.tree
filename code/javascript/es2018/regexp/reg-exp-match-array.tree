
load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es5/reg-exp-match-array
  find reg-exp-match-array

form reg-exp-match-array, name <RegExpMatchArray>
  link groups, name <groups>
    like form
      mesh key
        like native-string
    flex true

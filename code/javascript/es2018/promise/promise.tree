
load @cluesurf/bind/code/javascript/native
  find native-null
  find native-undefined
  find native-void

load @cluesurf/bind/code/javascript/es2015/symbol/wellknown/promise
  find promise

form promise, name <Promise>
  head t

  task finally, name <finally>
    like promise
      like t

    take onfinally
      like maybe
        like or
          like task
            like native-void

          like native-undefined
          like native-null

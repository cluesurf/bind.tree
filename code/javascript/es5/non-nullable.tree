
load @cluesurf/bind/code/javascript/native
  find native-never

load @cluesurf/bind/code/javascript/native
  find native-null

load @cluesurf/bind/code/javascript/native
  find native-undefined

form non-nullable, name <NonNullable>
  head t

  like test
    stem roll
      like t
      like or
        like native-null
        like native-undefined
      hook true
        like native-never
      hook false
        like t

bear @cluesurf/bind/code/javascript/es5/intl/collator-options
bear @cluesurf/bind/code/javascript/es5/intl/resolved-collator-options
bear @cluesurf/bind/code/javascript/es5/intl/collator
bear @cluesurf/bind/code/javascript/es5/intl/number-format-options
bear @cluesurf/bind/code/javascript/es5/intl/resolved-number-format-options
bear @cluesurf/bind/code/javascript/es5/intl/number-format
bear @cluesurf/bind/code/javascript/es5/intl/date-time-format-options
bear @cluesurf/bind/code/javascript/es5/intl/resolved-date-time-format-options
bear @cluesurf/bind/code/javascript/es5/intl/date-time-format

load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/es5
  find collator
  find collator-options
  find date-time-format
  find date-time-format-options
  find number-format
  find number-format-options

host collator, name <Collator>
  like form
    hook make
      like collator

      take locales
        like maybe
          like or
            like native-string
            like array
              like native-string
      take options, like maybe, like collator-options

    task supported-locales-of, name <supportedLocalesOf>
      like array
        like native-string

      take locales
      take options, like maybe, like collator-options

host number-format, name <NumberFormat>
  like form
    hook make
      like number-format

      take locales
        like maybe
          like or
            like native-string
            like array
              like native-string
      take options, like maybe, like number-format-options

    task supported-locales-of, name <supportedLocalesOf>
      like array
        like native-string

      take locales
      take options, like maybe, like number-format-options

host date-time-format, name <DateTimeFormat>
  like form
    hook make
      like date-time-format

      take locales
        like maybe
          like or
            like native-string
            like array
              like native-string
      take options, like maybe, like date-time-format-options

    task supported-locales-of, name <supportedLocalesOf>
      like array
        like native-string

      take locales
      take options, like maybe, like date-time-format-options


load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

form concat-array, name <ConcatArray>
  head t

  link length, name <length>
    like native-number

  task join, name <join>
    like native-string

    take separator, like maybe, like native-string

  task slice, name <slice>
    like array
      like t

    take start, like maybe, like native-number
    take end, like maybe, like native-number

  mesh n
    like t

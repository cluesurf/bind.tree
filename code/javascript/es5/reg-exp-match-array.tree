
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es5
  find array

form reg-exp-match-array, name <RegExpMatchArray>
  base array

  link index, name <index>
    like native-number
    flex true
  link input, name <input>
    like native-string
    flex true

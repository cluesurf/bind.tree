
load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/es5
  find function

form i-arguments, name <IArguments>
  link length, name <length>
    like native-number
    flex true
  link callee, name <callee>
    like function
    flex true

  mesh index
    like any

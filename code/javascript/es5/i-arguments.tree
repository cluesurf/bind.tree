
load @cluesurf/bind/code/javascript/es5/function
  find function

load @cluesurf/bind/code/javascript/native
  find native-any

load @cluesurf/bind/code/javascript/native
  find native-number

form i-arguments, name <IArguments>
  link length, name <length>
    like native-number
    lock false
  link callee, name <callee>
    like function
    lock false

  mesh index, like native-number
    like native-any

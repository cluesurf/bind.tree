
load @cluesurf/bind/code/javascript/native
  find native-string
  find native-symbol
  find native-void
  find t

load @cluesurf/bind/code/javascript/es5
  find object
  find typed-property-descriptor

form method-decorator, name <MethodDecorator>
  like task
    like or
      like typed-property-descriptor
        like t
      like native-void

    head t

    take target
    take property-key
    take descriptor


load @cluesurf/bind/code/javascript/es5/resolved-number-format-options
  find resolved-number-format-options

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

form number-format, name <NumberFormat>
  task format, name <format>
    take value, like native-number
    like native-string

  task resolved-options, name <resolvedOptions>
    like resolved-number-format-options


load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es5
  find resolved-collator-options

form collator, name <Collator>
  task compare, name <compare>
    like native-number

    take x
    take y

  task resolved-options, name <resolvedOptions>
    like resolved-collator-options

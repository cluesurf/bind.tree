
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string

load @cluesurf/bind/code/javascript/es5
  find date
  find resolved-date-time-format-options

form date-time-format, name <DateTimeFormat>
  task format, name <format>
    like native-string

    take date
      like maybe
        like or
          like date
          like native-number

  task resolved-options, name <resolvedOptions>
    like resolved-date-time-format-options

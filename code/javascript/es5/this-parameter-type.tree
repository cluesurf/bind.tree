
load @cluesurf/bind/code/javascript
  find array

load @cluesurf/bind/code/javascript/native
  find u

form this-parameter-type, name <ThisParameterType>
  head t

  like test
    fork roll
      like t
      like task
        like any

        take this
        take args
          like array
            like any
          rest true
      hook true
        like u
      hook false
        like unknown


load @cluesurf/bind/code/javascript/es5/object
  find object

load @cluesurf/bind/code/javascript/native
  find native-number

load @cluesurf/bind/code/javascript/native
  find native-string

load @cluesurf/bind/code/javascript/native
  find native-symbol

load @cluesurf/bind/code/javascript/native
  find native-void

form parameter-decorator, name <ParameterDecorator>
  like task
    take target, like object
    take property-key
      like or
        like native-string
        like native-symbol
    take parameter-index, like native-number
    like native-void
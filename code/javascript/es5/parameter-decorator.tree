
load @cluesurf/bind/code/javascript/native
  find native-number
  find native-string
  find native-symbol
  find native-void

load @cluesurf/bind/code/javascript/es5
  find object

form parameter-decorator, name <ParameterDecorator>
  like task
    like native-void

    take target
    take property-key
    take parameter-index


load @cluesurf/moon
  find or
  find task

load @cluesurf/bind/code/javascript
  find error
  find native-null
  find native-void

load @cluesurf/bind/code/node/buffer
  find buffer

form compress-callback, name <CompressCallback>
  like task
    like native-void

    take error
      like or
        like error
        like native-null
    take result, like buffer

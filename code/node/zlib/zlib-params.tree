
load @cluesurf/moon
  find task

load @cluesurf/bind/code/javascript
  find native-number
  find native-void

form zlib-params, name <ZlibParams>
  task params, name <params>
    like native-void

    take level, like native-number
    take strategy, like native-number
    take callback
      like task
        like native-void

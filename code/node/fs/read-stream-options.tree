
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-number
  find native-undefined

load @cluesurf/bind/code/node/fs
  find stream-options

form read-stream-options, name <ReadStreamOptions>
  base stream-options

  link end, name <end>
    like or
      like native-number
      like native-undefined
    flex true

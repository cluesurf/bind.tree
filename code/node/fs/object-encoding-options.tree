
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-null
  find native-undefined

load @cluesurf/bind/code/node/buffer
  find buffer-encoding

form object-encoding-options, name <ObjectEncodingOptions>
  link encoding, name <encoding>
    like or
      like buffer-encoding
      like native-null
      like native-undefined
    flex true


load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-null
  find native-undefined

load @cluesurf/bind/code/node/buffer
  find buffer-encoding

load @cluesurf/bind/code/node/fs
  find object-encoding-options

form encoding-option, name <EncodingOption>
  like or
    like object-encoding-options
    like buffer-encoding
    like native-undefined
    like native-null

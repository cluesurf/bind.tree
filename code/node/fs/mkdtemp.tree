
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-string
  find promise

load @cluesurf/bind/code/node/buffer
  find buffer

load @cluesurf/bind/code/node/fs
  find buffer-encoding-option
  find encoding-option

task promisify, name <__promisify__>
  like promise
    like native-string

  take prefix, like native-string
  take options, like encoding-option
    void true

task promisify, name <__promisify__>
  like promise
    like buffer

  take prefix, like native-string
  take options, like buffer-encoding-option

task promisify, name <__promisify__>
  like promise
    like or
      like native-string
      like buffer

  take prefix, like native-string
  take options, like encoding-option
    void true

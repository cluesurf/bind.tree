
load @cluesurf/bind/code/javascript
  find native-void
  find promise

load @cluesurf/bind/code/node/fs
  find path-like
  find time-like

task promisify, name <__promisify__>
  like promise
    like native-void

  take path, like path-like
  take atime, like time-like
  take mtime, like time-like

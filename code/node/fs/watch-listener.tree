
load @cluesurf/moon
  find like
  find task

load @cluesurf/bind/code/javascript
  find native-void

load @cluesurf/bind/code/node/fs
  find watch-event-type

form watch-listener, name <WatchListener>
  head t

  like task
    like native-void

    take event, like watch-event-type
    take filename, like t

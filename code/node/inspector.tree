
bear @cluesurf/bind/code/javascript/node/inspector/inspector-notification
bear @cluesurf/bind/code/javascript/node/inspector/schema
bear @cluesurf/bind/code/javascript/node/inspector/runtime
bear @cluesurf/bind/code/javascript/node/inspector/debugger
bear @cluesurf/bind/code/javascript/node/inspector/console
bear @cluesurf/bind/code/javascript/node/inspector/profiler
bear @cluesurf/bind/code/javascript/node/inspector/heap-profiler
bear @cluesurf/bind/code/javascript/node/inspector/session

load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-boolean
  find native-number
  find native-string
  find native-undefined
  find native-void

task open, name <open>
  like native-void

  take port, like native-number
    void true
  take host, like native-string
    void true
  take wait, like native-boolean
    void true

task close, name <close>
  like native-void

task url, name <url>
  like or
    like native-string
    like native-undefined

task wait-for-debugger, name <waitForDebugger>
  like native-void


load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-null

load @cluesurf/bind/code/node/buffer
  find buffer-encoding

load @cluesurf/bind/code/node/child-process
  find exec-options

form exec-options-with-buffer-encoding, name <ExecOptionsWithBufferEncoding>
  base exec-options

  link encoding, name <encoding>
    like or
      like buffer-encoding
      like native-null
    flex true

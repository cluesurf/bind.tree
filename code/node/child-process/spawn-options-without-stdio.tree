
load @cluesurf/bind/code/javascript
  find array
  find native-undefined

load @cluesurf/moon
  find or

load @cluesurf/bind/code/node/child-process
  find spawn-options
  find stdio-pipe
  find stdio-pipe-named

form spawn-options-without-stdio, name <SpawnOptionsWithoutStdio>
  base spawn-options

  link stdio, name <stdio>
    like or
      like stdio-pipe-named
      like array
        like stdio-pipe
      like native-undefined
    flex true

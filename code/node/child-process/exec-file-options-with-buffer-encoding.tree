
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-null

load @cluesurf/bind/code/node/child-process
  find exec-file-options

form exec-file-options-with-buffer-encoding, name <ExecFileOptionsWithBufferEncoding>
  base exec-file-options

  link encoding, name <encoding>
    like or
      text <buffer>
      like native-null
    flex true

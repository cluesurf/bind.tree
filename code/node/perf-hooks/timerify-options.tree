
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-undefined

load @cluesurf/bind/code/node/perf-hooks
  find recordable-histogram

form timerify-options, name <TimerifyOptions>
  link histogram, name <histogram>
    like or
      like recordable-histogram
      like native-undefined
    flex true


load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-number
  find native-undefined

load @cluesurf/bind/code/node/net
  find ipc-socket-connect-opts
  find socket-constructor-opts

form ipc-net-connect-opts, name <IpcNetConnectOpts>
  base ipc-socket-connect-opts
  base socket-constructor-opts

  link timeout, name <timeout>
    like or
      like native-number
      like native-undefined
    flex true

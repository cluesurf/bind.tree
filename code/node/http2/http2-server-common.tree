
load @cluesurf/moon
  find task

load @cluesurf/bind/code/javascript
  find native-number
  find native-this
  find native-void

load @cluesurf/bind/code/node/http2
  find settings

form http2-server-common, name <HTTP2ServerCommon>
  task set-timeout, name <setTimeout>
    like native-this

    take msec, like native-number
      void true
    take callback
      like task
        like native-void

      void true

  task update-settings, name <updateSettings>
    like native-void

    take settings, like settings


load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-boolean
  find native-undefined

form server-stream-response-options, name <ServerStreamResponseOptions>
  link end-stream, name <endStream>
    like or
      like native-boolean
      like native-undefined
    flex true
  link wait-for-trailers, name <waitForTrailers>
    like or
      like native-boolean
      like native-undefined
    flex true


load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-null
  find native-string

load @cluesurf/bind/code/node/url
  find url

form url-with-string-query, name <UrlWithStringQuery>
  base url

  link query, name <query>
    like or
      like native-string
      like native-null
    flex true

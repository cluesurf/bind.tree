
load @cluesurf/moon
  find tuple

load @cluesurf/bind/code/javascript
  find native-number
  find native-string
  find native-symbol
  find node-js-dict

load @cluesurf/bind/code/node/util
  find inspect-options
  find style

host colors, name <colors>
  like node-js-dict
    like tuple
      like native-number
      like native-number

host styles, name <styles>
  slot self
  walk link-name-like-list
    loan like style
    take name
    take k
    beam self
      take {name}
        like native-string

host default-options, name <defaultOptions>
  like inspect-options

host repl-defaults, name <replDefaults>
  like inspect-options

host custom, name <custom>
  like native-symbol
    cool true

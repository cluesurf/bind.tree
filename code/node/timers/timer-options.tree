
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-boolean
  find native-undefined

load @cluesurf/bind/code/node/events/event-emitter
  find abortable

form timer-options, name <TimerOptions>
  base abortable

  link ref, name <ref>
    like or
      like native-boolean
      like native-undefined
    flex true


load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-undefined

load @cluesurf/bind/code/node/inspector/runtime
  find exception-details
  find remote-object

form evaluate-return-type, name <EvaluateReturnType>
  link result, name <result>
    like remote-object
    flex true
  link exception-details, name <exceptionDetails>
    like or
      like exception-details
      like native-undefined
    flex true

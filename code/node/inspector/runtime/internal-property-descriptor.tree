
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-string
  find native-undefined

load @cluesurf/bind/code/node/inspector/runtime
  find remote-object

form internal-property-descriptor, name <InternalPropertyDescriptor>
  link name, name <name>
    like native-string
    flex true
  link value, name <value>
    like or
      like remote-object
      like native-undefined
    flex true

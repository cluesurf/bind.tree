
load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-string
  find native-undefined

load @cluesurf/bind/code/node/inspector/debugger
  find location

form continue-to-location-parameter-type, name <ContinueToLocationParameterType>
  link location, name <location>
    like location
    flex true
  link target-call-frames, name <targetCallFrames>
    like or
      like native-string
      like native-undefined
    flex true


bear @cluesurf/bind/code/javascript/node/trace-events/tracing
bear @cluesurf/bind/code/javascript/node/trace-events/create-tracing-options

load @cluesurf/moon
  find or

load @cluesurf/bind/code/javascript
  find native-string
  find native-undefined

load @cluesurf/bind/code/node/trace-events
  find create-tracing-options
  find tracing

task create-tracing, name <createTracing>
  like tracing

  take options, like create-tracing-options

task get-enabled-categories, name <getEnabledCategories>
  like or
    like native-string
    like native-undefined
